---
/**
 * CorporateSubnav — kurumsal alt sayfalar arası gezinti
 * Yatırımcı subnav gibi sticky, sayfa içinde değil sayfalar arası link
 */
import { getCollection } from 'astro:content';
import { getLocale, localizedUrl, type Locale } from '../../lib/i18n';

interface Props {
  currentSlug?: string;
}
const { currentSlug } = Astro.props;
const locale: Locale = getLocale(Astro.url.pathname);

const all = await getCollection('corporate', (c) => c.data.lang === locale);
const items = all.sort((a, b) => a.data.order - b.data.order);

const base = locale === 'tr' ? '/kurumsal' : '/en/corporate';
const indexLbl = locale === 'tr' ? 'Bölümler' : 'Sections';
---

<nav class="subnav" aria-label={locale === 'tr' ? 'Kurumsal alt sayfalar' : 'Corporate sub-pages'}>
  <div class="container">
    <div class="subnav-inner">
      <span class="subnav-label">{indexLbl}</span>
      {items.map((it) => (
        <a
          href={localizedUrl(locale, `${locale === 'tr' ? '/kurumsal' : '/corporate'}/${it.data.slug}`)}
          class:list={[{ 'is-active': it.data.slug === currentSlug }]}
        >
          {it.data.title}
        </a>
      ))}
    </div>
  </div>
</nav>

<style>
.subnav {
  position: sticky;
  top: var(--header-h);
  z-index: 60;
  background: rgba(247, 244, 238, 0.9);
  backdrop-filter: saturate(180%) blur(16px);
  -webkit-backdrop-filter: saturate(180%) blur(16px);
  border-bottom: 1px solid var(--line);
  border-top: 1px solid var(--line);
}
.subnav-inner {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  height: var(--subnav-h);
  overflow-x: auto;
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.subnav-inner::-webkit-scrollbar { display: none; }
.subnav-label {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--terracotta);
  font-weight: 600;
  white-space: nowrap;
  padding-right: 0.5rem;
  border-right: 1px solid var(--line);
}
.subnav a {
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--muted);
  white-space: nowrap;
  padding: 0.5rem 0;
  position: relative;
  transition: color var(--t-fast) var(--ease);
}
.subnav a::after {
  content: '';
  position: absolute;
  inset: auto 0 0 0;
  height: 1.5px;
  background: var(--terracotta);
  width: 0;
  transition: width var(--t-med) var(--ease-out);
}
.subnav a.is-active,
.subnav a:hover { color: var(--ink); }
.subnav a.is-active::after { width: 100%; }

@media (max-width: 980px) {
  .subnav { top: var(--main-nav-h); }
}
</style>
