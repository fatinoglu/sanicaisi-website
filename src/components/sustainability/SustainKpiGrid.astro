---
/**
 * SustainKpiGrid — 2024 TSRS Sürdürülebilirlik Raporu CTA bölümü.
 *
 * Önceki sürümde uydurma KPI tablosu (8 satır karşılaştırma) vardı; veriler
 * yayımlanmış raporla doğrulanmadığı için kaldırıldı. Yerine raporun
 * yapı taşlarını anlatan + PDF/KAP linkleri içeren bir CTA bölümü konuldu.
 */
import { getCollection } from 'astro:content';
import { getLocale, formatDate } from '../../lib/i18n';
const locale = getLocale(Astro.url.pathname);

const allDocs = await getCollection('investor-documents', (d) =>
  d.data.lang === locale && d.data.type === 'surdurulebilirlik'
);
const latestTsrs = allDocs
  .map((r) => r.data)
  .filter((r) => /tsrs/i.test(r.title) || /tsrs/i.test(r.slug ?? ''))
  .sort((a, b) => +b.date - +a.date)[0];

const t = locale === 'tr' ? {
  marker: 'Performans · Performance',
  h2a: 'Sayılar',
  h2em: 'raporda',
  h2b: '.',
  intro: 'Sera gazı envanteri, enerji ve su yoğunluğu, atık, çalışan ve tedarikçi göstergelerinin tamamı yıllık TSRS Sürdürülebilirlik Raporumuzda detaylı biçimde yayımlanır.',
  scopeTitle: 'Raporlama kapsamı',
  scopeItems: [
    'Çevre — Scope 1+2 sera gazı, enerji ve su tüketimi, atık ve geri kazanım',
    'Sosyal — istihdam, çeşitlilik, eğitim, iş sağlığı ve güvenliği',
    'Yönetişim — kurumsal yönetim, etik, tedarik zinciri uyumu',
  ],
  baseTitle: 'Çerçeve',
  baseItems: [
    'TSRS 1 — Sürdürülebilirlikle ilgili finansal bilgilerin açıklanması',
    'TSRS 2 — İklim ile ilgili açıklamalar',
    'Bağımsız üçüncü taraf güvence denetimi (KAP\'a bildirildi, 2026)',
  ],
  ctaPdf: 'Raporu indir · PDF',
  ctaArchive: 'Tüm raporlar',
  ctaArchiveHref: '#reports',
  latestLbl: 'En güncel rapor',
} : {
  marker: 'Performance · Performans',
  h2a: 'The numbers',
  h2em: 'are in the report',
  h2b: '.',
  intro: 'GHG inventory, energy and water intensity, waste, employee and supplier indicators are published in detail in our annual TSRS Sustainability Report.',
  scopeTitle: 'Reporting scope',
  scopeItems: [
    'Environment — Scope 1+2 GHG, energy and water consumption, waste & recovery',
    'Social — employment, diversity, training, health & safety',
    'Governance — corporate governance, ethics, supply chain compliance',
  ],
  baseTitle: 'Framework',
  baseItems: [
    'TSRS 1 — General Requirements for Disclosure of Sustainability-related Financial Information',
    'TSRS 2 — Climate-related Disclosures',
    'Independent third-party assurance engagement (filed via PDP, 2026)',
  ],
  ctaPdf: 'Download report · PDF',
  ctaArchive: 'All reports',
  ctaArchiveHref: '#reports',
  latestLbl: 'Latest report',
};
---

<section class="kpi-cta">
  <div class="container">
    <div class="kpi-head">
      <div>
        <div class="section-marker">
          <span class="num">03</span><span class="of">/</span><span>06</span><span class="dash">—</span><span class="label">{t.marker}</span>
        </div>
        <h2>{t.h2a} <em>{t.h2em}</em>{t.h2b}</h2>
      </div>
      <p class="intro">{t.intro}</p>
    </div>

    <div class="cta-grid">
      <article class="cta-card">
        <h3>{t.scopeTitle}</h3>
        <ul>
          {t.scopeItems.map((it) => <li>{it}</li>)}
        </ul>
      </article>

      <article class="cta-card">
        <h3>{t.baseTitle}</h3>
        <ul>
          {t.baseItems.map((it) => <li>{it}</li>)}
        </ul>
      </article>

      <article class="cta-card download">
        <span class="kicker">{t.latestLbl}</span>
        {latestTsrs ? (
          <>
            <h3 class="dl-title">{latestTsrs.title}</h3>
            <span class="dl-date">{formatDate(latestTsrs.date, locale)}</span>
          </>
        ) : (
          <h3 class="dl-title">TSRS Sürdürülebilirlik Raporu</h3>
        )}
        <div class="dl-actions">
          {latestTsrs ? (
            <a class="btn-primary" href={latestTsrs.pdfUrl} target="_blank" rel="noopener">
              {t.ctaPdf} <span class="arrow" aria-hidden="true">↗</span>
            </a>
          ) : null}
          <a class="btn-secondary" href={t.ctaArchiveHref}>
            {t.ctaArchive} <span class="arrow" aria-hidden="true">↓</span>
          </a>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
.kpi-cta { background: var(--paper-soft); padding: var(--section-y) 0; }

.kpi-head {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 4rem;
  align-items: end;
  margin-bottom: 2.5rem;
}
.kpi-head .section-marker .num { color: var(--success); }
.kpi-head h2 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 96, "SOFT" 65, "wght" 420;
  font-size: clamp(1.875rem, 3.6vw, 2.875rem);
  line-height: 1.08;
  letter-spacing: -0.022em;
  color: var(--ink);
  margin-top: 1rem;
  max-width: 560px;
}
.kpi-head h2 em {
  font-style: italic;
  font-variation-settings: "opsz" 96, "SOFT" 100, "wght" 380;
  color: var(--success);
}
.kpi-head .intro {
  font-size: 1rem;
  line-height: 1.6;
  color: var(--muted);
  max-width: 460px;
}

.cta-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1.1fr;
  gap: 1.25rem;
}

.cta-card {
  background: var(--paper);
  border: 1px solid var(--line);
  border-top: 3px solid var(--success);
  padding: 1.875rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.cta-card h3 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 72, "SOFT" 55, "wght" 500;
  font-size: 1.25rem;
  letter-spacing: -0.015em;
  color: var(--ink);
}
.cta-card ul {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 0.75rem;
  border-top: 1px solid var(--line);
  padding-top: 1rem;
}
.cta-card li {
  font-size: 0.9375rem;
  line-height: 1.5;
  color: var(--text);
  padding-left: 1.125rem;
  position: relative;
}
.cta-card li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0.55rem;
  width: 6px;
  height: 6px;
  border: 1.5px solid var(--success);
  border-radius: 50%;
}

.cta-card.download {
  background: var(--ink);
  color: var(--paper);
  border-color: var(--ink);
  border-top-color: var(--success);
  position: relative;
  overflow: hidden;
}
.cta-card.download::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 100% 0%, rgba(77,124,95,0.18), transparent 55%);
  pointer-events: none;
}
.cta-card.download .kicker {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #7BA88B;
  font-weight: 600;
  position: relative;
}
.cta-card.download .dl-title {
  font-family: var(--serif);
  font-variation-settings: "opsz" 72, "SOFT" 55, "wght" 480;
  font-size: 1.375rem;
  line-height: 1.2;
  color: var(--paper);
  position: relative;
}
.cta-card.download .dl-date {
  font-family: var(--mono);
  font-size: 0.75rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(247, 244, 238, 0.55);
  position: relative;
}
.cta-card.download .dl-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.625rem;
  margin-top: auto;
  padding-top: 1.25rem;
  border-top: 1px solid rgba(247, 244, 238, 0.12);
  position: relative;
}
.btn-primary, .btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1rem;
  font-family: var(--mono);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  transition: all var(--t-fast) var(--ease);
  white-space: nowrap;
}
.btn-primary { background: var(--success); color: var(--paper); }
.btn-primary:hover { background: #7BA88B; }
.btn-secondary {
  border: 1px solid rgba(247, 244, 238, 0.3);
  color: var(--paper);
  background: transparent;
}
.btn-secondary:hover { border-color: #7BA88B; color: #7BA88B; }
.btn-primary .arrow, .btn-secondary .arrow { transition: transform var(--t-fast) var(--ease-out); }
.btn-primary:hover .arrow, .btn-secondary:hover .arrow { transform: translate(2px, -1px); }

@media (max-width: 980px) {
  .kpi-head { grid-template-columns: 1fr; gap: 1.5rem; }
  .cta-grid { grid-template-columns: 1fr; }
}
</style>
