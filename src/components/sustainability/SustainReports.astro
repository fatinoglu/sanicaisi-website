---
/**
 * SustainReports — sürdürülebilirlik rapor arşivi
 * investor-documents koleksiyonundan type='surdurulebilirlik' kayıtlarını çeker
 */
import { getCollection } from 'astro:content';
import { getLocale, formatDate, formatBytes } from '../../lib/i18n';
const locale = getLocale(Astro.url.pathname);

// EN: surdurulebilirlik dokumanlari henuz cevrilmedi, TR'ye dus.
let all = await getCollection('investor-documents', (d) =>
  d.data.lang === locale && d.data.type === 'surdurulebilirlik'
);
if (all.length === 0 && locale !== 'tr') {
  all = await getCollection('investor-documents', (d) =>
    d.data.lang === 'tr' && d.data.type === 'surdurulebilirlik'
  );
}
const reports = all
  .map((r) => r.data)
  .sort((a, b) => +b.date - +a.date);

const t = locale === 'tr' ? {
  marker: 'Raporlar · Reports',
  h2a: 'Her yıl, eksiksiz',
  h2em: 'kanıt zinciri',
  h2b: '.',
  intro: 'TSRS uyum raporları ve sürdürülebilirlik uyum raporları yıllık olarak hazırlanır, KAP üzerinden ilan edilir ve burada arşivlenir.',
  empty: 'Henüz yayınlanmış sürdürülebilirlik raporu bulunmuyor.',
  table: { date: 'Tarih', title: 'Başlık', year: 'Dönem', file: 'Dosya' },
  all: 'Tüm yatırımcı dokümanları',
  allHref: '/yatirimci-iliskileri',
} : {
  marker: 'Reports · Raporlar',
  h2a: 'A complete',
  h2em: 'evidence chain',
  h2b: ', every year.',
  intro: 'TSRS-aligned reports and sustainability compliance reports are published annually, filed via the Public Disclosure Platform and archived here.',
  empty: 'No sustainability reports have been published yet.',
  table: { date: 'Date', title: 'Title', year: 'Period', file: 'File' },
  all: 'All investor documents',
  allHref: '/en/investor-relations',
};

function cleanTitle(s: string): string {
  return s
    .replace(/Yili/g, 'Yılı')
    .replace(/Surdurulebilirlik/g, 'Sürdürülebilirlik')
    .replace(/Uyumlu/g, 'Uyumlu');
}
---

<section class="reports" id="reports">
  <div class="container">
    <div class="rep-head">
      <div>
        <div class="section-marker">
          <span class="num">05</span><span class="of">/</span><span>06</span><span class="dash">—</span><span class="label">{t.marker}</span>
        </div>
        <h2>{t.h2a} <em>{t.h2em}</em>{t.h2b}</h2>
      </div>
      <p class="intro">{t.intro}</p>
    </div>

    {reports.length === 0 ? (
      <p class="empty">{t.empty}</p>
    ) : (
      <div class="rep-list" role="list">
        {reports.map((r) => (
          <a class="rep-row" role="listitem" href={r.pdfUrl} target="_blank" rel="noopener">
            <span class="date">{formatDate(r.date, locale)}</span>
            <span class="title">{locale === 'tr' ? cleanTitle(r.title) : r.title}</span>
            <span class="year">{r.year ?? ''}</span>
            <span class="file">
              <span class="pdf">PDF</span>
              {r.pdfSizeBytes && <span class="size">{formatBytes(r.pdfSizeBytes, locale)}</span>}
              <span class="dl" aria-hidden="true">↗</span>
            </span>
          </a>
        ))}
      </div>
    )}

    <div class="rep-foot">
      <a class="link-arrow" href={t.allHref}>
        {t.all} <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
.reports { background: var(--ink); color: var(--paper); padding: var(--section-y) 0; }

.rep-head {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 4rem;
  align-items: end;
  margin-bottom: 3rem;
}
.rep-head .section-marker { color: rgba(247, 244, 238, 0.65); }
.rep-head .section-marker .num { color: #7BA88B; }
.rep-head .section-marker .dash { color: rgba(247, 244, 238, 0.15); }
.rep-head .section-marker .label { color: var(--paper); }
.rep-head h2 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 96, "SOFT" 65, "wght" 420;
  font-size: clamp(1.875rem, 3.6vw, 2.875rem);
  line-height: 1.08;
  letter-spacing: -0.022em;
  color: var(--paper);
  margin-top: 1rem;
  max-width: 560px;
}
.rep-head h2 em {
  font-style: italic;
  font-variation-settings: "opsz" 96, "SOFT" 100, "wght" 380;
  color: #7BA88B;
}
.rep-head .intro {
  font-size: 1rem;
  line-height: 1.6;
  color: rgba(247, 244, 238, 0.7);
  max-width: 460px;
}

.empty {
  font-family: var(--mono);
  font-size: 0.875rem;
  color: rgba(247, 244, 238, 0.55);
  padding: 2rem 0;
  border-top: 1px solid rgba(247, 244, 238, 0.1);
  border-bottom: 1px solid rgba(247, 244, 238, 0.1);
}

.rep-list { display: grid; }
.rep-row {
  display: grid;
  grid-template-columns: 180px 1fr 110px 160px;
  align-items: baseline;
  gap: 1.5rem;
  padding: 1.5rem 0;
  border-top: 1px solid rgba(247, 244, 238, 0.1);
  color: var(--paper);
  transition: background var(--t-fast) var(--ease);
}
.rep-row:last-child { border-bottom: 1px solid rgba(247, 244, 238, 0.1); }
.rep-row:hover { background: rgba(247, 244, 238, 0.04); padding-inline: 1rem; }

.date {
  font-family: var(--mono);
  font-size: 0.75rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(247, 244, 238, 0.55);
}
.title {
  font-family: var(--serif);
  font-variation-settings: "opsz" 36, "SOFT" 55, "wght" 480;
  font-size: 1.125rem;
  line-height: 1.3;
  letter-spacing: -0.012em;
  color: var(--paper);
}
.year {
  font-family: var(--serif);
  font-variation-settings: "opsz" 96, "SOFT" 60, "wght" 500;
  font-size: 1.5rem;
  color: #7BA88B;
  font-variant-numeric: tabular-nums;
  text-align: right;
}
.file {
  display: inline-flex;
  align-items: baseline;
  gap: 0.625rem;
  justify-content: flex-end;
  font-family: var(--mono);
  font-size: 0.75rem;
  color: rgba(247, 244, 238, 0.7);
}
.pdf {
  padding: 0.1875rem 0.5rem;
  border: 1px solid rgba(247, 244, 238, 0.3);
  border-radius: 2px;
  font-weight: 600;
  letter-spacing: 0.12em;
  color: var(--paper);
}
.size { letter-spacing: 0.06em; }
.dl { color: #7BA88B; font-size: 1rem; }

.rep-foot {
  margin-top: 2rem;
  padding-top: 2rem;
  border-top: 1px solid rgba(247, 244, 238, 0.1);
}
.rep-foot .link-arrow { color: var(--paper); font-size: 1rem; }
.rep-foot .link-arrow:hover { color: #7BA88B; }

@media (max-width: 980px) {
  .rep-head { grid-template-columns: 1fr; gap: 1.5rem; }
  .rep-row {
    grid-template-columns: 1fr auto;
    gap: 0.5rem 1rem;
  }
  .date { grid-column: 1 / -1; }
  .title { grid-column: 1; }
  .year { grid-column: 2; font-size: 1.125rem; }
  .file { grid-column: 1 / -1; justify-content: flex-start; }
}
</style>
