---
/**
 * SustainCertifications — uluslararası standart ve taahhütler
 * 2 sütun: yönetim sistemleri (ISO) ve dış taahhütler (UN, CDP, vb.)
 */
import { getLocale } from '../../lib/i18n';
const locale = getLocale(Astro.url.pathname);

const t = locale === 'tr' ? {
  marker: 'Standartlar · Standards',
  h2a: 'Bağımsız onay,',
  h2em: 'sayfada söz değil',
  h2b: '.',
  intro: 'Yönetim sistemleri ve dış taahhütler bağımsız denetçilerle yıllık olarak yeniden değerlendirilir. Belgelerin tamamı yatırımcı portalında erişilebilir.',
  systemsTitle: 'Yönetim sistemleri',
  systemsSub: 'Akredite belgelendirme kuruluşları',
  commitTitle: 'Dış taahhütler',
  commitSub: 'İmzacı ve raporlayıcı program statüsü',
  systems: [
    { code: 'ISO 9001', name: 'Kalite Yönetim Sistemi', since: '1998' },
    { code: 'ISO 14001', name: 'Çevre Yönetim Sistemi', since: '2008' },
    { code: 'ISO 45001', name: 'İş Sağlığı ve Güvenliği', since: '2019' },
    { code: 'ISO 50001', name: 'Enerji Yönetim Sistemi', since: '2021' },
    { code: 'ISO 14064-1', name: 'Sera Gazı Envanteri', since: '2022' },
    { code: 'EN 442', name: 'Radyatör performans standardı', since: '2002' },
    { code: 'CE', name: 'Avrupa Uygunluk İşareti', since: '1996' },
    { code: 'EPD', name: 'Çevresel Ürün Beyanı (Panel radyatör)', since: '2023' },
  ],
  commits: [
    { code: 'UN GC', name: 'UN Global Compact — İmzacı', since: '2023' },
    { code: 'CDP', name: 'CDP Climate Change — Raporlayıcı', since: '2023' },
    { code: 'TSRS', name: 'TSRS 1 & 2 uyumlu raporlama', since: '2024' },
    { code: 'SBTi', name: 'Science Based Targets — Taahhüt', since: '2025' },
    { code: 'WEPs', name: 'BM Kadının Güçlenmesi İlkeleri', since: '2024' },
    { code: 'BIST Sürd.', name: 'BIST Sürdürülebilirlik Endeksi', since: '2025' },
  ],
} : {
  marker: 'Standards · Standartlar',
  h2a: 'Independent verification,',
  h2em: 'not page-level promises',
  h2b: '.',
  intro: 'Management systems and external commitments are re-assessed annually by independent auditors. Certificates are all available on the investor portal.',
  systemsTitle: 'Management systems',
  systemsSub: 'Accredited certification bodies',
  commitTitle: 'External commitments',
  commitSub: 'Signatory and reporting program status',
  systems: [
    { code: 'ISO 9001', name: 'Quality Management System', since: '1998' },
    { code: 'ISO 14001', name: 'Environmental Management System', since: '2008' },
    { code: 'ISO 45001', name: 'Occupational Health & Safety', since: '2019' },
    { code: 'ISO 50001', name: 'Energy Management System', since: '2021' },
    { code: 'ISO 14064-1', name: 'GHG Inventory', since: '2022' },
    { code: 'EN 442', name: 'Radiator performance standard', since: '2002' },
    { code: 'CE', name: 'European Conformity', since: '1996' },
    { code: 'EPD', name: 'Environmental Product Declaration (Panel radiator)', since: '2023' },
  ],
  commits: [
    { code: 'UN GC', name: 'UN Global Compact — Signatory', since: '2023' },
    { code: 'CDP', name: 'CDP Climate Change — Discloser', since: '2023' },
    { code: 'TSRS', name: 'TSRS 1 & 2 aligned reporting', since: '2024' },
    { code: 'SBTi', name: 'Science Based Targets — Committed', since: '2025' },
    { code: 'WEPs', name: 'UN Women\'s Empowerment Principles', since: '2024' },
    { code: 'BIST S.', name: 'BIST Sustainability Index', since: '2025' },
  ],
};
---

<section class="certs">
  <div class="container">
    <div class="certs-head">
      <div>
        <div class="section-marker">
          <span class="num">05</span><span class="of">/</span><span>07</span><span class="dash">—</span><span class="label">{t.marker}</span>
        </div>
        <h2>{t.h2a} <em>{t.h2em}</em>{t.h2b}</h2>
      </div>
      <p class="intro">{t.intro}</p>
    </div>

    <div class="certs-grid">
      <div class="card">
        <header>
          <h3>{t.systemsTitle}</h3>
          <p>{t.systemsSub}</p>
        </header>
        <ul>
          {t.systems.map((s) => (
            <li>
              <span class="code">{s.code}</span>
              <span class="name">{s.name}</span>
              <span class="since">{locale === 'tr' ? `${s.since}'den beri` : `since ${s.since}`}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="card dark">
        <header>
          <h3>{t.commitTitle}</h3>
          <p>{t.commitSub}</p>
        </header>
        <ul>
          {t.commits.map((c) => (
            <li>
              <span class="code">{c.code}</span>
              <span class="name">{c.name}</span>
              <span class="since">{locale === 'tr' ? `${c.since}'den beri` : `since ${c.since}`}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
.certs { background: var(--paper-soft); padding: var(--section-y) 0; }

.certs-head {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 4rem;
  align-items: end;
  margin-bottom: 3rem;
}
.certs-head .section-marker .num { color: var(--success); }
.certs-head h2 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 96, "SOFT" 65, "wght" 420;
  font-size: clamp(1.875rem, 3.6vw, 2.875rem);
  line-height: 1.08;
  letter-spacing: -0.022em;
  color: var(--ink);
  margin-top: 1rem;
  max-width: 560px;
}
.certs-head h2 em {
  font-style: italic;
  font-variation-settings: "opsz" 96, "SOFT" 100, "wght" 380;
  color: var(--success);
}
.certs-head .intro {
  font-size: 1rem;
  line-height: 1.6;
  color: var(--muted);
  max-width: 460px;
}

.certs-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;
}
.card {
  background: var(--paper);
  border: 1px solid var(--line);
  padding: 2rem;
  position: relative;
}
.card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: var(--success);
}
.card.dark {
  background: var(--ink);
  color: var(--paper);
  border-color: var(--ink);
}
.card.dark::before {
  background: linear-gradient(to right, var(--success), #7BA88B);
}

.card header {
  border-bottom: 1px solid var(--line);
  padding-bottom: 1.25rem;
  margin-bottom: 1.25rem;
}
.card.dark header { border-bottom-color: rgba(247, 244, 238, 0.12); }
.card h3 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 72, "SOFT" 55, "wght" 500;
  font-size: 1.375rem;
  letter-spacing: -0.015em;
  color: var(--ink);
  margin-bottom: 0.375rem;
}
.card.dark h3 { color: var(--paper); }
.card header p {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--muted);
}
.card.dark header p { color: rgba(247, 244, 238, 0.55); }

.card ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.25rem; }
.card li {
  display: grid;
  grid-template-columns: 110px 1fr auto;
  align-items: baseline;
  gap: 1rem;
  padding: 0.75rem 0;
  border-bottom: 1px dashed var(--line);
}
.card.dark li { border-bottom-color: rgba(247, 244, 238, 0.08); }
.card li:last-child { border-bottom: 0; }
.code {
  font-family: var(--mono);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: var(--success);
}
.card.dark .code { color: #7BA88B; }
.name {
  font-size: 0.9375rem;
  line-height: 1.4;
  color: var(--ink);
}
.card.dark .name { color: var(--paper); }
.since {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
  white-space: nowrap;
}
.card.dark .since { color: rgba(247, 244, 238, 0.5); }

@media (max-width: 980px) {
  .certs-head { grid-template-columns: 1fr; gap: 1.5rem; }
  .certs-grid { grid-template-columns: 1fr; }
}
@media (max-width: 540px) {
  .card li { grid-template-columns: 1fr; gap: 0.25rem; }
}
</style>
