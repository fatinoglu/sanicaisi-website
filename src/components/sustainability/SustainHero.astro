---
/**
 * SustainHero — sürdürülebilirlik sayfası açılış bölümü
 * Breadcrumb + section marker + büyük başlık + lead + TSRS rapor CTA.
 *
 * Eski 3 KPI bandı (sayılarla) kaldırıldı: doğrulanmamış değerler.
 * Yerine yayınlanmış 2024 TSRS Raporu için CTA kart konuldu.
 */
import { getCollection } from 'astro:content';
import { getLocale } from '../../lib/i18n';
const locale = getLocale(Astro.url.pathname);

// En güncel TSRS uyumlu sürdürülebilirlik raporunu çek
// EN: surdurulebilirlik dokumanlari henuz cevrilmedi, TR'ye dus.
let allDocs = await getCollection('investor-documents', (d) =>
  d.data.lang === locale && d.data.type === 'surdurulebilirlik'
);
if (allDocs.length === 0 && locale !== 'tr') {
  allDocs = await getCollection('investor-documents', (d) =>
    d.data.lang === 'tr' && d.data.type === 'surdurulebilirlik'
  );
}
const latestTsrs = allDocs
  .map((r) => r.data)
  .filter((r) => /tsrs/i.test(r.title) || /tsrs/i.test(r.slug ?? ''))
  .sort((a, b) => +b.date - +a.date)[0];

const t = locale === 'tr' ? {
  home: 'Anasayfa',
  here: 'Sürdürülebilirlik',
  marker: 'Sürdürülebilirlik · Sustainability',
  h1a: 'Ölçülen söz.',
  h1em: 'Üretilen sorumluluk',
  h1b: '.',
  lead: 'Sanica için sürdürülebilirlik bir iletişim teması değil, üretim hattındaki her kararın taşıdığı maliyettir. Performansımızı yıllık olarak TSRS uyumlu raporlarımızda kamuya açıklarız.',
  ctaKicker: 'Yayınlanmış rapor',
  ctaTitle: 'TSRS Uyumlu Sürdürülebilirlik Raporu',
  ctaBody: 'Sera gazı envanteri, enerji, su, atık, sosyal ve yönetişim göstergelerimizi içeren raporun tamamı KAP üzerinden ilan edilmiş ve aşağıda arşivlenmiştir.',
  ctaPdf: 'Raporu indir · PDF',
  ctaJump: 'Tüm raporlara git',
} : {
  home: 'Home',
  here: 'Sustainability',
  marker: 'Sustainability · Sürdürülebilirlik',
  h1a: 'Measured promise.',
  h1em: 'Manufactured responsibility',
  h1b: '.',
  lead: 'For Sanica, sustainability is not a communications theme — it is the cost carried by every decision on the production line. We publish performance data annually in our TSRS-aligned reports.',
  ctaKicker: 'Published report',
  ctaTitle: 'TSRS-Aligned Sustainability Report',
  ctaBody: 'GHG inventory, energy, water, waste, social and governance indicators — the full report is filed via the Public Disclosure Platform and archived below.',
  ctaPdf: 'Download report · PDF',
  ctaJump: 'Go to all reports',
};

const homeHref = locale === 'tr' ? '/' : '/en/';
---

<section class="sust-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label={locale === 'tr' ? 'Konum' : 'Breadcrumb'}>
      <a href={homeHref}>{t.home}</a>
      <span class="sep">/</span>
      <span class="current">{t.here}</span>
    </nav>

    <div class="hero-grid">
      <div class="hero-left">
        <div class="section-marker">
          <span class="num">01</span><span class="of">/</span><span>06</span><span class="dash">—</span><span class="label">{t.marker}</span>
        </div>
        <h1>{t.h1a}<br><em>{t.h1em}</em>{t.h1b}</h1>
        <p class="lead">{t.lead}</p>
      </div>

      <aside class="report-cta">
        <span class="kicker">{t.ctaKicker}</span>
        <h2 class="cta-title">{t.ctaTitle}</h2>
        <p class="cta-body">{t.ctaBody}</p>
        <div class="cta-actions">
          {latestTsrs ? (
            <a class="btn-primary" href={latestTsrs.pdfUrl} target="_blank" rel="noopener">
              {t.ctaPdf} <span class="arrow" aria-hidden="true">↗</span>
            </a>
          ) : null}
          <a class="btn-secondary" href="#reports">
            {t.ctaJump} <span class="arrow" aria-hidden="true">↓</span>
          </a>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
.sust-hero {
  background: var(--success-soft);
  padding: clamp(2.5rem, 5vw, 4rem) 0 clamp(3rem, 6vw, 5rem);
  position: relative;
  overflow: hidden;
}
.sust-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 92% 0%, rgba(77, 124, 95, 0.16), transparent 45%),
    radial-gradient(circle at 0% 100%, rgba(77, 124, 95, 0.10), transparent 50%);
  pointer-events: none;
}
.sust-hero > .container { position: relative; }

.breadcrumb {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 2rem;
}
.breadcrumb a { color: var(--muted); transition: color var(--t-fast) var(--ease); }
.breadcrumb a:hover { color: var(--success); }
.breadcrumb .sep { color: rgba(77, 124, 95, 0.3); }
.breadcrumb .current { color: var(--ink); font-weight: 500; }

.section-marker .num { color: var(--success); }

.hero-grid {
  display: grid;
  grid-template-columns: 1.35fr 1fr;
  gap: 4rem;
  align-items: end;
}
.hero-left .section-marker { margin-bottom: 1.5rem; }
.hero-left h1 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 144, "SOFT" 65, "wght" 420;
  font-size: clamp(2.5rem, 5.6vw, 4.5rem);
  line-height: 1.02;
  letter-spacing: -0.025em;
  color: var(--ink);
  margin-bottom: 1.5rem;
  max-width: 720px;
}
.hero-left h1 em {
  font-style: italic;
  font-variation-settings: "opsz" 144, "SOFT" 100, "wght" 380, "ital" 1;
  color: var(--success);
}
.hero-left .lead {
  font-family: var(--serif);
  font-variation-settings: "opsz" 36, "SOFT" 65, "wght" 380, "ital" 1;
  font-style: italic;
  font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
  line-height: 1.55;
  color: var(--text);
  max-width: 560px;
}

.report-cta {
  background: var(--paper);
  border: 1px solid rgba(77, 124, 95, 0.22);
  border-left: 4px solid var(--success);
  padding: 1.75rem 1.875rem;
  display: flex;
  flex-direction: column;
  gap: 0.875rem;
}
.report-cta .kicker {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-weight: 600;
  color: var(--success);
}
.report-cta .cta-title {
  font-family: var(--serif);
  font-variation-settings: "opsz" 72, "SOFT" 55, "wght" 500;
  font-size: clamp(1.25rem, 2vw, 1.5rem);
  line-height: 1.2;
  letter-spacing: -0.015em;
  color: var(--ink);
  margin: 0;
}
.report-cta .cta-body {
  font-size: 0.9375rem;
  line-height: 1.55;
  color: var(--text);
  margin: 0;
}
.cta-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.625rem;
  margin-top: 0.5rem;
}
.btn-primary, .btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1rem;
  font-family: var(--mono);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  transition: all var(--t-fast) var(--ease);
  white-space: nowrap;
}
.btn-primary {
  background: var(--success);
  color: var(--paper);
}
.btn-primary:hover { background: #3F6A4F; }
.btn-secondary {
  border: 1px solid rgba(77, 124, 95, 0.35);
  color: var(--ink);
  background: transparent;
}
.btn-secondary:hover { border-color: var(--success); color: var(--success); }
.btn-primary .arrow, .btn-secondary .arrow { transition: transform var(--t-fast) var(--ease-out); }
.btn-primary:hover .arrow, .btn-secondary:hover .arrow { transform: translateY(2px); }

@media (max-width: 980px) {
  .hero-grid { grid-template-columns: 1fr; gap: 2.5rem; }
}
</style>
