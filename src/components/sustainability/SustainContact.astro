---
/**
 * SustainContact — sürdürülebilirlik geri bildirim & iletişim bölümü.
 *
 * Önceki sürümde 3 ayrı kanal (surdurulebilirlik@sanica.com.tr, paydas@sanica.com.tr,
 * etikhat.sanica.com.tr) listeleniyordu — hiçbiri doğrulanmamış olduğundan kaldırıldı.
 * Yerine sayfada zaten doğrulanmış olan tek IR kanalı (yatirimci@sanicaisi.com.tr)
 * + IR sayfasına yönlendirme + KAP linki kullanılıyor.
 */
import { getLocale } from '../../lib/i18n';
const locale = getLocale(Astro.url.pathname);

const t = locale === 'tr' ? {
  marker: 'İletişim · Contact',
  h2a: 'Sorunuz,',
  h2em: 'önerinizi bekliyoruz',
  h2b: '.',
  intro: 'Sürdürülebilirlik kapsamı, raporlama ve hedeflerimize ilişkin sorularınızı Yatırımcı İlişkileri ekibimize iletebilirsiniz. Kamuya açıklamalarımız KAP üzerinden takip edilebilir.',
  irKicker: 'Yatırımcı İlişkileri',
  irTitle: 'Doğrudan iletişim',
  irBody: 'TSRS rapor kapsamı, ESG yaklaşımımız ve raporlama yöntemine ilişkin tüm sorular için.',
  irCta: 'yatirimci@sanicaisi.com.tr',
  irHref: 'mailto:yatirimci@sanicaisi.com.tr',
  irMore: 'Yatırımcı İlişkileri sayfası',
  irMoreHref: '/yatirimci-iliskileri',
  kapKicker: 'KAP · Kamuyu Aydınlatma Platformu',
  kapTitle: 'Resmi açıklamalar',
  kapBody: 'Sürdürülebilirlik uyum raporları ve TSRS bildirimleri başta olmak üzere tüm özel durum açıklamalarımız KAP üzerinden yayımlanır.',
  kapCta: 'kap.org.tr',
  kapHref: 'https://www.kap.org.tr/',
} : {
  marker: 'Contact · İletişim',
  h2a: 'Your question,',
  h2em: 'your input matters',
  h2b: '.',
  intro: 'Please reach our Investor Relations team for questions about reporting scope, targets and our sustainability approach. Public disclosures are available on the Public Disclosure Platform (PDP).',
  irKicker: 'Investor Relations',
  irTitle: 'Direct contact',
  irBody: 'For all questions on TSRS report scope, our ESG approach and reporting methodology.',
  irCta: 'yatirimci@sanicaisi.com.tr',
  irHref: 'mailto:yatirimci@sanicaisi.com.tr',
  irMore: 'Investor Relations page',
  irMoreHref: '/en/investor-relations',
  kapKicker: 'PDP · Public Disclosure Platform',
  kapTitle: 'Official disclosures',
  kapBody: 'Sustainability compliance reports, TSRS filings and all material event disclosures are published via the Public Disclosure Platform.',
  kapCta: 'kap.org.tr',
  kapHref: 'https://www.kap.org.tr/',
};
---

<section class="contact">
  <div class="container">
    <div class="ct-head">
      <div>
        <div class="section-marker">
          <span class="num">06</span><span class="of">/</span><span>06</span><span class="dash">—</span><span class="label">{t.marker}</span>
        </div>
        <h2>{t.h2a} <em>{t.h2em}</em>{t.h2b}</h2>
      </div>
      <p class="intro">{t.intro}</p>
    </div>

    <div class="ct-grid">
      <article class="ct-card">
        <span class="kicker">{t.irKicker}</span>
        <h3>{t.irTitle}</h3>
        <p>{t.irBody}</p>
        <div class="ct-actions">
          <a class="cta primary" href={t.irHref}>
            {t.irCta}
            <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a class="cta" href={t.irMoreHref}>
            {t.irMore}
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </article>

      <article class="ct-card">
        <span class="kicker">{t.kapKicker}</span>
        <h3>{t.kapTitle}</h3>
        <p>{t.kapBody}</p>
        <div class="ct-actions">
          <a class="cta primary" href={t.kapHref} target="_blank" rel="noopener">
            {t.kapCta}
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
.contact { background: var(--success-soft); padding: var(--section-y) 0; }

.ct-head {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 4rem;
  align-items: end;
  margin-bottom: 3rem;
}
.ct-head .section-marker .num { color: var(--success); }
.ct-head h2 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 96, "SOFT" 65, "wght" 420;
  font-size: clamp(1.875rem, 3.6vw, 2.875rem);
  line-height: 1.08;
  letter-spacing: -0.022em;
  color: var(--ink);
  margin-top: 1rem;
  max-width: 560px;
}
.ct-head h2 em {
  font-style: italic;
  font-variation-settings: "opsz" 96, "SOFT" 100, "wght" 380;
  color: var(--success);
}
.ct-head .intro {
  font-size: 1rem;
  line-height: 1.6;
  color: var(--text);
  max-width: 460px;
}

.ct-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;
}
.ct-card {
  background: var(--paper);
  border: 1px solid rgba(77, 124, 95, 0.18);
  padding: 2rem 1.875rem;
  display: flex;
  flex-direction: column;
  gap: 0.875rem;
  transition: all var(--t-med) var(--ease);
}
.ct-card:hover {
  border-color: var(--success);
  transform: translateY(-3px);
  box-shadow: 0 14px 32px -14px rgba(77, 124, 95, 0.28);
}
.kicker {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-weight: 600;
  color: var(--success);
}
.ct-card h3 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 36, "SOFT" 55, "wght" 500;
  font-size: 1.375rem;
  letter-spacing: -0.015em;
  color: var(--ink);
}
.ct-card p {
  font-size: 0.9375rem;
  line-height: 1.55;
  color: var(--text);
  flex: 1;
}

.ct-actions {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  padding-top: 1rem;
  border-top: 1px solid rgba(77, 124, 95, 0.18);
}
.cta {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--mono);
  font-size: 0.8125rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: var(--ink);
  word-break: break-all;
  transition: color var(--t-fast) var(--ease);
}
.cta.primary { color: var(--success); }
.cta .arrow { transition: transform var(--t-med) var(--ease-out); margin-left: auto; }
.ct-card:hover .cta { color: var(--success); }
.ct-card:hover .cta .arrow { transform: translateX(4px); }

@media (max-width: 980px) {
  .ct-head { grid-template-columns: 1fr; gap: 1.5rem; }
  .ct-grid { grid-template-columns: 1fr; }
}
</style>
