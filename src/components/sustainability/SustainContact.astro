---
/**
 * SustainContact — ESG iletişim ve geri bildirim kutusu
 * Sürdürülebilirlik komitesi & paydaş katılım e-postası
 */
import { getLocale } from '../../lib/i18n';
const locale = getLocale(Astro.url.pathname);

const t = locale === 'tr' ? {
  marker: 'İletişim · Contact',
  h2a: 'Sorunuz,',
  h2em: 'önerinizi bekliyoruz',
  h2b: '.',
  intro: 'Paydaş Katılım Planı çerçevesinde her geri bildirim 10 iş günü içinde yanıtlanır. Hassas içerikli ihbar için anonim hat ayrıca işler.',
  cards: [
    {
      kicker: 'Sürdürülebilirlik Komitesi',
      title: 'Şirket içi ana muhatap',
      body: 'Strateji, hedefler ve raporlama kapsamı hakkında sorularınız için.',
      ctaLabel: 'surdurulebilirlik@sanica.com.tr',
      ctaHref: 'mailto:surdurulebilirlik@sanica.com.tr',
    },
    {
      kicker: 'Paydaş Katılım Planı',
      title: 'Genel geri bildirim',
      body: 'Müşteri, çalışan, bayi ve toplulukların başvuru kanalı.',
      ctaLabel: 'paydas@sanica.com.tr',
      ctaHref: 'mailto:paydas@sanica.com.tr',
    },
    {
      kicker: 'Anonim İhbar Hattı',
      title: 'Etik & uyum',
      body: 'Bağımsız üçüncü taraf tarafından yönetilen, gizliliği garantili kanal.',
      ctaLabel: 'etikhat.sanica.com.tr',
      ctaHref: 'https://etikhat.sanica.com.tr',
    },
  ],
} : {
  marker: 'Contact · İletişim',
  h2a: 'Your question,',
  h2em: 'your input matters',
  h2b: '.',
  intro: 'Under our Stakeholder Engagement Plan, every submission is answered within 10 business days. A separate confidential whistleblower line is available for sensitive disclosures.',
  cards: [
    {
      kicker: 'Sustainability Committee',
      title: 'Primary internal contact',
      body: 'For questions about strategy, targets and reporting scope.',
      ctaLabel: 'surdurulebilirlik@sanica.com.tr',
      ctaHref: 'mailto:surdurulebilirlik@sanica.com.tr',
    },
    {
      kicker: 'Stakeholder Engagement Plan',
      title: 'General feedback',
      body: 'A channel for customers, employees, dealers and communities.',
      ctaLabel: 'paydas@sanica.com.tr',
      ctaHref: 'mailto:paydas@sanica.com.tr',
    },
    {
      kicker: 'Anonymous Whistleblower Line',
      title: 'Ethics & compliance',
      body: 'A confidentiality-guaranteed channel operated by an independent third party.',
      ctaLabel: 'etikhat.sanica.com.tr',
      ctaHref: 'https://etikhat.sanica.com.tr',
    },
  ],
};
---

<section class="contact">
  <div class="container">
    <div class="ct-head">
      <div>
        <div class="section-marker">
          <span class="num">07</span><span class="of">/</span><span>07</span><span class="dash">—</span><span class="label">{t.marker}</span>
        </div>
        <h2>{t.h2a} <em>{t.h2em}</em>{t.h2b}</h2>
      </div>
      <p class="intro">{t.intro}</p>
    </div>

    <div class="ct-grid">
      {t.cards.map((c) => (
        <article class="ct-card">
          <span class="kicker">{c.kicker}</span>
          <h3>{c.title}</h3>
          <p>{c.body}</p>
          <a class="cta" href={c.ctaHref}>
            {c.ctaLabel}
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.contact { background: var(--success-soft); padding: var(--section-y) 0; }

.ct-head {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 4rem;
  align-items: end;
  margin-bottom: 3rem;
}
.ct-head .section-marker .num { color: var(--success); }
.ct-head h2 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 96, "SOFT" 65, "wght" 420;
  font-size: clamp(1.875rem, 3.6vw, 2.875rem);
  line-height: 1.08;
  letter-spacing: -0.022em;
  color: var(--ink);
  margin-top: 1rem;
  max-width: 560px;
}
.ct-head h2 em {
  font-style: italic;
  font-variation-settings: "opsz" 96, "SOFT" 100, "wght" 380;
  color: var(--success);
}
.ct-head .intro {
  font-size: 1rem;
  line-height: 1.6;
  color: var(--text);
  max-width: 460px;
}

.ct-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.25rem;
}
.ct-card {
  background: var(--paper);
  border: 1px solid rgba(77, 124, 95, 0.18);
  padding: 1.875rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  transition: all var(--t-med) var(--ease);
}
.ct-card:hover {
  border-color: var(--success);
  transform: translateY(-3px);
  box-shadow: 0 14px 32px -14px rgba(77, 124, 95, 0.28);
}
.kicker {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-weight: 600;
  color: var(--success);
}
.ct-card h3 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 36, "SOFT" 55, "wght" 500;
  font-size: 1.25rem;
  letter-spacing: -0.015em;
  color: var(--ink);
}
.ct-card p {
  font-size: 0.9375rem;
  line-height: 1.55;
  color: var(--text);
  flex: 1;
}
.cta {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--mono);
  font-size: 0.8125rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: var(--ink);
  padding-top: 0.75rem;
  border-top: 1px solid rgba(77, 124, 95, 0.18);
  word-break: break-all;
  transition: color var(--t-fast) var(--ease);
}
.cta .arrow { transition: transform var(--t-med) var(--ease-out); margin-left: auto; }
.ct-card:hover .cta { color: var(--success); }
.ct-card:hover .cta .arrow { transform: translateX(4px); }

@media (max-width: 980px) {
  .ct-head { grid-template-columns: 1fr; gap: 1.5rem; }
  .ct-grid { grid-template-columns: 1fr; }
}
</style>
