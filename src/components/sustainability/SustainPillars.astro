---
/**
 * SustainPillars — ESG üç sütun (Çevre / Sosyal / Yönetişim)
 * Her sütun: ikon (SVG), başlık, açıklama, 3-4 madde
 */
import { getLocale } from '../../lib/i18n';
const locale = getLocale(Astro.url.pathname);

const t = locale === 'tr' ? {
  marker: 'Yaklaşım · Approach',
  h2a: 'Üç sütun. Tek bir',
  h2em: 'iş modeli',
  h2b: '.',
  intro: 'ESG raporlarımız 2024 itibarıyla TSRS 1 ve TSRS 2 çerçevesine uyumlu olarak hazırlanmaktadır. Aşağıdaki üç başlık raporlama kapsamımızın yapı taşlarıdır; ölçüm sonuçları yıllık TSRS raporunda yayımlanır.',
  bulletsNote: 'Sayısal göstergeler ve performans değerleri için yayımlanmış TSRS Sürdürülebilirlik Raporumuza başvurunuz.',
  pillars: [
    {
      idx: '01',
      title: 'Çevre',
      sub: 'Environment',
      body: 'Sera gazı, su, atık ve hammadde verimliliği — döngüsel üretimi temel alır.',
      bullets: [
        'Scope 1 & 2 sera gazı envanteri',
        'Çatı tipi güneş enerjisi santrali yatırımı (KAP\'a bildirildi, 2024)',
        'Boyahane sularında kapalı devre geri kazanım yaklaşımı',
        'Çelik ve alüminyum hurda geri kazanımı',
      ],
    },
    {
      idx: '02',
      title: 'Sosyal',
      sub: 'Social',
      body: 'Çalışan güvenliği, eşit fırsat ve yerel toplumlara yatırım.',
      bullets: [
        'İş sağlığı ve güvenliği yönetim sistemi',
        'Kadın istihdamı ve fırsat eşitliği politikası',
        'Düzenli teknik ve liderlik eğitim programları',
        'Eğitim ve burs programlarıyla yerel topluma destek',
      ],
    },
    {
      idx: '03',
      title: 'Yönetişim',
      sub: 'Governance',
      body: 'Şeffaf yönetim, etik tedarik zinciri ve risk denetimi.',
      bullets: [
        'Bağımsız üye ağırlıklı yönetim kurulu ve denetim komitesi',
        'Tedarikçi davranış kodu ve sürdürülebilirlik denetimleri',
        'Rüşvet ve yolsuzlukla mücadele politikası',
        'TSRS 1 & 2 uyumlu raporlama ve bağımsız üçüncü taraf güvence denetimi',
      ],
    },
  ],
} : {
  marker: 'Approach · Yaklaşım',
  h2a: 'Three pillars. One',
  h2em: 'business model',
  h2b: '.',
  intro: 'Since 2024 our ESG disclosures are prepared in alignment with TSRS 1 and TSRS 2. The three pillars below are the building blocks of our reporting scope; quantitative results are published in the annual TSRS report.',
  bulletsNote: 'For quantitative indicators and performance figures, please refer to our published TSRS Sustainability Report.',
  pillars: [
    {
      idx: '01',
      title: 'Environment',
      sub: 'Çevre',
      body: 'Greenhouse gases, water, waste and material efficiency — built around circular manufacturing.',
      bullets: [
        'Scope 1 & 2 GHG inventory',
        'Rooftop solar power plant investment (disclosed via PDP, 2024)',
        'Closed-loop water recovery approach in paint shop operations',
        'Steel and aluminium scrap recovery',
      ],
    },
    {
      idx: '02',
      title: 'Social',
      sub: 'Sosyal',
      body: 'Worker safety, equal opportunity and investment in local communities.',
      bullets: [
        'Occupational health and safety management system',
        'Female employment and equal opportunity policy',
        'Recurring technical and leadership training programs',
        'Local community support via education and scholarship programs',
      ],
    },
    {
      idx: '03',
      title: 'Governance',
      sub: 'Yönetişim',
      body: 'Transparent governance, ethical supply chain and structured risk oversight.',
      bullets: [
        'Independent-weighted board of directors and audit committee',
        'Supplier code of conduct and sustainability audits',
        'Anti-bribery and anti-corruption policy',
        'TSRS 1 & 2 aligned reporting with independent third-party assurance',
      ],
    },
  ],
};
---

<section class="pillars">
  <div class="container">
    <div class="pillars-head">
      <div>
        <div class="section-marker">
          <span class="num">02</span><span class="of">/</span><span>06</span><span class="dash">—</span><span class="label">{t.marker}</span>
        </div>
        <h2>{t.h2a} <em>{t.h2em}</em>{t.h2b}</h2>
      </div>
      <p class="intro">{t.intro}</p>
    </div>

    <div class="pillars-grid">
      {t.pillars.map((p) => (
        <article class="pillar">
          <header>
            <span class="idx">{p.idx}</span>
            <div>
              <h3>{p.title}</h3>
              <span class="sub">{p.sub}</span>
            </div>
          </header>
          <p class="body">{p.body}</p>
          <ul>
            {p.bullets.map((b) => <li>{b}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <p class="bullets-note">{t.bulletsNote}</p>
  </div>
</section>

<style>
.pillars { background: var(--paper); padding: var(--section-y) 0; }

.pillars-head {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 4rem;
  align-items: end;
  margin-bottom: 3.5rem;
}
.pillars-head .section-marker .num { color: var(--success); }
.pillars-head h2 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 96, "SOFT" 65, "wght" 420;
  font-size: clamp(1.875rem, 3.6vw, 2.875rem);
  line-height: 1.08;
  letter-spacing: -0.022em;
  color: var(--ink);
  margin-top: 1rem;
  max-width: 560px;
}
.pillars-head h2 em {
  font-style: italic;
  font-variation-settings: "opsz" 96, "SOFT" 100, "wght" 380;
  color: var(--success);
}
.pillars-head .intro {
  font-size: 1rem;
  line-height: 1.6;
  color: var(--muted);
  max-width: 460px;
}

.pillars-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.25rem;
}
.pillar {
  background: var(--paper-soft);
  border: 1px solid var(--line);
  border-top: 3px solid var(--success);
  padding: 1.875rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  transition: transform var(--t-med) var(--ease), border-color var(--t-med) var(--ease);
}
.pillar:hover {
  transform: translateY(-3px);
  border-color: var(--success);
}
.pillar header {
  display: flex;
  align-items: baseline;
  gap: 1rem;
}
.pillar .idx {
  font-family: var(--mono);
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.18em;
  color: var(--success);
}
.pillar h3 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 72, "SOFT" 55, "wght" 500;
  font-size: 1.5rem;
  letter-spacing: -0.018em;
  color: var(--ink);
}
.pillar .sub {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--muted);
}
.pillar .body {
  font-size: 0.9375rem;
  line-height: 1.55;
  color: var(--text);
}
.pillar ul {
  list-style: none;
  padding: 0;
  margin: 0;
  border-top: 1px solid var(--line);
  padding-top: 1rem;
  display: grid;
  gap: 0.625rem;
}
.pillar li {
  font-size: 0.875rem;
  line-height: 1.5;
  color: var(--text);
  padding-left: 1.125rem;
  position: relative;
}
.pillar li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0.55rem;
  width: 6px;
  height: 6px;
  border: 1.5px solid var(--success);
  border-radius: 50%;
}

.bullets-note {
  margin-top: 1.75rem;
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
  text-align: right;
}

@media (max-width: 980px) {
  .pillars-head { grid-template-columns: 1fr; gap: 1.5rem; }
  .pillars-grid { grid-template-columns: 1fr; }
  .bullets-note { text-align: left; }
}
</style>
