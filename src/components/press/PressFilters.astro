---
/**
 * PressFilters — kategori filtreleri (client-side data-attr toggle)
 * Sticky chip bar; "Tümü" + her kategori için sayım
 */
import { getLocale } from '../../lib/i18n';
const locale = getLocale(Astro.url.pathname);

interface Props {
  counts: Record<string, number>;
  total: number;
  active?: string;
}
const { counts, total, active = 'all' } = Astro.props;

const labels = locale === 'tr' ? {
  all: 'Tümü',
  'bizden-haberler': 'Bizden Haberler',
  'sosyal-sorumluluk': 'Sosyal Sorumluluk',
  'halka-arz': 'Halka Arz',
  filterBy: 'Filtrele',
} : {
  all: 'All',
  'bizden-haberler': 'Our News',
  'sosyal-sorumluluk': 'Social Responsibility',
  'halka-arz': 'IPO',
  filterBy: 'Filter',
};

const cats: { key: 'all' | 'bizden-haberler' | 'sosyal-sorumluluk' | 'halka-arz'; count: number }[] = [
  { key: 'all', count: total },
  { key: 'bizden-haberler', count: counts['bizden-haberler'] ?? 0 },
  { key: 'sosyal-sorumluluk', count: counts['sosyal-sorumluluk'] ?? 0 },
  { key: 'halka-arz', count: counts['halka-arz'] ?? 0 },
];
---

<nav class="press-filters" aria-label={labels.filterBy} data-press-filters>
  <div class="container">
    <div class="filter-bar">
      <span class="filter-label">{labels.filterBy}</span>
      {cats.map((c) => (
        <button
          type="button"
          class:list={['chip', { 'is-active': c.key === active }]}
          data-filter={c.key}
        >
          {labels[c.key]}
          <span class="cnt">{c.count}</span>
        </button>
      ))}
    </div>
  </div>
</nav>

<script>
  const root = document.querySelector('[data-press-filters]');
  if (root) {
    const grid = document.querySelector('[data-press-grid]') as HTMLElement | null;
    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-filter]') as HTMLButtonElement | null;
      if (!btn || !grid) return;
      const filter = btn.dataset.filter ?? 'all';
      root.querySelectorAll('[data-filter]').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const cards = grid.querySelectorAll<HTMLElement>('[data-card]');
      let visible = 0;
      cards.forEach((card) => {
        const cat = card.dataset.cat ?? '';
        const match = filter === 'all' || cat === filter;
        card.style.display = match ? '' : 'none';
        if (match) visible += 1;
      });
      grid.dataset.visible = String(visible);
    });
  }
</script>

<style>
.press-filters {
  position: sticky;
  top: var(--header-h);
  z-index: 60;
  background: rgba(247, 244, 238, 0.9);
  backdrop-filter: saturate(180%) blur(16px);
  -webkit-backdrop-filter: saturate(180%) blur(16px);
  border-bottom: 1px solid var(--line);
}
.filter-bar {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  height: var(--subnav-h);
  overflow-x: auto;
  scrollbar-width: none;
}
.filter-bar::-webkit-scrollbar { display: none; }
.filter-label {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--terracotta);
  font-weight: 600;
  white-space: nowrap;
  padding-right: 0.75rem;
  border-right: 1px solid var(--line);
}
.chip {
  display: inline-flex;
  align-items: baseline;
  gap: 0.5rem;
  padding: 0.5rem 0.9375rem;
  border: 1px solid var(--line);
  background: var(--paper);
  border-radius: 999px;
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--muted);
  white-space: nowrap;
  transition: all var(--t-fast) var(--ease);
  cursor: pointer;
}
.chip:hover { color: var(--ink); border-color: var(--ink); }
.chip.is-active {
  background: var(--ink);
  color: var(--paper);
  border-color: var(--ink);
}
.cnt {
  font-family: var(--mono);
  font-size: 0.6875rem;
  font-weight: 600;
  opacity: 0.65;
  font-variant-numeric: tabular-nums;
}
.chip.is-active .cnt { opacity: 1; }

@media (max-width: 980px) {
  .press-filters { top: var(--main-nav-h); }
}
</style>
