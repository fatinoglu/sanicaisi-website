---
/**
 * PressHero — Basında Biz açılış bölümü
 * Breadcrumb + section marker + büyük başlık + lead
 */
import { getLocale } from '../../lib/i18n';
const locale = getLocale(Astro.url.pathname);

interface Props {
  total: number;
  hint?: string;
}
const { total, hint } = Astro.props;

const t = locale === 'tr' ? {
  home: 'Anasayfa',
  here: 'Basında Biz',
  marker: 'Basında Biz · In the Press',
  h1a: 'Sanica\'dan',
  h1em: 'haberler',
  h1b: '.',
  lead: 'Halka arz sürecinden saha hikayelerine, sosyal sorumluluk projelerinden uluslararası fuarlara — şirketimizin gündemi.',
  count: (n: number) => `${n} haber arşivde`,
} : {
  home: 'Home',
  here: 'In the Press',
  marker: 'In the Press · Basında Biz',
  h1a: 'News from',
  h1em: 'Sanica',
  h1b: '.',
  lead: 'From the IPO journey to field stories, social responsibility projects to international trade fairs — the company\'s agenda in one place.',
  count: (n: number) => `${n} stories in the archive`,
};

const homeHref = locale === 'tr' ? '/' : '/en/';
---

<section class="press-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label={locale === 'tr' ? 'Konum' : 'Breadcrumb'}>
      <a href={homeHref}>{t.home}</a>
      <span class="sep">/</span>
      <span class="current">{t.here}</span>
    </nav>

    <div class="hero-grid">
      <div>
        <div class="section-marker">
          <span class="num">01</span><span class="of">/</span><span>02</span><span class="dash">—</span><span class="label">{t.marker}</span>
        </div>
        <h1>{t.h1a} <em>{t.h1em}</em>{t.h1b}</h1>
        <p class="lead">{t.lead}</p>
      </div>
      <aside class="hero-meta">
        <span class="count">{t.count(total)}</span>
        {hint && <span class="hint">{hint}</span>}
      </aside>
    </div>
  </div>
</section>

<style>
.press-hero {
  background: var(--paper);
  padding: clamp(2.5rem, 5vw, 4rem) 0 clamp(2.5rem, 5vw, 3.5rem);
  border-bottom: 1px solid var(--line);
}

.breadcrumb {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 2rem;
}
.breadcrumb a { color: var(--muted); transition: color var(--t-fast) var(--ease); }
.breadcrumb a:hover { color: var(--terracotta); }
.breadcrumb .sep { color: var(--line); }
.breadcrumb .current { color: var(--ink); font-weight: 500; }

.hero-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 3rem;
  align-items: end;
}
.section-marker { margin-bottom: 1.25rem; }

h1 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 144, "SOFT" 65, "wght" 420;
  font-size: clamp(2.5rem, 5.6vw, 4.5rem);
  line-height: 1.02;
  letter-spacing: -0.025em;
  color: var(--ink);
  margin-bottom: 1.25rem;
}
h1 em {
  font-style: italic;
  font-variation-settings: "opsz" 144, "SOFT" 100, "wght" 380, "ital" 1;
  color: var(--terracotta);
}
.lead {
  font-family: var(--serif);
  font-variation-settings: "opsz" 36, "SOFT" 65, "wght" 380, "ital" 1;
  font-style: italic;
  font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
  line-height: 1.5;
  color: var(--text);
  max-width: 560px;
}

.hero-meta {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  align-items: flex-end;
}
.count {
  font-family: var(--serif);
  font-variation-settings: "opsz" 96, "SOFT" 55, "wght" 460;
  font-size: clamp(1.5rem, 2.4vw, 2rem);
  color: var(--terracotta);
  letter-spacing: -0.018em;
  font-variant-numeric: tabular-nums;
}
.hint {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--muted);
}

@media (max-width: 980px) {
  .hero-grid { grid-template-columns: 1fr; gap: 1.5rem; align-items: start; }
  .hero-meta { align-items: flex-start; }
}
</style>
