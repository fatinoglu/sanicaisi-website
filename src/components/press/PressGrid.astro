---
/**
 * PressGrid — basın haberi kart grid'i
 * Sol büyük kart (featured) + 3 sütun grid; filtreyle uyumlu
 */
import { getLocale, formatDate, localizedUrl } from '../../lib/i18n';
const locale = getLocale(Astro.url.pathname);

interface PressItem {
  slug: string;
  title: string;
  date: Date;
  category: 'bizden-haberler' | 'sosyal-sorumluluk' | 'halka-arz';
  excerpt?: string;
  heroImage?: string;
  heroImageAlt?: string;
}

interface Props {
  items: PressItem[];
}
const { items } = Astro.props;

const catLabel = locale === 'tr' ? {
  'bizden-haberler': 'Bizden Haberler',
  'sosyal-sorumluluk': 'Sosyal Sorumluluk',
  'halka-arz': 'Halka Arz',
} : {
  'bizden-haberler': 'Our News',
  'sosyal-sorumluluk': 'Social Responsibility',
  'halka-arz': 'IPO',
};

const t = locale === 'tr' ? {
  read: 'Habere git',
  empty: 'Bu kategoride henüz haber yok.',
} : {
  read: 'Read story',
  empty: 'No news in this category yet.',
};

const base = locale === 'tr' ? '/basinda-biz' : '/en/press';
const detailHref = (slug: string) => localizedUrl(locale, `${locale === 'tr' ? '/basinda-biz' : '/press'}/${slug}`);
// (base unused but kept for clarity; href via localizedUrl)
void base;
---

<section class="press-grid-section">
  <div class="container">
    <div class="grid" data-press-grid data-visible={items.length}>
      {items.map((p, i) => (
        <a
          class:list={['card', { feat: i === 0 }]}
          href={detailHref(p.slug)}
          data-card
          data-cat={p.category}
        >
          <div class="card-media">
            {p.heroImage ? (
              <img src={p.heroImage} alt={p.heroImageAlt ?? p.title} loading={i < 3 ? 'eager' : 'lazy'} />
            ) : (
              <div class="no-img" aria-hidden="true">
                <span class="logo-mark">S</span>
              </div>
            )}
            <span class:list={['cat-pill', p.category]}>{catLabel[p.category]}</span>
          </div>
          <div class="card-body">
            <span class="date">{formatDate(p.date, locale)}</span>
            <h3>{p.title}</h3>
            {p.excerpt && i === 0 && <p class="excerpt">{p.excerpt}</p>}
            <span class="cta">
              {t.read}
              <span class="arrow" aria-hidden="true">→</span>
            </span>
          </div>
        </a>
      ))}
    </div>

    <p class="empty" data-press-empty hidden>{t.empty}</p>
  </div>
</section>

<script>
  // Filtre değiştiğinde visible=0 ise empty mesajını göster
  const grid = document.querySelector('[data-press-grid]') as HTMLElement | null;
  const empty = document.querySelector('[data-press-empty]') as HTMLElement | null;
  if (grid && empty) {
    const obs = new MutationObserver(() => {
      const visible = parseInt(grid.dataset.visible ?? '0', 10);
      empty.hidden = visible !== 0;
    });
    obs.observe(grid, { attributes: true, attributeFilter: ['data-visible'] });
  }
</script>

<style>
.press-grid-section {
  background: var(--paper);
  padding: clamp(2.5rem, 5vw, 4rem) 0 var(--section-y);
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-auto-rows: minmax(0, auto);
  gap: 1.5rem;
}

.card {
  display: flex;
  flex-direction: column;
  background: var(--paper-soft);
  border: 1px solid var(--line);
  overflow: hidden;
  transition: transform var(--t-med) var(--ease), border-color var(--t-med) var(--ease), box-shadow var(--t-med) var(--ease);
  color: inherit;
}
.card:hover {
  transform: translateY(-4px);
  border-color: var(--ink);
  box-shadow: 0 18px 36px -18px rgba(10,10,10,0.2);
}

.card.feat {
  grid-column: span 2;
  grid-row: span 2;
  flex-direction: row;
}
.card.feat .card-media { flex: 1.05; min-height: 100%; }
.card.feat .card-body { flex: 1; padding: 2.25rem; }

.card-media {
  position: relative;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  background: var(--sand);
}
.card-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 600ms var(--ease-out);
}
.card:hover .card-media img { transform: scale(1.04); }

.no-img {
  display: grid;
  place-items: center;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, var(--sand), var(--sand-deep));
}
.logo-mark {
  font-family: var(--serif);
  font-variation-settings: "opsz" 144, "SOFT" 60, "wght" 420;
  font-size: clamp(3rem, 6vw, 4.5rem);
  color: var(--terracotta);
  letter-spacing: -0.04em;
  opacity: 0.55;
}

.cat-pill {
  position: absolute;
  top: 0.75rem;
  left: 0.75rem;
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  font-weight: 600;
  padding: 0.3125rem 0.625rem;
  background: var(--paper);
  color: var(--ink);
  border-radius: 2px;
}
.cat-pill.bizden-haberler { color: var(--terracotta); }
.cat-pill.sosyal-sorumluluk { color: var(--success); background: var(--success-soft); }
.cat-pill.halka-arz { color: var(--bist-navy); background: var(--bist-navy-soft); }

.card-body {
  padding: 1.25rem 1.375rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.625rem;
  flex: 1;
}
.date {
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
}
.card h3 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 36, "SOFT" 55, "wght" 480;
  font-size: 1.0625rem;
  line-height: 1.28;
  letter-spacing: -0.012em;
  color: var(--ink);
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.card.feat h3 {
  font-size: clamp(1.5rem, 2.6vw, 2.25rem);
  font-variation-settings: "opsz" 96, "SOFT" 60, "wght" 460;
  line-height: 1.1;
  -webkit-line-clamp: unset;
  margin-bottom: 0.5rem;
}
.card.feat .excerpt {
  font-size: 1rem;
  line-height: 1.6;
  color: var(--text);
  margin-bottom: 0.75rem;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.cta {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--mono);
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ink);
  margin-top: auto;
}
.cta .arrow { transition: transform var(--t-med) var(--ease-out); }
.card:hover .cta { color: var(--terracotta); }
.card:hover .cta .arrow { transform: translateX(4px); }

.empty {
  text-align: center;
  padding: 4rem 0;
  font-family: var(--mono);
  font-size: 0.8125rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
}

@media (max-width: 980px) {
  .grid { grid-template-columns: repeat(2, 1fr); }
  .card.feat { grid-column: span 2; grid-row: auto; flex-direction: column; }
  .card.feat .card-media { aspect-ratio: 16/10; }
}
@media (max-width: 640px) {
  .grid { grid-template-columns: 1fr; }
  .card.feat { grid-column: span 1; }
}
</style>
