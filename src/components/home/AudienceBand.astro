---
/**
 * AudienceBand — 3 hedef kitle giriş kartı
 * Ev Sahibi / Profesyonel / Yatırımcı — her biri kendi vinyeti ile
 */
import { getLocale } from '../../lib/i18n';
const locale = getLocale(Astro.url.pathname);

const t = locale === 'tr' ? {
  marker: 'Yolunuzu seçin',
  h2a: 'Üç farklı dünya, ',
  h2em: 'tek bir çatı',
  h2b: '.',
  intro: 'Sanica Isı; ev sahiplerine, projeyi tasarlayan profesyonele ve halka açık şirketi takip eden yatırımcıya farklı kapılar açar.',
  cards: [
    {
      idx: 'I / III',
      tag: 'Ev Sahibi · 01',
      title: 'Eviniz için doğru ısıtma.',
      desc: 'Doğru radyatör boyutundan kombi seçimine, en yakın yetkili noktadan ürün rehberine kadar bütün soruların adresi.',
      links: [
        { label: 'Ürün rehberi', href: '/urunler' },
        { label: 'Bayi bul', href: '/bayi-bul' },
        { label: 'Yetkili servis', href: '/yetkili-servis' },
      ],
    },
    {
      idx: 'II / III',
      tag: 'Profesyonel · 02',
      title: 'Mimar, mühendis & proje firmaları.',
      desc: 'Tüm ürünler için teknik kataloglar, BIM kütüphanesi, performans tabloları ve proje destek hattı.',
      links: [
        { label: 'Teknik katalog', href: '/teknik-katalog' },
        { label: 'BIM kütüphanesi', href: '/bim' },
        { label: 'Proje destek', href: '/proje-destek' },
      ],
    },
    {
      idx: 'III / III',
      tag: 'Yatırımcı · 03',
      title: 'Halka açık şirket şeffaflığı.',
      desc: 'KAP açıklamaları, finansal raporlar, sürdürülebilirlik dökümanı ve sermaye yapısı — tek yerde.',
      links: [
        { label: 'Son raporlar', href: '/yatirimci-iliskileri/finansal-raporlar' },
        { label: 'KAP akışı', href: '/yatirimci-iliskileri/kap' },
        { label: 'Hisse bilgisi', href: '/yatirimci-iliskileri#performance' },
      ],
    },
  ],
} : {
  marker: 'Choose your path',
  h2a: 'Three worlds, ',
  h2em: 'one roof',
  h2b: '.',
  intro: 'Sanica Isı opens different doors to homeowners, the professionals designing projects, and investors following a public company.',
  cards: [
    {
      idx: 'I / III',
      tag: 'Homeowner · 01',
      title: 'The right heating for your home.',
      desc: 'From the right radiator size to boiler selection, from your nearest dealer to product guides — all answers here.',
      links: [
        { label: 'Product guide', href: '/en/products' },
        { label: 'Find dealer', href: '/en/find-dealer' },
        { label: 'Service', href: '/en/service' },
      ],
    },
    {
      idx: 'II / III',
      tag: 'Professional · 02',
      title: 'Architects, engineers & project firms.',
      desc: 'Technical catalogs, BIM library, performance tables and project support hotline for all products.',
      links: [
        { label: 'Technical catalog', href: '/en/technical-catalog' },
        { label: 'BIM library', href: '/en/bim' },
        { label: 'Project support', href: '/en/project-support' },
      ],
    },
    {
      idx: 'III / III',
      tag: 'Investor · 03',
      title: 'Public company transparency.',
      desc: 'PDP disclosures, financial reports, sustainability documents and capital structure — in one place.',
      links: [
        { label: 'Latest reports', href: '/en/investor-relations/financial-reports' },
        { label: 'PDP feed', href: '/en/investor-relations/disclosures' },
        { label: 'Stock info', href: '/en/investor-relations#performance' },
      ],
    },
  ],
};
---

<section class="audience-band">
  <div class="container">
    <div class="audience-head">
      <div>
        <div class="section-marker">
          <span class="num">02</span><span class="of">/</span><span>06</span><span class="dash">—</span><span class="label">{t.marker}</span>
        </div>
        <h2>{t.h2a}<em>{t.h2em}</em>{t.h2b}</h2>
      </div>
      <p class="audience-intro">{t.intro}</p>
    </div>

    <div class="audience-grid">

      <!-- Card I: Ev Sahibi -->
      <div class="aud-card">
        <span class="aud-index">{t.cards[0].idx}</span>
        <div class="aud-vignette">
          <svg viewBox="0 0 400 220" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <rect width="400" height="220" fill="#F7F4EE" />
            <g fill="none" stroke="#D9521C" stroke-width="1.5" opacity="0.18">
              <circle cx="200" cy="110" r="100" /><circle cx="200" cy="110" r="80" />
            </g>
            <g fill="none" stroke="#D9521C" stroke-width="1.5" opacity="0.35">
              <circle cx="200" cy="110" r="60" />
            </g>
            <rect x="160" y="80" width="80" height="60" rx="6" fill="#FBE6D8" />
            <g fill="#B8390C">
              <rect x="168" y="86" width="3" height="48" /><rect x="176" y="86" width="3" height="48" />
              <rect x="184" y="86" width="3" height="48" /><rect x="192" y="86" width="3" height="48" />
              <rect x="200" y="86" width="3" height="48" /><rect x="208" y="86" width="3" height="48" />
              <rect x="216" y="86" width="3" height="48" /><rect x="224" y="86" width="3" height="48" />
            </g>
            <g fill="#D9521C">
              <circle cx="120" cy="60" r="2" /><circle cx="280" cy="60" r="2" />
              <circle cx="100" cy="110" r="2.5" /><circle cx="300" cy="110" r="2.5" />
              <circle cx="120" cy="160" r="2" /><circle cx="280" cy="160" r="2" />
            </g>
            <line x1="40" y1="180" x2="360" y2="180" stroke="#0A0A0A" stroke-width="1" />
          </svg>
        </div>
        <div class="aud-tag">{t.cards[0].tag}</div>
        <h3>{t.cards[0].title}</h3>
        <p>{t.cards[0].desc}</p>
        <div class="aud-links">
          {t.cards[0].links.map((l) => <a href={l.href} class="aud-pill">{l.label}</a>)}
        </div>
      </div>

      <!-- Card II: Profesyonel -->
      <div class="aud-card">
        <span class="aud-index">{t.cards[1].idx}</span>
        <div class="aud-vignette">
          <svg viewBox="0 0 400 220" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <rect width="400" height="220" fill="#F7F4EE" />
            <g stroke="#D9CFB8" stroke-width="0.5">
              <line x1="0" y1="40" x2="400" y2="40" /><line x1="0" y1="80" x2="400" y2="80" />
              <line x1="0" y1="120" x2="400" y2="120" /><line x1="0" y1="160" x2="400" y2="160" />
              <line x1="80" y1="0" x2="80" y2="220" /><line x1="160" y1="0" x2="160" y2="220" />
              <line x1="240" y1="0" x2="240" y2="220" /><line x1="320" y1="0" x2="320" y2="220" />
            </g>
            <rect x="120" y="80" width="160" height="60" fill="none" stroke="#4A4D52" stroke-width="1.5" />
            <g stroke="#4A4D52" stroke-width="0.8">
              {[130,140,150,160,170,180,190,200,210,220,230,240,250,260,270].map((x) => (
                <line x1={x} y1="80" x2={x} y2="140" />
              ))}
            </g>
            <g stroke="#B8390C" stroke-width="0.8" fill="#B8390C">
              <line x1="120" y1="60" x2="280" y2="60" />
              <polygon points="120,60 126,57 126,63" /><polygon points="280,60 274,57 274,63" />
            </g>
            <text x="200" y="54" font-family="IBM Plex Mono" font-size="9" fill="#B8390C" text-anchor="middle" letter-spacing="1">1600 mm</text>
            <g stroke="#B8390C" stroke-width="0.8" fill="#B8390C">
              <line x1="300" y1="80" x2="300" y2="140" />
              <polygon points="300,80 297,86 303,86" /><polygon points="300,140 297,134 303,134" />
            </g>
            <text x="320" y="113" font-family="IBM Plex Mono" font-size="9" fill="#B8390C" letter-spacing="1">600</text>
            <circle cx="125" cy="150" r="3" fill="#B8390C" />
            <circle cx="275" cy="150" r="3" fill="#B8390C" />
            <text x="120" y="172" font-family="IBM Plex Mono" font-size="8" fill="#4A4D52" letter-spacing="1">S-PR / TYP 22 / 1600×600 / Q = 2,8 kW</text>
          </svg>
        </div>
        <div class="aud-tag">{t.cards[1].tag}</div>
        <h3>{t.cards[1].title}</h3>
        <p>{t.cards[1].desc}</p>
        <div class="aud-links">
          {t.cards[1].links.map((l) => <a href={l.href} class="aud-pill">{l.label}</a>)}
        </div>
      </div>

      <!-- Card III: Yatırımcı (dark) — şeffaflık/KAP belgeleri temalı vignette -->
      <div class="aud-card investor">
        <span class="aud-index">{t.cards[2].idx}</span>
        <div class="aud-vignette">
          <svg viewBox="0 0 400 220" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <rect width="400" height="220" fill="#1A1A1A" />
            <g font-family="IBM Plex Mono" font-size="7" fill="rgba(247,244,238,0.35)" letter-spacing="1.5">
              <text x="20" y="28">BIST: SNICA · YILDIZ PAZAR</text>
            </g>

            <!-- Back document -->
            <g opacity="0.55">
              <rect x="48" y="58" width="200" height="140" fill="#252525" stroke="rgba(247,244,238,0.12)" stroke-width="0.5" />
              <g stroke="rgba(247,244,238,0.18)" stroke-width="0.5">
                <line x1="62" y1="84" x2="200" y2="84" />
                <line x1="62" y1="100" x2="234" y2="100" />
                <line x1="62" y1="116" x2="180" y2="116" />
                <line x1="62" y1="132" x2="218" y2="132" />
                <line x1="62" y1="148" x2="160" y2="148" />
                <line x1="62" y1="164" x2="210" y2="164" />
              </g>
            </g>

            <!-- Front document -->
            <g>
              <rect x="86" y="40" width="220" height="160" fill="#2A2A2A" stroke="rgba(247,244,238,0.2)" stroke-width="0.6" />
              <g font-family="IBM Plex Mono" font-size="7" fill="rgba(247,244,238,0.5)" letter-spacing="1.5">
                <text x="100" y="62">KAP · ÖZEL DURUM AÇIKLAMASI</text>
              </g>
              <line x1="100" y1="70" x2="292" y2="70" stroke="rgba(184,57,12,0.6)" stroke-width="1.2" />
              <g stroke="rgba(247,244,238,0.35)" stroke-width="0.6">
                <line x1="100" y1="88" x2="280" y2="88" />
                <line x1="100" y1="102" x2="290" y2="102" />
                <line x1="100" y1="116" x2="252" y2="116" />
                <line x1="100" y1="138" x2="290" y2="138" />
                <line x1="100" y1="152" x2="270" y2="152" />
                <line x1="100" y1="166" x2="238" y2="166" />
              </g>
              <!-- Signature row -->
              <line x1="100" y1="184" x2="160" y2="184" stroke="rgba(247,244,238,0.6)" stroke-width="0.8" />
              <g font-family="IBM Plex Mono" font-size="6" fill="rgba(247,244,238,0.4)" letter-spacing="1">
                <text x="100" y="194">SANICA ISI · 2026</text>
              </g>
            </g>

            <!-- Verified seal (KAP onayı) -->
            <g transform="translate(312 124)">
              <circle r="32" fill="none" stroke="rgba(90,182,112,0.35)" stroke-width="0.6" stroke-dasharray="2 3" />
              <circle r="24" fill="rgba(26,26,26,0.95)" stroke="#5AB670" stroke-width="1" />
              <path d="M -8 0 L -2 6 L 9 -6" fill="none" stroke="#5AB670" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              <g font-family="IBM Plex Mono" font-size="6" fill="rgba(90,182,112,0.85)" letter-spacing="1.5" text-anchor="middle">
                <text x="0" y="-32">VERIFIED</text>
              </g>
            </g>
          </svg>
        </div>
        <div class="aud-tag">{t.cards[2].tag}</div>
        <h3>{t.cards[2].title}</h3>
        <p>{t.cards[2].desc}</p>
        <div class="aud-links">
          {t.cards[2].links.map((l) => <a href={l.href} class="aud-pill">{l.label}</a>)}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
.audience-band {
  padding: var(--section-y) 0;
  background: var(--paper);
}
.audience-head {
  display: flex;
  align-items: end;
  justify-content: space-between;
  margin-bottom: 3rem;
  gap: 2rem;
  flex-wrap: wrap;
}
.audience-head h2 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 96, "SOFT" 65, "wght" 420;
  font-size: clamp(1.875rem, 3.6vw, 2.875rem);
  line-height: 1.05;
  letter-spacing: -0.022em;
  color: var(--ink);
  max-width: 540px;
  margin-top: 1rem;
}
.audience-head h2 em {
  font-style: italic;
  font-variation-settings: "opsz" 96, "SOFT" 100, "wght" 380;
  color: var(--terracotta);
}
.audience-intro {
  font-size: 1rem;
  color: var(--muted);
  max-width: 360px;
  line-height: 1.55;
}

.audience-grid {
  display: grid;
  grid-template-columns: 1.2fr 1fr 1fr;
  gap: 1.25rem;
}

.aud-card {
  background: var(--sand);
  padding: 1.75rem 1.75rem 2rem;
  display: flex;
  flex-direction: column;
  position: relative;
  transition: transform var(--t-med) var(--ease-out), background var(--t-med) var(--ease);
  overflow: hidden;
}
.aud-card:hover {
  transform: translateY(-6px);
  background: var(--sand-deep);
}
.aud-card.investor { background: var(--ink); color: var(--paper); }
.aud-card.investor:hover { background: var(--ink-soft); }

.aud-index {
  position: absolute;
  top: 1.5rem;
  right: 1.75rem;
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.18em;
  color: var(--muted);
  text-transform: uppercase;
}
.aud-card.investor .aud-index { color: rgba(247, 244, 238, 0.45); }

.aud-vignette {
  aspect-ratio: 16/9;
  margin-bottom: 1.75rem;
  background: var(--paper);
  overflow: hidden;
  position: relative;
}
.aud-card.investor .aud-vignette { background: var(--ink-soft); }
.aud-vignette svg { width: 100%; height: 100%; }

.aud-tag {
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 0.625rem;
}
.aud-card.investor .aud-tag { color: rgba(247, 244, 238, 0.6); }

.aud-card h3 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 72, "SOFT" 55, "wght" 500;
  font-size: 1.625rem;
  font-weight: 500;
  line-height: 1.15;
  letter-spacing: -0.018em;
  color: var(--ink);
  margin-bottom: 0.875rem;
}
.aud-card.investor h3 { color: var(--paper); }

.aud-card p {
  font-size: 0.9375rem;
  line-height: 1.55;
  color: var(--muted);
  margin-bottom: 1.75rem;
  flex-grow: 1;
}
.aud-card.investor p { color: rgba(247, 244, 238, 0.7); }

.aud-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}
.aud-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.375rem 0.75rem;
  background: var(--paper);
  border: 1px solid var(--line);
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--text);
  border-radius: 999px;
  transition: all var(--t-fast) var(--ease);
}
.aud-pill:hover {
  background: var(--ink);
  border-color: var(--ink);
  color: var(--paper);
}
.aud-card.investor .aud-pill {
  background: rgba(247, 244, 238, 0.06);
  border-color: rgba(247, 244, 238, 0.15);
  color: var(--paper);
}
.aud-card.investor .aud-pill:hover {
  background: var(--terracotta);
  border-color: var(--terracotta);
}

@media (max-width: 980px) {
  .audience-grid { grid-template-columns: 1fr; }
}
</style>
