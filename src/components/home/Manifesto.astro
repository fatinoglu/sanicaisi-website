---
/**
 * Manifesto — dergi pull-quote + body + tech stats band
 */
import { getLocale } from '../../lib/i18n';
const locale = getLocale(Astro.url.pathname);

const t = locale === 'tr' ? {
  marker: 'Manifesto',
  quotePre: 'Isı bir mühendislik meselesi değil; ',
  quoteEm: 'kuşaktan kuşağa',
  quotePost: ' aktarılan bir miras.',
  cite: 'Yönetim Kurulu Başkanı, 2025 Faaliyet Raporu',
  p1: '1985\'te Kocaeli\'de bir küçük üretim hattıyla başladık. Bugün 35\'ten fazla ülkeye Türk çeliğinden ısı taşıyan, 2022\'den beri Borsa İstanbul\'da işlem gören bir aile şirketiyiz. Halka açılmak bir bitiş değil; aynı disiplinin daha geniş bir paydaş ailesiyle paylaşılması.',
  p2: 'Ürettiğimiz her radyatörün, her kombi gövdesinin, her boru katmanının arkasında dört nesil mühendis ve teknisyenin birikimi var. Sanica, mühendisliği güzel sanata yaklaştıran nadir yerlerden biri olmayı sürdürür.',
  stats: [
    { num: '1985 → 2026', accent: '1985', label: 'Kırk yıl aralıksız üretim' },
    { num: '35+ ülke', accent: '+', label: 'Avrupa · Orta Doğu · K. Afrika' },
    { num: '4,2M adet/yıl', accent: 'M', label: 'Yıllık üretim kapasitesi' },
    { num: '600+ çalışan', accent: '+', label: 'İki tesis · üç vardiya' },
  ],
} : {
  marker: 'Manifesto',
  quotePre: 'Heat is not an engineering matter; it\'s a heritage passed ',
  quoteEm: 'from generation to generation',
  quotePost: '.',
  cite: 'Chairman of the Board, 2025 Annual Report',
  p1: 'We started in 1985 with a small production line in Kocaeli. Today we are a family company carrying heat from Turkish steel to 35+ countries, listed on Borsa İstanbul since 2022. Going public is not an end; it\'s sharing the same discipline with a broader family of stakeholders.',
  p2: 'Behind every radiator we produce, every boiler body, every pipe layer lies the accumulated knowledge of four generations of engineers and technicians. Sanica continues to be one of the rare places where engineering approaches fine art.',
  stats: [
    { num: '1985 → 2026', accent: '1985', label: 'Forty years of continuous production' },
    { num: '35+ countries', accent: '+', label: 'Europe · Middle East · N. Africa' },
    { num: '4.2M units/yr', accent: 'M', label: 'Annual production capacity' },
    { num: '600+ employees', accent: '+', label: 'Two facilities · three shifts' },
  ],
};

// Helper to render num with accent — splits by the accent token
function renderStatNum(num: string, accent: string) {
  const parts = num.split(accent);
  return { parts, accent };
}
---

<section class="manifesto">
  <div class="container">

    <div class="manifesto-grid">

      <div class="manifesto-quote">
        <span class="quote-mark">"</span>
        <blockquote>
          {t.quotePre}<em>{t.quoteEm}</em>{t.quotePost}
        </blockquote>
        <cite><span class="dash">—</span>{t.cite}</cite>
      </div>

      <div class="manifesto-body">
        <div class="section-marker">
          <span class="num">04</span><span class="of">/</span><span>06</span><span class="dash">—</span><span class="label">{t.marker}</span>
        </div>
        <p>{t.p1}</p>
        <p>{t.p2}</p>
      </div>

    </div>

    <!-- Tech stats band -->
    <div class="tech-stats">
      {t.stats.map((s) => {
        const rendered = renderStatNum(s.num, s.accent);
        return (
          <div class="tech-stat">
            <span class="tech-stat-num">
              {rendered.parts[0]}<span class="accent">{s.accent}</span>{rendered.parts[1]}
            </span>
            <span class="tech-stat-label">{s.label}</span>
          </div>
        );
      })}
    </div>

  </div>
</section>

<style>
.manifesto {
  background: var(--paper);
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  padding: var(--section-y) 0;
}
.manifesto-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: clamp(2rem, 6vw, 5rem);
  align-items: start;
}
.manifesto-quote { position: relative; }
.manifesto-quote .quote-mark {
  font-family: var(--serif);
  font-variation-settings: "opsz" 144, "SOFT" 100, "wght" 380, "ital" 1;
  font-style: italic;
  font-size: clamp(5rem, 9vw, 8rem);
  line-height: 0.6;
  color: var(--terracotta);
  margin-bottom: 0.5rem;
  display: block;
}
.manifesto-quote blockquote {
  font-family: var(--serif);
  font-variation-settings: "opsz" 96, "SOFT" 70, "wght" 380, "ital" 1;
  font-style: italic;
  font-size: clamp(1.625rem, 3.4vw, 2.875rem);
  line-height: 1.18;
  letter-spacing: -0.012em;
  color: var(--ink);
  margin-bottom: 1.5rem;
  max-width: 640px;
}
.manifesto-quote blockquote em { color: var(--terracotta); }
.manifesto-quote cite {
  display: block;
  font-family: var(--mono);
  font-size: 0.75rem;
  letter-spacing: 0.12em;
  color: var(--muted);
  font-style: normal;
  text-transform: uppercase;
}
.manifesto-quote cite .dash { color: var(--terracotta); margin-right: 0.375rem; }

.manifesto-body {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}
.manifesto-body .section-marker { margin-bottom: 0.875rem; }
.manifesto-body p {
  font-size: 1.0625rem;
  line-height: 1.65;
  color: var(--text);
  max-width: 460px;
}
.manifesto-body p:first-of-type::first-letter {
  font-family: var(--serif);
  font-variation-settings: "opsz" 144, "SOFT" 80, "wght" 600;
  font-size: 3.5rem;
  line-height: 0.85;
  float: left;
  padding: 0.25rem 0.625rem 0 0;
  color: var(--terracotta);
  font-weight: 600;
}

.tech-stats {
  margin-top: clamp(3rem, 6vw, 5rem);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}
.tech-stat {
  padding: 1.75rem 1.5rem 1.75rem 0;
  border-right: 1px solid var(--line);
}
.tech-stat:last-child { border-right: none; }
.tech-stat:not(:first-child) { padding-left: 1.5rem; }

.tech-stat-num {
  font-family: var(--mono);
  font-size: clamp(1.5rem, 2.4vw, 2rem);
  font-weight: 500;
  letter-spacing: -0.01em;
  color: var(--ink);
  margin-bottom: 0.5rem;
  font-variant-numeric: tabular-nums;
  display: block;
  line-height: 1.1;
}
.tech-stat-num .accent { color: var(--terracotta); }

.tech-stat-label {
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--muted);
  line-height: 1.5;
}

@media (max-width: 980px) {
  .manifesto-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  .tech-stats { grid-template-columns: repeat(2, 1fr); }
  .tech-stat:nth-child(2) { border-right: none; }
  .tech-stat:nth-child(3), .tech-stat:nth-child(4) {
    border-top: 1px solid var(--line); padding-top: 1.75rem;
  }
}
@media (max-width: 720px) {
  .tech-stats { grid-template-columns: 1fr; }
  .tech-stat { border-right: none; border-bottom: 1px solid var(--line); padding: 1.25rem 0; }
  .tech-stat:last-child { border-bottom: none; }
}
</style>
