---
/**
 * InvestorBand — full dark statement section
 * KAP timeline (sol, gerçek veri) + kurumsal künye + CTA kartı (sağ).
 *
 * KAP verisi: src/content/kap/ (WP'den migrate, 230+ kayıt)
 * Canlı fiyat verisi henüz beslenmiyor → KAP'a yönlendirme yapılıyor.
 */
import { getCollection } from 'astro:content';
import { getLocale } from '../../lib/i18n';
const locale = getLocale(Astro.url.pathname);

// En yeni 4 KAP açıklamasını çek
const allKap = await getCollection('kap', (e) => e.data.lang === locale);
const recentKap = allKap
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

// Frontmatter category → CSS class + display label map
const tagClassMap: Record<string, string> = {
  finansal: 'fin', 'genel-kurul': 'assembly', yatirim: 'capital',
  esg: 'esg', sermaye: 'capital', bilgilendirme: 'kap',
};
const tagLabelMap = locale === 'tr'
  ? { finansal: 'Finansal', 'genel-kurul': 'Genel Kurul', yatirim: 'Yatırım', esg: 'Sürdürülebilirlik', sermaye: 'Sermaye', bilgilendirme: 'Bilgilendirme' }
  : { finansal: 'Financial', 'genel-kurul': 'Assembly', yatirim: 'Investment', esg: 'Sustainability', sermaye: 'Capital', bilgilendirme: 'Notice' };

// Kısa tarih formatı (örn. "22 May<br>2026")
function shortDate(date: Date): string {
  const day = date.getDate();
  const monthShort = locale === 'tr'
    ? ['Oca', 'Şub', 'Mar', 'Nis', 'May', 'Haz', 'Tem', 'Ağu', 'Eyl', 'Eki', 'Kas', 'Ara'][date.getMonth()]
    : ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'][date.getMonth()];
  return `${day} ${monthShort}<br>${date.getFullYear()}`;
}

const t = locale === 'tr' ? {
  marker: 'Yatırımcı İlişkileri · Investor Relations',
  pillLabel: 'BIST · SNICA · Yıldız Pazar',
  h2a: 'Halka açık. ',
  h2em: 'Şeffaf.',
  h2b: 'Takip edilebilir.',
  kapLinkLabel: 'KAP →',
  cardEyebrow: 'Künye',
  cardTitle: 'SNICA',
  cardSub: 'BIST Yıldız Pazar · BIST Sanayi',
  stats: [
    { lbl: 'Halka Açıklık', val: '%30,00' },
    { lbl: 'Ödenmiş Sermaye', val: '₺40.000.000' },
    { lbl: 'Pay Sayısı', val: '40.000.000' },
    { lbl: 'İşlem Başlangıcı', val: '24.11.2022' },
    { lbl: 'ISIN', val: 'TRESNCAW91D8' },
    { lbl: 'Bağımsız Denetçi', val: 'PwC Türkiye' },
  ],
  cardNote: 'Anlık fiyat ve hacim için resmi kaynak olarak KAP\'ı kullanın.',
  cardCtaKap: 'KAP · kap.org.tr',
  cardCtaIR: 'Yatırımcı İlişkileri',
  footText: '→ TÜM AÇIKLAMALAR, RAPORLAR VE SUNUMLAR',
  footLink: 'Yatırımcı İlişkileri sayfasına git',
  footHref: '/yatirimci-iliskileri',
} : {
  marker: 'Investor Relations · Yatırımcı İlişkileri',
  pillLabel: 'BIST · SNICA · Star Market',
  h2a: 'Public. ',
  h2em: 'Transparent.',
  h2b: 'Trackable.',
  kapLinkLabel: 'PDP →',
  cardEyebrow: 'Profile',
  cardTitle: 'SNICA',
  cardSub: 'BIST Star Market · BIST Industrial',
  stats: [
    { lbl: 'Free Float', val: '30.00%' },
    { lbl: 'Paid Capital', val: '₺40,000,000' },
    { lbl: 'Share Count', val: '40,000,000' },
    { lbl: 'Listing Date', val: '24.11.2022' },
    { lbl: 'ISIN', val: 'TRESNCAW91D8' },
    { lbl: 'Auditor', val: 'PwC Türkiye' },
  ],
  cardNote: 'For real-time price and volume, use PDP (KAP) as the official source.',
  cardCtaKap: 'PDP · kap.org.tr',
  cardCtaIR: 'Investor Relations',
  footText: '→ ALL DISCLOSURES, REPORTS AND PRESENTATIONS',
  footLink: 'Go to Investor Relations page',
  footHref: '/en/investor-relations',
};

const kapUrl = 'https://www.kap.org.tr/';
---

<section class="investor dark">
  <div class="container">

    <div class="investor-head">
      <div class="section-marker">
        <span class="num">05</span><span class="of">/</span><span>06</span><span class="dash">—</span><span class="label">{t.marker}</span>
      </div>
      <div class="snica-pill">
        <span class="tag">{t.pillLabel}</span>
      </div>
    </div>

    <h2>{t.h2a}<em>{t.h2em}</em><br>{t.h2b}</h2>

    <div class="investor-grid">

      <!-- Timeline — gerçek KAP verisi -->
      <div>
        <div class="kap-timeline">
          {recentKap.map((item) => (
            <article class="kap-item">
              <span class="kap-date" set:html={shortDate(item.data.date)} />
              <div class="kap-meta">
                <span class={`kap-tag ${tagClassMap[item.data.category]}`}>
                  {tagLabelMap[item.data.category as keyof typeof tagLabelMap]}
                </span>
                <h3 class="kap-title">{item.data.title}</h3>
              </div>
              {item.data.kapUrl ? (
                <a href={item.data.kapUrl} target="_blank" rel="noopener" class="kap-link">{t.kapLinkLabel}</a>
              ) : (
                <span class="kap-link" />
              )}
            </article>
          ))}
        </div>
      </div>

      <!-- Profile card (statik kurumsal künye + KAP yönlendirmesi) -->
      <div>
        <div class="profile-card">
          <span class="profile-eyebrow">{t.cardEyebrow}</span>
          <h3 class="profile-title">{t.cardTitle}</h3>
          <span class="profile-sub">{t.cardSub}</span>

          <dl class="profile-stats">
            {t.stats.map((s) => (
              <div class="profile-stat">
                <dt>{s.lbl}</dt>
                <dd>{s.val}</dd>
              </div>
            ))}
          </dl>

          <p class="profile-note">{t.cardNote}</p>

          <div class="profile-ctas">
            <a class="profile-cta primary" href={kapUrl} target="_blank" rel="noopener">
              {t.cardCtaKap} <span class="arrow" aria-hidden="true">↗</span>
            </a>
            <a class="profile-cta" href={t.footHref}>
              {t.cardCtaIR} <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>

    </div>

    <div class="investor-foot">
      <span class="text">{t.footText}</span>
      <a href={t.footHref}>{t.footLink} <span class="arrow" aria-hidden="true">→</span></a>
    </div>

  </div>
</section>

<style>
.investor {
  background: var(--ink);
  color: var(--paper);
  padding: var(--section-y) 0;
  position: relative;
  overflow: hidden;
}
.investor::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 70% 50% at 80% 30%, rgba(217,82,28,0.08) 0%, transparent 60%);
  pointer-events: none;
}

.investor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 2.5rem;
  gap: 2rem;
  flex-wrap: wrap;
  position: relative;
}

.snica-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.875rem;
  background: rgba(247, 244, 238, 0.05);
  border: 1px solid rgba(247, 244, 238, 0.12);
  padding: 0.5rem 1rem;
  border-radius: 999px;
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}
.snica-pill .tag { color: rgba(247, 244, 238, 0.75); }

.investor h2 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 144, "SOFT" 65, "wght" 420;
  font-size: clamp(2.25rem, 5vw, 4rem);
  line-height: 1.02;
  letter-spacing: -0.025em;
  color: var(--paper);
  margin-bottom: 3rem;
  max-width: 900px;
  position: relative;
}
.investor h2 em {
  font-style: italic;
  font-variation-settings: "opsz" 144, "SOFT" 100, "wght" 380;
  color: var(--terracotta-warm);
}

.investor-grid {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: clamp(2rem, 5vw, 4.5rem);
  position: relative;
}

.kap-timeline {
  position: relative;
  padding-left: 1.5rem;
}
.kap-timeline::before {
  content: '';
  position: absolute;
  top: 0.5rem;
  bottom: 1rem;
  left: 4px;
  width: 1px;
  background: repeating-linear-gradient(to bottom, rgba(247, 244, 238, 0.2) 0, rgba(247, 244, 238, 0.2) 3px, transparent 3px, transparent 8px);
}

.kap-item {
  position: relative;
  padding: 1.25rem 0 1.25rem 1.5rem;
  border-bottom: 1px solid rgba(247, 244, 238, 0.08);
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 1.25rem;
  align-items: start;
}
.kap-item:last-child { border-bottom: none; }
.kap-item::before {
  content: '';
  position: absolute;
  top: 1.625rem;
  left: -1.5rem;
  width: 9px;
  height: 9px;
  background: var(--terracotta);
  border-radius: 50%;
  border: 2px solid var(--ink);
  box-shadow: 0 0 0 1px var(--terracotta);
}

.kap-date {
  font-family: var(--mono);
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  color: rgba(247, 244, 238, 0.55);
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
  padding-top: 2px;
}
.kap-meta { display: flex; flex-direction: column; gap: 0.375rem; }
.kap-tag {
  font-family: var(--mono);
  font-size: 0.6rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-weight: 600;
  align-self: flex-start;
  padding: 0.1875rem 0.4375rem;
  border-radius: 2px;
}
.kap-tag.kap { background: rgba(26, 43, 71, 0.5); color: #B8C7E0; }
.kap-tag.fin { background: rgba(184, 57, 12, 0.18); color: var(--terracotta-warm); }
.kap-tag.esg { background: rgba(77, 124, 95, 0.2); color: #A5C5AC; }
.kap-tag.assembly { background: rgba(247, 244, 238, 0.1); color: rgba(247, 244, 238, 0.8); }

.kap-title {
  font-family: var(--serif);
  font-variation-settings: "opsz" 36, "SOFT" 50, "wght" 470;
  font-size: 1.0625rem;
  font-weight: 470;
  line-height: 1.35;
  color: var(--paper);
}

.kap-link {
  align-self: start;
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(247, 244, 238, 0.6);
  transition: color var(--t-fast) var(--ease);
  white-space: nowrap;
  padding-top: 4px;
}
.kap-link:hover { color: var(--terracotta-warm); }

/* Profile card (sahte fiyat kartının yerine geçti) */
.profile-card {
  background: var(--ink-soft);
  border: 1px solid rgba(247, 244, 238, 0.08);
  padding: 2.25rem 2rem;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}
.profile-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(to right, var(--terracotta), var(--terracotta-warm));
}

.profile-eyebrow {
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(247, 244, 238, 0.55);
}
.profile-title {
  font-family: var(--serif);
  font-variation-settings: "opsz" 144, "SOFT" 60, "wght" 400;
  font-size: clamp(2.5rem, 4.5vw, 3.75rem);
  line-height: 1;
  color: var(--paper);
  letter-spacing: -0.025em;
  margin: -0.25rem 0 -0.5rem;
}
.profile-sub {
  font-family: var(--mono);
  font-size: 0.75rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(247, 244, 238, 0.5);
}

.profile-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem 1.5rem;
  margin: 0.5rem 0 0;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(247, 244, 238, 0.08);
}
.profile-stat { display: flex; flex-direction: column; gap: 0.25rem; }
.profile-stat dt {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(247, 244, 238, 0.45);
}
.profile-stat dd {
  font-family: var(--mono);
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--paper);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.02em;
  margin: 0;
}

.profile-note {
  font-size: 0.8125rem;
  line-height: 1.55;
  color: rgba(247, 244, 238, 0.6);
  padding-top: 1.25rem;
  border-top: 1px solid rgba(247, 244, 238, 0.08);
  margin: 0;
}

.profile-ctas { display: flex; flex-wrap: wrap; gap: 0.625rem; }
.profile-cta {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.625rem 0.875rem;
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: rgba(247, 244, 238, 0.8);
  border: 1px solid rgba(247, 244, 238, 0.18);
  transition: all var(--t-fast) var(--ease);
}
.profile-cta:hover { color: var(--paper); border-color: rgba(247, 244, 238, 0.4); background: rgba(247, 244, 238, 0.04); }
.profile-cta.primary {
  background: var(--terracotta);
  border-color: var(--terracotta);
  color: var(--paper);
}
.profile-cta.primary:hover { background: var(--terracotta-warm); border-color: var(--terracotta-warm); }
.profile-cta .arrow { transition: transform var(--t-fast) var(--ease-out); }
.profile-cta:hover .arrow { transform: translateX(3px); }

.investor-foot {
  margin-top: 3rem;
  padding-top: 2rem;
  border-top: 1px solid rgba(247, 244, 238, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  flex-wrap: wrap;
}
.investor-foot .text {
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(247, 244, 238, 0.55);
}
.investor-foot a {
  font-family: var(--serif);
  font-variation-settings: "opsz" 96, "SOFT" 60, "wght" 480;
  font-size: clamp(1.125rem, 1.8vw, 1.5rem);
  color: var(--paper);
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  transition: color var(--t-fast) var(--ease);
}
.investor-foot a:hover { color: var(--terracotta-warm); }
.investor-foot a .arrow { transition: transform var(--t-med) var(--ease-out); }
.investor-foot a:hover .arrow { transform: translateX(6px); }

@media (max-width: 980px) {
  .investor-grid { grid-template-columns: 1fr; gap: 3rem; }
}
@media (max-width: 720px) {
  .profile-stats { grid-template-columns: 1fr; }
  .profile-card { padding: 1.75rem 1.5rem; }
}
</style>
