---
/**
 * PressWall — basında biz son 4 haber
 * press koleksiyonundan canlı verilerle, kapak görselli ve kategori rozetli
 */
import { getCollection } from 'astro:content';
import { getLocale, formatDate, localizedUrl } from '../../lib/i18n';
const locale = getLocale(Astro.url.pathname);

const all = await getCollection('press', (p) => p.data.lang === locale);
const fallback = all.length === 0
  ? await getCollection('press', (p) => p.data.lang === 'tr')
  : all;
const items = fallback
  .map((p) => p.data)
  .sort((a, b) => +b.date - +a.date)
  .slice(0, 4);

const t = locale === 'tr' ? {
  marker: 'Basında Biz · In the Press',
  h2a: 'Sanica\'dan ',
  h2em: 'son haberler',
  h2b: '.',
  allLink: 'Tüm haberler',
  allHref: '/basinda-biz',
  read: 'Oku',
  catLabel: {
    'bizden-haberler': 'Bizden Haberler',
    'sosyal-sorumluluk': 'Sosyal Sorumluluk',
    'halka-arz': 'Halka Arz',
  } as const,
} : {
  marker: 'In the Press · Basında Biz',
  h2a: 'Latest news ',
  h2em: 'from Sanica',
  h2b: '.',
  allLink: 'All news',
  allHref: '/en/press',
  read: 'Read',
  catLabel: {
    'bizden-haberler': 'Our News',
    'sosyal-sorumluluk': 'Social Responsibility',
    'halka-arz': 'IPO',
  } as const,
};

const detailHref = (slug: string) => localizedUrl(locale, `${locale === 'tr' ? '/basinda-biz' : '/press'}/${slug}`);
---

<section class="press">
  <div class="container">

    <div class="press-head">
      <div>
        <div class="section-marker">
          <span class="num">08</span><span class="of">/</span><span>09</span><span class="dash">—</span><span class="label">{t.marker}</span>
        </div>
        <h2>{t.h2a}<em>{t.h2em}</em>{t.h2b}</h2>
      </div>
      <a href={t.allHref} class="link-arrow" style="font-size:1rem;">{t.allLink} <span class="arrow" aria-hidden="true">→</span></a>
    </div>

    {items.length > 0 ? (
      <div class="press-grid">
        {items.map((item) => (
          <a class="press-card" href={detailHref(item.slug)}>
            <div class="press-cover">
              {item.heroImage ? (
                <img src={item.heroImage} alt={item.heroImageAlt ?? item.title} loading="lazy" />
              ) : (
                <div class="cover-fallback" aria-hidden="true"><span>S</span></div>
              )}
              <span class:list={['cat-pill', item.category]}>{t.catLabel[item.category]}</span>
            </div>
            <div class="press-date">{formatDate(item.date, locale)}</div>
            <h3>{item.title}</h3>
            <span class="press-link">{t.read} <span class="arrow" aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    ) : null}
  </div>
</section>

<style>
.press {
  background: var(--paper);
  padding: var(--section-y) 0;
}
.press-head {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 2rem;
  margin-bottom: 3rem;
  flex-wrap: wrap;
}
.press-head h2 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 96, "SOFT" 65, "wght" 420;
  font-size: clamp(1.875rem, 3.6vw, 2.75rem);
  line-height: 1.05;
  letter-spacing: -0.022em;
  color: var(--ink);
  margin-top: 1rem;
}
.press-head h2 em {
  font-style: italic;
  color: var(--terracotta);
  font-variation-settings: "opsz" 96, "SOFT" 100, "wght" 380;
}

.press-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.25rem;
}
.press-card {
  display: flex;
  flex-direction: column;
  background: var(--paper);
  border: 1px solid var(--line);
  overflow: hidden;
  color: inherit;
  transition: all var(--t-med) var(--ease);
}
.press-card:hover {
  border-color: var(--ink);
  transform: translateY(-3px);
  box-shadow: 0 14px 32px -14px rgba(10,10,10,0.18);
}

.press-cover {
  position: relative;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  background: var(--sand);
}
.press-cover img {
  width: 100%; height: 100%;
  display: block;
  object-fit: cover;
  transition: transform 600ms var(--ease-out);
}
.press-card:hover .press-cover img { transform: scale(1.04); }
.cover-fallback {
  width: 100%; height: 100%;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, var(--sand), var(--sand-deep));
}
.cover-fallback span {
  font-family: var(--serif);
  font-variation-settings: "opsz" 144, "SOFT" 60, "wght" 420;
  font-size: 3.25rem;
  color: var(--terracotta);
  letter-spacing: -0.04em;
  opacity: 0.5;
}

.cat-pill {
  position: absolute;
  top: 0.75rem;
  left: 0.75rem;
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  font-weight: 600;
  padding: 0.3125rem 0.625rem;
  background: var(--paper);
  color: var(--ink);
  border-radius: 2px;
}
.cat-pill.bizden-haberler { color: var(--terracotta); }
.cat-pill.sosyal-sorumluluk { color: var(--success); background: var(--success-soft); }
.cat-pill.halka-arz { color: var(--bist-navy); background: var(--bist-navy-soft); }

.press-date {
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--muted);
  padding: 1.125rem 1.125rem 0.625rem;
}
.press-card h3 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 36, "SOFT" 55, "wght" 470;
  font-size: 1rem;
  font-weight: 470;
  line-height: 1.3;
  letter-spacing: -0.012em;
  color: var(--ink);
  padding: 0 1.125rem 1.25rem;
  flex-grow: 1;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.press-link {
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ink);
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0 1.125rem 1.25rem;
  transition: color var(--t-fast) var(--ease);
}
.press-card:hover .press-link { color: var(--terracotta); }
.press-link .arrow { transition: transform var(--t-med) var(--ease-out); }
.press-card:hover .press-link .arrow { transform: translateX(4px); }

@media (max-width: 980px) {
  .press-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 720px) {
  .press-grid { grid-template-columns: 1fr; }
}
</style>
