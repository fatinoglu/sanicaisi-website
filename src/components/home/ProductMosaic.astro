---
/**
 * ProductMosaic — Aurora featured (büyük) + 3 mini (Panel/Kombi/Boru)
 * Asimetrik dergi yerleşimi
 */
import { getLocale } from '../../lib/i18n';
const locale = getLocale(Astro.url.pathname);

const t = locale === 'tr' ? {
  marker: 'Ürünler / Products',
  h2a: '40 yıllık bilgi,',
  h2em: 'dört ürün',
  h2b: ' ailesinde.',
  legend: 'Panel radyatör\nTasarım radyatör · havlupan\nYoğuşmalı kombi\nÇok katmanlı ısıtma boruları',
  featureCorner: 'Bu sezon · Yeni',
  featureCornerRight: 'S-HV / Aurora · 2026',
  featureMeta: 'Bu sezon · Aurora Serisi Havlupan',
  featureH3a: 'Banyonun ',
  featureH3em: 'sıcak iskeleti',
  featureH3b: '.',
  featureP: 'İnce profilli paslanmaz çelik gövde, 9 renk seçeneği. Mimari projeler için ısrarla "tasarım" diyenlere.',
  featureCta1: 'Aurora\'yı incele',
  featureCta2: 'Tüm havlupanlar',
  ctaSuffix: 'Keşfet',
  mini: [
    { meta: '01 · Klasik', name: 'Panel Radyatör', tag: 'Türkiye\'nin standart radyatörü.', href: '/urunler/panel-radyator' },
    { meta: '03 · Kombi', name: 'Yoğuşmalı Kombi', tag: 'Sessiz, ekonomik, güvenli motor.', href: '/urunler/kombi' },
    { meta: '04 · Tesisat', name: 'PEX-AL-PEX Boru', tag: 'Beş katmanlı, oksijen geçirmez.', href: '/urunler/boru' },
  ],
  featureHref: '/urunler/havlupan/aurora',
  allHref: '/urunler/havlupan',
} : {
  marker: 'Products / Ürünler',
  h2a: '40 years of knowledge,',
  h2em: 'four product',
  h2b: ' families.',
  legend: 'Panel radiator\nDesigner radiator · towel warmer\nCondensing boiler\nMulti-layer heating pipes',
  featureCorner: 'This season · New',
  featureCornerRight: 'S-HV / Aurora · 2026',
  featureMeta: 'This season · Aurora Series Towel Warmer',
  featureH3a: 'The bathroom\'s ',
  featureH3em: 'warm skeleton',
  featureH3b: '.',
  featureP: 'Thin-profile stainless steel body, 9 color options. For architects who insist on "design".',
  featureCta1: 'Explore Aurora',
  featureCta2: 'All towel warmers',
  ctaSuffix: 'Discover',
  mini: [
    { meta: '01 · Classic', name: 'Panel Radiator', tag: 'Türkiye\'s standard radiator.', href: '/en/products/panel-radiator' },
    { meta: '03 · Boiler', name: 'Condensing Boiler', tag: 'Quiet, economical, safe motor.', href: '/en/products/boiler' },
    { meta: '04 · Plumbing', name: 'PEX-AL-PEX Pipe', tag: 'Five layers, oxygen-impermeable.', href: '/en/products/pipe' },
  ],
  featureHref: '/en/products/towel-warmer/aurora',
  allHref: '/en/products/towel-warmer',
};

const legendLines = t.legend.split('\n');
---

<section class="products">
  <div class="container">

    <div class="products-head">
      <div>
        <div class="section-marker" style="margin-bottom: 1.25rem;">
          <span class="num">03</span><span class="of">/</span><span>06</span><span class="dash">—</span><span class="label">{t.marker}</span>
        </div>
        <h2>{t.h2a}<br><em>{t.h2em}</em>{t.h2b}</h2>
      </div>
      <div class="right">
        {legendLines.map((line, i) => (
          <>{line}{i < legendLines.length - 1 && <br />}</>
        ))}
      </div>
    </div>

    <div class="mosaic">

      <!-- Big feature -->
      <article class="feature-card">
        <div class="feature-corner"><span class="dot">●</span> {t.featureCorner}</div>
        <div class="feature-corner-right">{t.featureCornerRight}</div>
        <div class="feature-illu">
          <svg viewBox="0 0 320 480" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Aurora Series Towel Warmer">
            <defs>
              <linearGradient id="aurora-bg" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#FBE6D8" />
                <stop offset="100%" stop-color="#D9521C" stop-opacity="0.3" />
              </linearGradient>
            </defs>
            <rect x="40" y="40" width="240" height="400" fill="url(#aurora-bg)" />
            <rect x="100" y="80" width="4" height="320" fill="#0A0A0A" />
            <rect x="216" y="80" width="4" height="320" fill="#0A0A0A" />
            <g fill="#0A0A0A">
              {[92,112,132,152,172,192,212,232,252,272,292,312,332,352,372].map((y) => (
                <rect x="104" y={y} width="112" height="3" />
              ))}
            </g>
            <rect x="76" y="120" width="24" height="4" fill="#6B6258" />
            <rect x="76" y="360" width="24" height="4" fill="#6B6258" />
            <circle cx="160" cy="420" r="4" fill="#B8390C" />
            <g stroke="#0A0A0A" stroke-width="0.5" opacity="0.4">
              <line x1="60" y1="80" x2="60" y2="400" />
              <line x1="56" y1="80" x2="64" y2="80" />
              <line x1="56" y1="400" x2="64" y2="400" />
            </g>
            <text x="40" y="244" font-family="IBM Plex Mono" font-size="8" fill="#0A0A0A" opacity="0.5" letter-spacing="1" transform="rotate(-90, 40, 244)">1500 mm</text>
          </svg>
        </div>
        <div class="feature-body">
          <div class="meta">{t.featureMeta}</div>
          <h3>{t.featureH3a}<em>{t.featureH3em}</em>{t.featureH3b}</h3>
          <p>{t.featureP}</p>
          <div class="btn-row">
            <a href={t.featureHref} class="btn btn-primary">{t.featureCta1} <span class="arrow" aria-hidden="true">→</span></a>
            <a href={t.allHref} class="link-arrow" style="color: rgba(247,244,238,0.85);">{t.featureCta2} <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </div>
      </article>

      <!-- Side stack -->
      <div class="mosaic-side">

        <!-- Mini 1: Panel Radyatör -->
        <a href={t.mini[0].href} class="mini-card">
          <div class="mini-illu">
            <svg viewBox="0 0 90 90" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect width="90" height="90" fill="#EDE5D3" />
              <rect x="14" y="22" width="62" height="3" fill="#0A0A0A" />
              <g fill="#0A0A0A">
                {[17,23,29,35,41,47,53,59,65,71].map((x) => (
                  <rect x={x} y="25" width="2" height="42" />
                ))}
              </g>
              <rect x="14" y="67" width="62" height="3" fill="#0A0A0A" />
              <line x1="14" y1="80" x2="76" y2="80" stroke="#B8390C" stroke-width="0.4" />
              <line x1="14" y1="78" x2="14" y2="82" stroke="#B8390C" stroke-width="0.4" />
              <line x1="76" y1="78" x2="76" y2="82" stroke="#B8390C" stroke-width="0.4" />
            </svg>
          </div>
          <div>
            <div class="mini-meta">{t.mini[0].meta}</div>
            <h4>{t.mini[0].name}</h4>
            <div class="mini-tag">{t.mini[0].tag}</div>
            <span class="mini-link">{t.ctaSuffix} <span class="arrow" aria-hidden="true">→</span></span>
          </div>
        </a>

        <!-- Mini 2: Kombi -->
        <a href={t.mini[1].href} class="mini-card">
          <div class="mini-illu">
            <svg viewBox="0 0 90 90" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect width="90" height="90" fill="#F0E8D3" />
              <line x1="6" y1="14" x2="84" y2="14" stroke="#D9CFB8" stroke-width="0.5" />
              <rect x="26" y="18" width="38" height="50" rx="1.5" fill="#0A0A0A" />
              <rect x="32" y="24" width="26" height="10" fill="#F7F4EE" />
              <text x="36" y="32" font-family="IBM Plex Mono" font-size="6" fill="#0A0A0A" font-weight="600">72°</text>
              <circle cx="45" cy="46" r="7" fill="#B8390C" />
              <circle cx="45" cy="46" r="3" fill="#FBE6D8" />
              <rect x="33" y="68" width="2" height="14" fill="#0A0A0A" />
              <rect x="42" y="68" width="2" height="14" fill="#0A0A0A" />
              <rect x="51" y="68" width="2" height="14" fill="#0A0A0A" />
              <rect x="60" y="68" width="2" height="14" fill="#0A0A0A" />
            </svg>
          </div>
          <div>
            <div class="mini-meta">{t.mini[1].meta}</div>
            <h4>{t.mini[1].name}</h4>
            <div class="mini-tag">{t.mini[1].tag}</div>
            <span class="mini-link">{t.ctaSuffix} <span class="arrow" aria-hidden="true">→</span></span>
          </div>
        </a>

        <!-- Mini 3: Boru -->
        <a href={t.mini[2].href} class="mini-card">
          <div class="mini-illu">
            <svg viewBox="0 0 90 90" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect width="90" height="90" fill="#EDE5D3" />
              <circle cx="45" cy="45" r="34" fill="#0A0A0A" />
              <circle cx="45" cy="45" r="28" fill="#D9521C" />
              <circle cx="45" cy="45" r="22" fill="#B8B8B5" />
              <circle cx="45" cy="45" r="16" fill="#D9521C" />
              <circle cx="45" cy="45" r="10" fill="#0A0A0A" />
              <line x1="79" y1="45" x2="85" y2="45" stroke="#0A0A0A" stroke-width="0.6" />
              <text x="79" y="11" font-family="IBM Plex Mono" font-size="6" fill="#0A0A0A" letter-spacing="0.5" text-anchor="end">PEX</text>
              <text x="79" y="83" font-family="IBM Plex Mono" font-size="6" fill="#0A0A0A" letter-spacing="0.5" text-anchor="end">AL</text>
            </svg>
          </div>
          <div>
            <div class="mini-meta">{t.mini[2].meta}</div>
            <h4>{t.mini[2].name}</h4>
            <div class="mini-tag">{t.mini[2].tag}</div>
            <span class="mini-link">{t.ctaSuffix} <span class="arrow" aria-hidden="true">→</span></span>
          </div>
        </a>

      </div>
    </div>
  </div>
</section>

<style>
.products {
  background: var(--paper);
  padding: var(--section-y) 0;
}
.products-head {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 3rem;
  align-items: end;
  margin-bottom: 3rem;
}
.products-head h2 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 96, "SOFT" 65, "wght" 420;
  font-size: clamp(2rem, 4.2vw, 3.25rem);
  line-height: 1.05;
  letter-spacing: -0.022em;
  color: var(--ink);
  max-width: 760px;
  margin-top: 1.25rem;
}
.products-head h2 em {
  font-style: italic;
  font-variation-settings: "opsz" 96, "SOFT" 100, "wght" 380;
  color: var(--terracotta);
}
.products-head .right {
  text-align: right;
  font-family: var(--mono);
  font-size: 0.75rem;
  letter-spacing: 0.14em;
  color: var(--muted);
  text-transform: uppercase;
  line-height: 1.7;
  white-space: nowrap;
}

.mosaic {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 1.25rem;
}

.feature-card {
  background: var(--sand-deep);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  min-height: 620px;
  transition: transform var(--t-med) var(--ease);
}
.feature-card:hover { transform: translateY(-4px); }

.feature-illu {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 3rem;
}
.feature-illu svg { max-width: 280px; width: 100%; height: auto; }

.feature-corner {
  position: absolute;
  top: 1.5rem;
  left: 1.75rem;
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.18em;
  color: var(--terracotta);
  text-transform: uppercase;
  font-weight: 500;
}
.feature-corner .dot { color: var(--terracotta); }

.feature-corner-right {
  position: absolute;
  top: 1.5rem;
  right: 1.75rem;
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.18em;
  color: var(--muted);
  text-transform: uppercase;
}

.feature-body {
  padding: 2rem 2.25rem 2.25rem;
  background: var(--ink);
  color: var(--paper);
}
.feature-body .meta {
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--terracotta-warm);
  margin-bottom: 0.875rem;
}
.feature-body h3 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 96, "SOFT" 65, "wght" 480;
  font-size: clamp(1.75rem, 3vw, 2.375rem);
  line-height: 1.1;
  letter-spacing: -0.018em;
  color: var(--paper);
  margin-bottom: 0.75rem;
}
.feature-body h3 em {
  font-style: italic;
  color: var(--terracotta-warm);
}
.feature-body p {
  color: rgba(247, 244, 238, 0.7);
  font-size: 0.9375rem;
  line-height: 1.55;
  margin-bottom: 1.5rem;
  max-width: 460px;
}
.feature-body .btn-row {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
  align-items: center;
}

.btn {
  display: inline-flex;
  align-items: center;
  gap: 0.625rem;
  padding: 0.9375rem 1.375rem;
  font-size: 0.9375rem;
  font-weight: 500;
  border: 1px solid;
  border-radius: 2px;
  transition: all var(--t-med) var(--ease);
  white-space: nowrap;
}
.btn-primary {
  background: var(--terracotta);
  border-color: var(--terracotta);
  color: var(--paper);
}
.btn-primary:hover {
  background: var(--terracotta-warm);
  border-color: var(--terracotta-warm);
  transform: translateY(-2px);
  box-shadow: 0 12px 30px -10px rgba(184, 57, 12, 0.55);
}
.btn .arrow { transition: transform var(--t-med) var(--ease-out); }
.btn:hover .arrow { transform: translateX(3px); }

.mosaic-side {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}
.mini-card {
  background: var(--sand);
  padding: 1.5rem;
  display: grid;
  grid-template-columns: 90px 1fr;
  gap: 1.25rem;
  align-items: center;
  position: relative;
  transition: all var(--t-med) var(--ease);
  flex: 1;
  min-height: 0;
}
.mini-card:hover {
  background: var(--terracotta-soft);
  transform: translateY(-3px);
}
.mini-card .mini-illu {
  aspect-ratio: 1;
  background: var(--paper);
  overflow: hidden;
}
.mini-card .mini-illu svg { width: 100%; height: 100%; }
.mini-card .mini-meta {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 0.375rem;
}
.mini-card h4 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 36, "SOFT" 50, "wght" 500;
  font-size: 1.125rem;
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: -0.012em;
  color: var(--ink);
  margin-bottom: 0.25rem;
}
.mini-card .mini-tag {
  font-size: 0.8125rem;
  color: var(--muted);
  margin-bottom: 0.625rem;
  line-height: 1.4;
}
.mini-card .mini-link {
  font-family: var(--sans);
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--ink);
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
}
.mini-card .mini-link .arrow { transition: transform var(--t-fast) var(--ease); }
.mini-card:hover .mini-link .arrow { transform: translateX(3px); }

@media (max-width: 980px) {
  .mosaic { grid-template-columns: 1fr; }
  .feature-card { min-height: 480px; }
}
@media (max-width: 720px) {
  .products-head { grid-template-columns: 1fr; }
  .products-head .right { text-align: left; }
  .mini-card { grid-template-columns: 70px 1fr; gap: 1rem; padding: 1.25rem; }
}
</style>
