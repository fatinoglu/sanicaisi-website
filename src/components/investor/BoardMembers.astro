---
/**
 * BoardMembers — Yönetim Kurulu üyeleri (özgeçmiş kartları)
 * Canlı WP /yatirimci-iliskileri/kurumsal-yonetim/yonetim-kurulu içeriğinden port
 */
import { getLocale } from '../../lib/i18n';
const locale = getLocale(Astro.url.pathname);

const t = locale === 'tr' ? {
  marker: '01 — Yönetim Kurulu',
  h2a: 'Aile şirketinin',
  h2em: 'üçüncü nesil yönetimi',
  h2b: '.',
  intro: 'Kurucu ortaklar ve ikinci nesil aile bireyleriyle birlikte iki bağımsız üyenin görev aldığı 6 kişilik yönetim kurulu.',
  bornLbl: 'Doğum',
  members: [
    {
      name: 'Hüseyin Nesimi Fatinoğlu',
      role: 'Yönetim Kurulu Başkanı',
      tag: 'Kurucu',
      born: '20.04.1954 · Ankara',
      bio: 'Mimar Sinan Üniversitesi Mimarlık mezunu. İş hayatına 1970\'lerde İstanbul Aksaray\'da oto yedek parça dükkanıyla başladı; vatka üretimi, ambalaj üretimi ve deniz taşımacılığı sektörlerinde faaliyet gösterdi. 1985-1987 Bemsey-Titiz Tekstil Fabrika Müdürlüğü ardından kardeşi Ali Fatinoğlu ile 1987\'de Pano Seramik\'i kurarak Sanica\'nın temellerini attı. Şirketi küçük bir atölyeden dev bir sanayi işletmesine taşıyan kurucu, hâlen Yönetim Kurulu Başkanlığı görevini sürdürüyor.',
    },
    {
      name: 'Ali Fatinoğlu',
      role: 'Yönetim Kurulu Başkan Vekili',
      tag: 'Kurucu',
      born: '11.09.1962 · İstanbul',
      bio: 'Marmara Üniversitesi İİBF İşletme mezunu, İstanbul Üniversitesi\'nde İşletme Yüksek Lisansı. Cumhuriyet Gazetesi spor muhabirliğiyle başlayan kariyerinde Türkiye Anadolu Bankası Mali Tahlil Uzman Yardımcılığı (1986-87), İBB İştirakler Grup Müdürlüğü (1988-90), Ulusoy Holding Denetim ve Değerlendirme Grup Müdürlüğü (1992-93) görevlerinde bulundu. Ağabeyi Hüseyin Nesimi Fatinoğlu ile 1987\'de Pano Seramik\'i kurarak Sanica\'nın eş kurucusu oldu.',
    },
    {
      name: 'Uğur Fatinoğlu',
      role: 'Yönetim Kurulu Üyesi · Alt Yapı, Üst Yapı ve Tarımsal Boru Grup Başkanı',
      tag: 'İcra',
      born: '03.10.1980 · İstanbul',
      bio: 'Beykent Üniversitesi Mimarlık mezunu, aynı üniversitede İşletme Yüksek Lisansı. ABD San Diego Üniversitesi\'nde 1 yıl dil eğitimi aldı. Fatinoğlu Grubu şirketlerinde çeşitli görevlerden sonra şu anda Sanica Isı\'da Satış ve Pazarlama Organizasyonları Genel Müdürü ve Yönetim Kurulu Üyesi olarak görev yapıyor.',
    },
    {
      name: 'Emre Fatinoğlu',
      role: 'Yönetim Kurulu Üyesi · Kombi ve Radyatör Grup Başkanı',
      tag: 'İcra',
      born: '20.05.1987 · İstanbul',
      bio: 'Philadelphia Drexel Üniversitesi Pazarlama mezunu. Mezuniyetinden hemen sonra Fatinoğlu Grubu şirketlerinde göreve başladı; bugün Sanica Isı\'da Üretim ve Yönetim Organizasyonları Genel Müdürü ve Yönetim Kurulu Üyesi olarak görev yapıyor.',
    },
    {
      name: 'M. Kağan Turan',
      role: 'Bağımsız Yönetim Kurulu Üyesi',
      tag: 'Bağımsız',
      born: '02.10.1975 · Sivas',
      bio: 'Yıldız Teknik Üniversitesi Makine Mühendisliği (2000) mezunu. Isıtma sektöründe 20+ yıl üst düzey yönetici deneyimi: Vaillant Türkiye (2001-2005), Immergas Türkiye (2005-2011), Warmhaus Genel Müdürü (2014-2022). Bugün kurucusu olduğu Hecta Mekanik şirketini yönetiyor.',
    },
    {
      name: 'Tolgahan Üreş',
      role: 'Bağımsız Yönetim Kurulu Üyesi',
      tag: 'Bağımsız',
      born: '25.08.1986 · İstanbul',
      bio: 'Bahçeşehir Üniversitesi Uluslararası İlişkiler (2010) mezunu. 2010\'dan itibaren finans ve mali işler alanında uzmanlaşan Üreş, hâlen Uğur Mali Danışmanlık firmasında Finansal Danışmanlık görevini sürdürüyor.',
    },
  ],
} : {
  marker: '01 — Board of Directors',
  h2a: 'Third-generation leadership',
  h2em: 'of a family business',
  h2b: '.',
  intro: 'A six-member board comprising the founding brothers, second-generation family members and two independent directors.',
  bornLbl: 'Born',
  members: [
    { name: 'Hüseyin Nesimi Fatinoğlu', role: 'Chairman of the Board', tag: 'Founder', born: 'April 20, 1954 · Ankara', bio: 'Architecture graduate of Mimar Sinan University. Started in business in 1970s with an auto parts shop in Aksaray, İstanbul; later worked in wadding, packaging and maritime shipping. After serving as plant manager at Bemsey-Titiz Textile (1985-1987), co-founded Pano Seramik with his brother Ali in 1987 — the seed of Sanica. Continues as Chairman today.' },
    { name: 'Ali Fatinoğlu', role: 'Vice Chairman of the Board', tag: 'Founder', born: 'September 11, 1962 · İstanbul', bio: 'BA in Business, Marmara University; MA in Business, İstanbul University. Career began at Cumhuriyet Gazetesi as a sports reporter; held positions at Türkiye Anadolu Bank, İBB Affiliates Group Management, Ulusoy Holding Audit Group Management. Co-founded Pano Seramik with his brother in 1987.' },
    { name: 'Uğur Fatinoğlu', role: 'Board Member · Infrastructure, Superstructure & Agricultural Pipe Group President', tag: 'Executive', born: 'October 3, 1980 · İstanbul', bio: 'Architecture graduate of Beykent University with an MBA from the same university. Spent a year of language study at San Diego University, USA. Currently serves as Sanica Isı\'s GM of Sales & Marketing Organizations and a Board Member.' },
    { name: 'Emre Fatinoğlu', role: 'Board Member · Boiler & Radiator Group President', tag: 'Executive', born: 'May 20, 1987 · İstanbul', bio: 'Marketing graduate of Drexel University, Philadelphia. Joined Fatinoğlu Group right after graduation; today serves as Sanica Isı\'s GM of Production & Management Organizations and a Board Member.' },
    { name: 'M. Kağan Turan', role: 'Independent Board Member', tag: 'Independent', born: 'October 2, 1975 · Sivas', bio: 'Mechanical Engineering graduate of Yıldız Technical University (2000). 20+ years of senior management in the heating sector: Vaillant Türkiye (2001-2005), Immergas Türkiye (2005-2011), Warmhaus GM (2014-2022). Today leads Hecta Mekanik, which he founded.' },
    { name: 'Tolgahan Üreş', role: 'Independent Board Member', tag: 'Independent', born: 'August 25, 1986 · İstanbul', bio: 'International Relations graduate of Bahçeşehir University (2010). Specialised in finance and treasury since 2010; currently Financial Advisor at Uğur Mali Danışmanlık.' },
  ],
};
---

<section class="board">
  <div class="container">
    <div class="head">
      <div>
        <span class="marker">{t.marker}</span>
        <h2>{t.h2a} <em>{t.h2em}</em>{t.h2b}</h2>
      </div>
      <p class="intro">{t.intro}</p>
    </div>

    <div class="members">
      {t.members.map((m, i) => (
        <article class="member">
          <div class="left">
            <span class="num">0{i + 1}</span>
            <span class:list={['tag', m.tag.toLowerCase().replace(/[^a-z]/g, '')]}>{m.tag}</span>
          </div>
          <div class="body">
            <h3>{m.name}</h3>
            <span class="role">{m.role}</span>
            <span class="born">{t.bornLbl} · {m.born}</span>
            <p>{m.bio}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.board { background: var(--paper); padding: clamp(3rem, 6vw, 5rem) 0; }

.head {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 4rem;
  align-items: end;
  margin-bottom: 3rem;
}
.marker {
  font-family: var(--mono);
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--bist-navy);
  display: inline-block;
  margin-bottom: 1rem;
}
.head h2 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 96, "SOFT" 65, "wght" 420;
  font-size: clamp(1.75rem, 3.2vw, 2.5rem);
  line-height: 1.1;
  letter-spacing: -0.022em;
  color: var(--ink);
  max-width: 520px;
}
.head h2 em {
  font-style: italic;
  font-variation-settings: "opsz" 96, "SOFT" 100, "wght" 380;
  color: var(--bist-navy);
}
.head .intro {
  font-size: 1rem;
  line-height: 1.6;
  color: var(--muted);
  max-width: 460px;
}

.members { display: grid; gap: 1rem; }
.member {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 1.75rem;
  background: var(--paper-soft);
  border: 1px solid var(--line);
  border-left: 3px solid var(--bist-navy);
  padding: 1.875rem;
  transition: border-color var(--t-fast) var(--ease);
}
.member:hover { border-color: var(--bist-navy); }

.left { display: flex; flex-direction: column; gap: 0.875rem; }
.num {
  font-family: var(--serif);
  font-variation-settings: "opsz" 144, "SOFT" 60, "wght" 380, "ital" 1;
  font-style: italic;
  font-size: 3rem;
  line-height: 1;
  color: var(--bist-navy);
  font-variant-numeric: tabular-nums;
}
.tag {
  font-family: var(--mono);
  font-size: 0.625rem;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  padding: 0.25rem 0.625rem;
  background: var(--paper);
  color: var(--ink);
  border-radius: 2px;
  align-self: flex-start;
}
.tag.kurucu, .tag.founder { color: var(--terracotta); background: var(--terracotta-soft); }
.tag.icra, .tag.executive { color: var(--ink); }
.tag.bağımsız, .tag.bagmsz, .tag.independent { color: var(--success); background: var(--success-soft); }

.body { display: flex; flex-direction: column; gap: 0.375rem; }
.body h3 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 36, "SOFT" 55, "wght" 500;
  font-size: 1.375rem;
  letter-spacing: -0.018em;
  color: var(--ink);
}
.role {
  font-size: 0.9375rem;
  font-weight: 500;
  color: var(--bist-navy);
}
.born {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
}
.body p {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: var(--text);
  margin-top: 0.5rem;
}

@media (max-width: 980px) {
  .head { grid-template-columns: 1fr; gap: 1.5rem; }
}
@media (max-width: 640px) {
  .member { grid-template-columns: 1fr; gap: 0.75rem; padding: 1.25rem; }
  .left { flex-direction: row; align-items: center; gap: 1rem; }
  .num { font-size: 2rem; }
}
</style>
