---
/**
 * LiveDataBand — full dark, massive price display + 8 metrik grid + ISIN kartı
 * Fiyat verisi şimdilik stub, Faz 7'de stock-cache.json'dan beslenir
 */
import { getLocale } from '../../lib/i18n';
const locale = getLocale(Astro.url.pathname);

const t = locale === 'tr' ? {
  liveLbl: 'BIST · CANLI',
  date: '22 Mayıs 2026 · 14:32',
  delay: 'Gecikme: 15 dk',
  changeLbl: 'Günlük Değişim',
  metaGrid: [
    { lbl: 'Açılış', val: '₺24,50' },
    { lbl: 'Önceki Kapanış', val: '₺24,50' },
    { lbl: 'Yüksek', val: '₺24,92' },
    { lbl: 'Düşük', val: '₺24,38' },
    { lbl: 'Hacim (lot)', val: '1.214.800' },
    { lbl: 'İşlem Tutarı', val: '₺30,12 M' },
    { lbl: 'Piyasa Değeri', val: '₺992 M' },
    { lbl: 'F/K Oranı', val: '8,42' },
  ],
  cardH3: 'SNICA · Yıldız Pazar',
  cardRows: [
    { k: 'ISIN', v: 'TRESNCAW91D8' },
    { k: 'Endeks', v: 'BIST Sanayi' },
    { k: 'Sektör', v: 'Metal Eşya / Makine' },
    { k: 'Halka Açıklık', v: '%30,00' },
    { k: 'Ödenmiş Sermaye', v: '₺40.000.000' },
    { k: 'Pay Sayısı', v: '40.000.000' },
    { k: 'İşlem Başlangıcı', v: '24 · 11 · 2022' },
    { k: 'Bağımsız Denetçi', v: 'PwC Türkiye' },
  ],
} : {
  liveLbl: 'BIST · LIVE',
  date: 'May 22, 2026 · 14:32',
  delay: 'Delay: 15 min',
  changeLbl: 'Daily Change',
  metaGrid: [
    { lbl: 'Open', val: '₺24.50' },
    { lbl: 'Prev. Close', val: '₺24.50' },
    { lbl: 'High', val: '₺24.92' },
    { lbl: 'Low', val: '₺24.38' },
    { lbl: 'Volume (lots)', val: '1,214,800' },
    { lbl: 'Turnover', val: '₺30.12 M' },
    { lbl: 'Market Cap', val: '₺992 M' },
    { lbl: 'P/E Ratio', val: '8.42' },
  ],
  cardH3: 'SNICA · Star Market',
  cardRows: [
    { k: 'ISIN', v: 'TRESNCAW91D8' },
    { k: 'Index', v: 'BIST Industrial' },
    { k: 'Sector', v: 'Metalware / Machinery' },
    { k: 'Free Float', v: '30.00%' },
    { k: 'Paid Capital', v: '₺40,000,000' },
    { k: 'Share Count', v: '40,000,000' },
    { k: 'Listing Date', v: '24 · 11 · 2022' },
    { k: 'Auditor', v: 'PwC Türkiye' },
  ],
};
---

<section class="live-band dark">
  <div class="container">
    <div class="live-grid">

      <div>
        <div class="live-meta">
          <span class="live-dot" aria-hidden="true"></span>
          <span>{t.liveLbl}</span>
          <span class="dim">·</span>
          <span>{t.date}</span>
          <span class="dim">·</span>
          <span>{t.delay}</span>
        </div>

        <div class="price-display">
          <div class="amount"><span class="cur">₺</span>24,80</div>
          <div class="change-box">
            <span class="change"><span class="arrow-up">▲</span> +0,30 (+%1,24)</span>
            <span class="label">{t.changeLbl}</span>
          </div>
        </div>

        <div class="price-meta-grid">
          {t.metaGrid.map((m) => (
            <div class="price-meta-item">
              <span class="lbl">{m.lbl}</span>
              <span class="val">{m.val}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="live-info-card">
        <h3>{t.cardH3}</h3>
        <div class="live-info-list">
          {t.cardRows.map((row) => (
            <div class="live-info-row"><span class="k">{row.k}</span><span class="v">{row.v}</span></div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
.live-band {
  background: var(--ink);
  color: var(--paper);
  position: relative;
  overflow: hidden;
  padding: clamp(2.5rem, 5vw, 3.75rem) 0;
}
.live-band::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 60% 50% at 25% 50%, rgba(184,57,12,0.1) 0%, transparent 55%),
    radial-gradient(ellipse 50% 60% at 80% 30%, rgba(90,182,112,0.06) 0%, transparent 55%);
  pointer-events: none;
}
.live-grid {
  position: relative;
  display: grid;
  grid-template-columns: 1.6fr 1fr;
  gap: clamp(2rem, 5vw, 4rem);
  align-items: stretch;
}

.live-meta {
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(247, 244, 238, 0.55);
  display: flex;
  align-items: center;
  gap: 0.625rem;
  margin-bottom: 1.5rem;
  flex-wrap: wrap;
}
.live-meta .dim { color: rgba(247, 244, 238, 0.3); }
.live-dot {
  width: 8px;
  height: 8px;
  background: var(--up);
  border-radius: 50%;
  position: relative;
}
.live-dot::after {
  content: '';
  position: absolute;
  inset: -4px;
  background: var(--up);
  border-radius: 50%;
  opacity: 0.3;
  animation: pulse 2s ease-out infinite;
}
@keyframes pulse {
  0% { transform: scale(0.6); opacity: 0.4; }
  100% { transform: scale(2.6); opacity: 0; }
}

.price-display {
  display: flex;
  align-items: baseline;
  gap: 1.5rem;
  flex-wrap: wrap;
  margin-bottom: 1.25rem;
}
.price-display .amount {
  font-family: var(--serif);
  font-variation-settings: "opsz" 144, "SOFT" 60, "wght" 400;
  font-size: clamp(4rem, 8vw, 7rem);
  line-height: 0.95;
  color: var(--paper);
  letter-spacing: -0.03em;
  font-variant-numeric: tabular-nums;
}
.price-display .amount .cur { font-size: 0.45em; color: rgba(247, 244, 238, 0.55); margin-right: 0.125em; }
.price-display .change-box { display: flex; flex-direction: column; gap: 0.375rem; }
.price-display .change {
  font-family: var(--mono);
  font-size: 1.125rem;
  font-weight: 500;
  color: var(--up);
  font-variant-numeric: tabular-nums;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
}
.price-display .change .arrow-up { font-size: 0.875em; }
.price-display .label {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(247, 244, 238, 0.4);
}

.price-meta-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(247, 244, 238, 0.1);
}
.price-meta-item .lbl {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(247, 244, 238, 0.5);
  margin-bottom: 0.375rem;
  display: block;
}
.price-meta-item .val {
  font-family: var(--mono);
  font-size: 1rem;
  font-weight: 500;
  color: var(--paper);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.01em;
}

.live-info-card {
  background: rgba(247, 244, 238, 0.04);
  border: 1px solid rgba(247, 244, 238, 0.1);
  padding: 1.75rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}
.live-info-card h3 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 36, "SOFT" 50, "wght" 480;
  font-size: 1.25rem;
  line-height: 1.25;
  color: var(--paper);
}
.live-info-list { display: flex; flex-direction: column; gap: 0.875rem; }
.live-info-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-family: var(--mono);
  font-size: 0.8125rem;
  font-variant-numeric: tabular-nums;
  padding-bottom: 0.625rem;
  border-bottom: 1px dotted rgba(247, 244, 238, 0.12);
}
.live-info-row:last-child { border-bottom: none; padding-bottom: 0; }
.live-info-row .k {
  color: rgba(247, 244, 238, 0.55);
  letter-spacing: 0.04em;
  text-transform: uppercase;
  font-size: 0.6875rem;
}
.live-info-row .v {
  color: var(--paper);
  font-weight: 500;
  letter-spacing: 0.02em;
}

@media (max-width: 980px) {
  .live-grid { grid-template-columns: 1fr; }
  .price-meta-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 720px) {
  .price-meta-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 480px) {
  .price-meta-grid { grid-template-columns: 1fr; }
}
</style>
