---
/**
 * LiveDataBand — full dark, statik kurumsal künye + canlı fiyat için KAP yönlendirmesi.
 *
 * Faz 7'de stock-cache.json beslemesi devreye girene kadar SAHTE fiyat
 * gösterilmiyor. Sol blokta dürüst placeholder + KAP linki, sağ blokta
 * statik (ve gerçek) kurumsal künye var.
 */
import { getLocale } from '../../lib/i18n';
const locale = getLocale(Astro.url.pathname);

const t = locale === 'tr' ? {
  ribbon: 'BIST · SNICA · Yıldız Pazar',
  headline: 'Canlı fiyat verisi',
  headlineEm: 'KAP üzerinden',
  headlineTail: 'takip ediliyor.',
  body: 'Anlık fiyat, hacim ve seans verileri için resmi kaynak olan Kamuyu Aydınlatma Platformu\'nu (KAP) kullanın. Web sitemizdeki canlı veri beslemesi yakında devreye alınacaktır.',
  ctaKap: 'KAP · SNICA sayfası',
  ctaKapHint: 'kap.org.tr',
  cardH3: 'SNICA · Yıldız Pazar',
  cardRows: [
    { k: 'ISIN', v: 'TRESNCAW91D8' },
    { k: 'Endeks', v: 'BIST Sanayi' },
    { k: 'Sektör', v: 'Metal Eşya / Makine' },
    { k: 'Halka Açıklık', v: '%30,00' },
    { k: 'Ödenmiş Sermaye', v: '₺40.000.000' },
    { k: 'Pay Sayısı', v: '40.000.000' },
    { k: 'İşlem Başlangıcı', v: '24 · 11 · 2022' },
    { k: 'Bağımsız Denetçi', v: 'PwC Türkiye' },
  ],
} : {
  ribbon: 'BIST · SNICA · Star Market',
  headline: 'Live price data',
  headlineEm: 'tracked via PDP',
  headlineTail: '(Public Disclosure Platform).',
  body: 'For real-time price, volume and session data, use the official Public Disclosure Platform (KAP). The on-site live feed will be enabled in Phase 7.',
  ctaKap: 'PDP · SNICA page',
  ctaKapHint: 'kap.org.tr',
  cardH3: 'SNICA · Star Market',
  cardRows: [
    { k: 'ISIN', v: 'TRESNCAW91D8' },
    { k: 'Index', v: 'BIST Industrial' },
    { k: 'Sector', v: 'Metalware / Machinery' },
    { k: 'Free Float', v: '30.00%' },
    { k: 'Paid Capital', v: '₺40,000,000' },
    { k: 'Share Count', v: '40,000,000' },
    { k: 'Listing Date', v: '24 · 11 · 2022' },
    { k: 'Auditor', v: 'PwC Türkiye' },
  ],
};

const kapUrl = 'https://www.kap.org.tr/';
---

<section class="live-band dark">
  <div class="container">
    <div class="live-grid">

      <div class="live-main">
        <div class="ribbon">
          <span class="ribbon-tag">{t.ribbon}</span>
        </div>

        <h2 class="live-headline">
          {t.headline} <em>{t.headlineEm}</em> {t.headlineTail}
        </h2>

        <p class="live-body">{t.body}</p>

        <div class="live-ctas">
          <a class="cta-primary" href={kapUrl} target="_blank" rel="noopener">
            <span class="cta-label">{t.ctaKap}</span>
            <span class="cta-hint">{t.ctaKapHint} <span class="arrow" aria-hidden="true">↗</span></span>
          </a>
        </div>
      </div>

      <div class="live-info-card">
        <h3>{t.cardH3}</h3>
        <div class="live-info-list">
          {t.cardRows.map((row) => (
            <div class="live-info-row"><span class="k">{row.k}</span><span class="v">{row.v}</span></div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
.live-band {
  background: var(--ink);
  color: var(--paper);
  position: relative;
  overflow: hidden;
  padding: clamp(2.5rem, 5vw, 3.75rem) 0;
}
.live-band::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 60% 50% at 25% 50%, rgba(184,57,12,0.1) 0%, transparent 55%),
    radial-gradient(ellipse 50% 60% at 80% 30%, rgba(90,182,112,0.06) 0%, transparent 55%);
  pointer-events: none;
}
.live-grid {
  position: relative;
  display: grid;
  grid-template-columns: 1.6fr 1fr;
  gap: clamp(2rem, 5vw, 4rem);
  align-items: stretch;
}

.live-main { display: flex; flex-direction: column; gap: 1.5rem; }

.ribbon {
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(247, 244, 238, 0.55);
}
.ribbon-tag {
  display: inline-block;
  padding: 0.375rem 0.75rem;
  border: 1px solid rgba(247, 244, 238, 0.18);
  border-radius: 2px;
}

.live-headline {
  font-family: var(--serif);
  font-variation-settings: "opsz" 144, "SOFT" 65, "wght" 420;
  font-size: clamp(2rem, 4vw, 3.25rem);
  line-height: 1.05;
  letter-spacing: -0.025em;
  color: var(--paper);
  max-width: 720px;
}
.live-headline em {
  font-style: italic;
  font-variation-settings: "opsz" 144, "SOFT" 100, "wght" 380;
  color: var(--terracotta-warm);
}

.live-body {
  font-size: clamp(0.9375rem, 1.1vw, 1.0625rem);
  line-height: 1.6;
  color: rgba(247, 244, 238, 0.72);
  max-width: 560px;
}

.live-ctas { display: flex; flex-wrap: wrap; gap: 0.875rem; margin-top: 0.5rem; }
.cta-primary {
  display: inline-flex;
  flex-direction: column;
  gap: 0.25rem;
  padding: 0.875rem 1.25rem;
  background: rgba(247, 244, 238, 0.06);
  border: 1px solid rgba(247, 244, 238, 0.14);
  transition: background var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
}
.cta-primary:hover { background: rgba(247, 244, 238, 0.1); border-color: rgba(247, 244, 238, 0.3); }
.cta-label {
  font-family: var(--sans);
  font-size: 0.9375rem;
  font-weight: 500;
  color: var(--paper);
  letter-spacing: 0.005em;
}
.cta-hint {
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(247, 244, 238, 0.5);
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
}
.cta-hint .arrow { color: var(--terracotta-warm); }

.live-info-card {
  background: rgba(247, 244, 238, 0.04);
  border: 1px solid rgba(247, 244, 238, 0.1);
  padding: 1.75rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}
.live-info-card h3 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 36, "SOFT" 50, "wght" 480;
  font-size: 1.25rem;
  line-height: 1.25;
  color: var(--paper);
}
.live-info-list { display: flex; flex-direction: column; gap: 0.875rem; }
.live-info-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-family: var(--mono);
  font-size: 0.8125rem;
  font-variant-numeric: tabular-nums;
  padding-bottom: 0.625rem;
  border-bottom: 1px dotted rgba(247, 244, 238, 0.12);
}
.live-info-row:last-child { border-bottom: none; padding-bottom: 0; }
.live-info-row .k {
  color: rgba(247, 244, 238, 0.55);
  letter-spacing: 0.04em;
  text-transform: uppercase;
  font-size: 0.6875rem;
}
.live-info-row .v {
  color: var(--paper);
  font-weight: 500;
  letter-spacing: 0.02em;
}

@media (max-width: 980px) {
  .live-grid { grid-template-columns: 1fr; }
}
</style>
