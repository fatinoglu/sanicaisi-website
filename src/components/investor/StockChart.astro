---
/**
 * StockChart — büyük SVG fiyat grafiği + zaman aralığı pill'leri + 52H stats
 */
import { getLocale } from '../../lib/i18n';
const locale = getLocale(Astro.url.pathname);

const t = locale === 'tr' ? {
  marker: 'Hisse Performansı',
  h2: 'SNICA',
  h2em: 'fiyat grafiği',
  h2post: '.',
  detail: 'Detaylı analize git',
  chartTag: 'BIST · SNICA · TRY',
  chartName: 'Kapanış Fiyatı · 1 Yıl',
  ranges: ['1G', '1H', '1A', '3A', '6A', '1Y', '5Y', 'MAX'],
  rangeActive: '1Y',
  axis: ['MAY 25', 'TEM', 'EYL', 'KAS', 'OCA 26', 'MAR', 'MAY 26'],
  chartStats: [
    { lbl: '52H Yüksek', val: '₺26,42', dir: 'up' },
    { lbl: '52H Düşük', val: '₺14,28', dir: 'down' },
    { lbl: '1Y Değişim', val: '+%48,2', dir: 'up' },
    { lbl: 'IPO\'dan Beri', val: '+%23,8', dir: 'up' },
    { lbl: 'Ort. Hacim (3A)', val: '1,08 M lot', dir: '' },
  ],
  ipoLabel: 'IPO ₺20,03',
} : {
  marker: 'Stock Performance',
  h2: 'SNICA',
  h2em: 'price chart',
  h2post: '.',
  detail: 'Go to detailed analysis',
  chartTag: 'BIST · SNICA · TRY',
  chartName: 'Closing Price · 1 Year',
  ranges: ['1D', '1W', '1M', '3M', '6M', '1Y', '5Y', 'MAX'],
  rangeActive: '1Y',
  axis: ['MAY 25', 'JUL', 'SEP', 'NOV', 'JAN 26', 'MAR', 'MAY 26'],
  chartStats: [
    { lbl: '52W High', val: '₺26.42', dir: 'up' },
    { lbl: '52W Low', val: '₺14.28', dir: 'down' },
    { lbl: '1Y Change', val: '+48.2%', dir: 'up' },
    { lbl: 'Since IPO', val: '+23.8%', dir: 'up' },
    { lbl: 'Avg. Vol (3M)', val: '1.08 M lots', dir: '' },
  ],
  ipoLabel: 'IPO ₺20.03',
};
---

<section class="chart-section" id="performance">
  <div class="container">

    <div class="sec-head">
      <div>
        <div class="section-marker" style="margin-bottom: 1rem;">
          <span class="num">02</span><span class="of">/</span><span>07</span><span class="dash">—</span><span class="label">{t.marker}</span>
        </div>
        <h2>{t.h2} <em>{t.h2em}</em>{t.h2post}</h2>
      </div>
      <a href="#" class="link-arrow">{t.detail} <span class="arrow" aria-hidden="true">→</span></a>
    </div>

    <div class="chart-card">
      <div class="chart-head">
        <div class="chart-title">
          <span class="tag">{t.chartTag}</span>
          <span class="name">{t.chartName}</span>
        </div>
        <div class="range-pills" role="group" aria-label={locale === 'tr' ? 'Zaman aralığı' : 'Time range'}>
          {t.ranges.map((r) => (
            <button class:list={[{ active: r === t.rangeActive }]}>{r}</button>
          ))}
        </div>
      </div>

      <div class="big-chart">
        <svg viewBox="0 0 1000 280" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="big-chart-fill" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#5AB670" stop-opacity="0.35" />
              <stop offset="100%" stop-color="#5AB670" stop-opacity="0" />
            </linearGradient>
          </defs>

          <g stroke="rgba(247,244,238,0.06)" stroke-width="0.5">
            <line x1="0" y1="50" x2="1000" y2="50" /><line x1="0" y1="100" x2="1000" y2="100" />
            <line x1="0" y1="150" x2="1000" y2="150" /><line x1="0" y1="200" x2="1000" y2="200" />
            <line x1="0" y1="250" x2="1000" y2="250" />
          </g>

          <g font-family="IBM Plex Mono" font-size="9" fill="rgba(247,244,238,0.4)" letter-spacing="1">
            <text x="6" y="54">₺26</text><text x="6" y="104">₺22</text>
            <text x="6" y="154">₺19</text><text x="6" y="204">₺16</text>
            <text x="6" y="254">₺13</text>
          </g>

          <path d="M 50 220 L 80 235 L 110 225 L 140 200 L 170 215 L 200 180 L 230 195 L 260 160 L 290 175 L 320 140 L 350 155 L 380 135 L 410 150 L 440 115 L 470 130 L 500 100 L 530 115 L 560 90 L 590 105 L 620 80 L 650 95 L 680 70 L 710 85 L 740 60 L 770 75 L 800 55 L 830 72 L 860 48 L 890 62 L 920 40 L 950 55 L 970 32 L 985 38 L 985 280 L 50 280 Z" fill="url(#big-chart-fill)" />

          <path d="M 50 220 L 80 235 L 110 225 L 140 200 L 170 215 L 200 180 L 230 195 L 260 160 L 290 175 L 320 140 L 350 155 L 380 135 L 410 150 L 440 115 L 470 130 L 500 100 L 530 115 L 560 90 L 590 105 L 620 80 L 650 95 L 680 70 L 710 85 L 740 60 L 770 75 L 800 55 L 830 72 L 860 48 L 890 62 L 920 40 L 950 55 L 970 32 L 985 38" stroke="#5AB670" stroke-width="1.8" fill="none" stroke-linejoin="round" stroke-linecap="round" />

          <line x1="985" y1="38" x2="985" y2="270" stroke="#5AB670" stroke-width="0.5" stroke-dasharray="2 3" opacity="0.5" />
          <circle cx="985" cy="38" r="4" fill="#5AB670" />
          <circle cx="985" cy="38" r="8" fill="#5AB670" opacity="0.25" />

          <g transform="translate(902, 28)">
            <rect width="80" height="20" fill="#5AB670" />
            <text x="40" y="14" font-family="IBM Plex Mono" font-size="10" font-weight="600" fill="#0A0A0A" letter-spacing="0.5" text-anchor="middle">₺24,80</text>
          </g>

          <circle cx="50" cy="220" r="3" fill="#D9521C" />
          <line x1="50" y1="218" x2="50" y2="170" stroke="rgba(217,82,28,0.5)" stroke-width="0.6" stroke-dasharray="2 2" />
          <text x="56" y="165" font-family="IBM Plex Mono" font-size="9" fill="#D9521C" letter-spacing="1">{t.ipoLabel}</text>
        </svg>
      </div>

      <div class="x-axis">
        {t.axis.map((label) => <span>{label}</span>)}
      </div>

      <div class="chart-stats">
        {t.chartStats.map((s) => (
          <div class="chart-stat">
            <span class="lbl">{s.lbl}</span>
            <span class:list={['val', s.dir]}>{s.val}</span>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
.chart-section { background: var(--paper); padding: var(--section-y) 0; }

.sec-head {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 2rem;
  align-items: end;
  margin-bottom: 3rem;
}
.sec-head h2 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 96, "SOFT" 65, "wght" 420;
  font-size: clamp(1.875rem, 3.6vw, 2.75rem);
  line-height: 1.05;
  letter-spacing: -0.022em;
  color: var(--ink);
}
.sec-head h2 em {
  font-style: italic;
  font-variation-settings: "opsz" 96, "SOFT" 100, "wght" 380;
  color: var(--terracotta);
}

.chart-card {
  background: var(--ink);
  color: var(--paper);
  padding: clamp(1.5rem, 3vw, 2.25rem);
  position: relative;
  overflow: hidden;
}
.chart-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(to right, var(--terracotta), var(--terracotta-warm));
}
.chart-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1.5rem;
  margin-bottom: 2rem;
}
.chart-title { display: flex; flex-direction: column; gap: 0.5rem; }
.chart-title .tag {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(247, 244, 238, 0.55);
}
.chart-title .name {
  font-family: var(--serif);
  font-variation-settings: "opsz" 96, "SOFT" 60, "wght" 480;
  font-size: 1.5rem;
  color: var(--paper);
}

.range-pills {
  display: inline-flex;
  background: rgba(247, 244, 238, 0.05);
  border: 1px solid rgba(247, 244, 238, 0.12);
  border-radius: 2px;
  padding: 3px;
}
.range-pills button {
  font-family: var(--mono);
  font-size: 0.6875rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  color: rgba(247, 244, 238, 0.6);
  padding: 0.4375rem 0.625rem;
  border-radius: 2px;
  transition: all var(--t-fast) var(--ease);
  text-transform: uppercase;
  cursor: pointer;
}
.range-pills button.active {
  background: var(--terracotta);
  color: var(--paper);
}
.range-pills button:hover:not(.active) { color: var(--paper); }

.big-chart {
  width: 100%;
  height: clamp(220px, 28vw, 320px);
  position: relative;
  margin-bottom: 1rem;
}
.big-chart svg { width: 100%; height: 100%; }

.x-axis {
  display: flex;
  justify-content: space-between;
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.1em;
  color: rgba(247,244,238,0.4);
  text-transform: uppercase;
  padding: 0 1rem 1.5rem;
  border-bottom: 1px solid rgba(247, 244, 238, 0.08);
  margin-bottom: 1.5rem;
}

.chart-stats {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 1rem;
  padding-top: 1.75rem;
  border-top: 1px solid rgba(247, 244, 238, 0.1);
}
.chart-stat { display: flex; flex-direction: column; gap: 0.375rem; }
.chart-stat .lbl {
  font-family: var(--mono);
  font-size: 0.6rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(247, 244, 238, 0.5);
}
.chart-stat .val {
  font-family: var(--mono);
  font-size: 0.9375rem;
  font-weight: 500;
  color: var(--paper);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.01em;
}
.chart-stat .val.up { color: var(--up); }
.chart-stat .val.down { color: var(--down); }

@media (max-width: 980px) {
  .sec-head { grid-template-columns: 1fr; }
  .chart-stats { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 720px) {
  .chart-stats { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 480px) {
  .chart-stats { grid-template-columns: 1fr; }
}
</style>

<script>
  // Range pill toggle (cosmetic — Faz 7'de gerçek chart data ile çalışacak)
  document.querySelectorAll('.range-pills').forEach((group) => {
    group.querySelectorAll('button').forEach((b) => {
      b.addEventListener('click', () => {
        group.querySelectorAll('button').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
      });
    });
  });
</script>
