---
/**
 * DocListSection — investor-documents koleksiyonundan filtreli liste
 * Yatırımcı sayfalarında çok yerde kullanılır (Komiteler, Politikalar, GK, vb.)
 *
 * Props:
 *   - markerNum: '03'
 *   - title: 'Yönetim Kurulu Komiteleri'
 *   - intro: '...'
 *   - filter: (data) => bool — investor-documents kayıtlarını filtreler
 *   - emptyMsg: opsiyonel
 *   - showYear: boolean (default false) — sağda yıl kolonu göster
 */
import { getCollection } from 'astro:content';
import { getLocale, formatDate, formatBytes } from '../../lib/i18n';
const locale = getLocale(Astro.url.pathname);

interface Props {
  markerNum: string;
  title: string;
  intro: string;
  filterType?: string | string[];
  filterSlugIncludes?: string[];
  filterSlugExcludes?: string[];
  emptyMsg?: string;
  variant?: 'light' | 'soft';
}
const { markerNum, title, intro, filterType, filterSlugIncludes, filterSlugExcludes, emptyMsg, variant = 'light' } = Astro.props;

const all = await getCollection('investor-documents', (d) => d.data.lang === locale);
let items = all.map((d) => d.data);

if (filterType) {
  const types = Array.isArray(filterType) ? filterType : [filterType];
  items = items.filter((d) => types.includes(d.type));
}
if (filterSlugIncludes && filterSlugIncludes.length > 0) {
  items = items.filter((d) => filterSlugIncludes.some((s) => d.slug.includes(s)));
}
if (filterSlugExcludes && filterSlugExcludes.length > 0) {
  items = items.filter((d) => !filterSlugExcludes.some((s) => d.slug.includes(s)));
}
items.sort((a, b) => +b.date - +a.date);

const t = locale === 'tr' ? {
  empty: emptyMsg ?? 'Bu kategoride doküman bulunmuyor.',
  open: 'Aç',
} : {
  empty: emptyMsg ?? 'No documents in this category.',
  open: 'Open',
};

function cleanTitle(s: string): string {
  return s
    .replace(/Yili/g, 'Yılı')
    .replace(/Donemi/g, 'Dönemi')
    .replace(/Faaliyet Rapor\b/g, 'Faaliyet Raporu')
    .replace(/Surdurulebilirlik/g, 'Sürdürülebilirlik')
    .replace(/Iliskilerine/g, 'İlişkilerine')
    .replace(/Iliskin/g, 'İlişkin');
}
---

<section class:list={['doc-list-section', variant]}>
  <div class="container">
    <div class="head">
      <div>
        <span class="marker">{markerNum} — {title}</span>
        <h2>{title}</h2>
      </div>
      <p class="intro">{intro}</p>
    </div>

    {items.length === 0 ? (
      <p class="empty">{t.empty}</p>
    ) : (
      <ol class="docs">
        {items.map((d) => (
          <li class="doc">
            <span class="date">{formatDate(d.date, locale)}</span>
            <h3>{locale === 'tr' ? cleanTitle(d.title) : d.title}</h3>
            <a class="open" href={d.pdfUrl} target="_blank" rel="noopener">
              <span class="pdf">PDF</span>
              {d.pdfSizeBytes && <span class="size">{formatBytes(d.pdfSizeBytes, locale)}</span>}
              <span class="arr" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ol>
    )}
  </div>
</section>

<style>
.doc-list-section.light { background: var(--paper); padding: clamp(2.5rem, 5vw, 4rem) 0; }
.doc-list-section.soft { background: var(--paper-soft); padding: clamp(2.5rem, 5vw, 4rem) 0; }

.head {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 4rem;
  align-items: end;
  margin-bottom: 2rem;
}
.marker {
  font-family: var(--mono);
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--bist-navy);
  display: inline-block;
  margin-bottom: 0.75rem;
}
.head h2 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 72, "SOFT" 55, "wght" 480;
  font-size: clamp(1.5rem, 2.6vw, 2rem);
  line-height: 1.1;
  letter-spacing: -0.018em;
  color: var(--ink);
}
.head .intro {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: var(--muted);
  max-width: 460px;
}

.empty {
  font-family: var(--mono);
  font-size: 0.8125rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
  padding: 2rem 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  text-align: center;
}

.docs { list-style: none; margin: 0; padding: 0; }
.doc {
  display: grid;
  grid-template-columns: 180px 1fr auto;
  gap: 1.5rem;
  align-items: center;
  padding: 1.125rem 0;
  border-top: 1px solid var(--line);
  transition: padding var(--t-fast) var(--ease), background var(--t-fast) var(--ease);
}
.doc:last-child { border-bottom: 1px solid var(--line); }
.doc:hover { background: rgba(26, 43, 71, 0.03); padding-inline: 0.75rem; }

.date {
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
}
.doc h3 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 36, "SOFT" 55, "wght" 480;
  font-size: 1rem;
  line-height: 1.3;
  letter-spacing: -0.01em;
  color: var(--ink);
  margin: 0;
}
.open {
  display: inline-flex;
  align-items: center;
  gap: 0.625rem;
  font-family: var(--mono);
  font-size: 0.75rem;
  color: var(--ink);
  white-space: nowrap;
  transition: color var(--t-fast) var(--ease);
}
.open:hover { color: var(--bist-navy); }
.pdf {
  padding: 0.1875rem 0.5rem;
  border: 1px solid var(--ink);
  border-radius: 2px;
  font-weight: 600;
  letter-spacing: 0.12em;
}
.size { letter-spacing: 0.06em; color: var(--muted); }
.arr { color: var(--bist-navy); font-size: 1rem; }

@media (max-width: 720px) {
  .head { grid-template-columns: 1fr; gap: 1.25rem; }
  .doc { grid-template-columns: 1fr; gap: 0.375rem; }
  .open { justify-self: start; }
}
</style>
