---
/**
 * KapList — KAP açıklamaları listesi
 * Filter bar (yıl + kategori + arama) + liste + sayfalama
 * VERİ: src/content/kap/ (WP'den migrate edildi, 230+ kayıt)
 */
import { getCollection } from 'astro:content';
import { getLocale, formatDateShort, type Locale } from '../../lib/i18n';

const locale: Locale = getLocale(Astro.url.pathname);

const t = locale === 'tr' ? {
  marker: 'KAP Açıklamaları',
  h2a: 'Kamuyu Aydınlatma Platformu',
  h2em: 'akışı',
  h2post: '.',
  kapView: 'KAP\'ta görüntüle',
  filterYear: 'Yıl',
  filterCat: 'Kategori',
  catLabels: { all: 'Tümü', finansal: 'Finansal', 'genel-kurul': 'Genel Kurul', yatirim: 'Yatırım', esg: 'ESG', sermaye: 'Sermaye', bilgilendirme: 'Bilgilendirme' },
  searchPh: 'Açıklamada ara…',
  resultsCount: 'kayıt',
  tagLabels: {
    finansal: 'Finansal', 'genel-kurul': 'Genel Kurul', yatirim: 'Yatırım',
    esg: 'Sürdürülebilirlik', sermaye: 'Sermaye', bilgilendirme: 'Bilgilendirme',
  },
  open: 'KAP\'ta aç',
  paginationLbl: 'kayıt',
} : {
  marker: 'PDP Disclosures',
  h2a: 'Public Disclosure Platform',
  h2em: 'feed',
  h2post: '.',
  kapView: 'View on PDP',
  filterYear: 'Year',
  filterCat: 'Category',
  catLabels: { all: 'All', finansal: 'Financial', 'genel-kurul': 'Assembly', yatirim: 'Investment', esg: 'ESG', sermaye: 'Capital', bilgilendirme: 'Notice' },
  searchPh: 'Search disclosures…',
  resultsCount: 'records',
  tagLabels: {
    finansal: 'Financial', 'genel-kurul': 'Assembly', yatirim: 'Investment',
    esg: 'Sustainability', sermaye: 'Capital', bilgilendirme: 'Notice',
  },
  open: 'Open on PDP',
  paginationLbl: 'records',
};

// Gerçek veriyi çek, tarihe göre desc sırala
const all = await getCollection('kap', (e) => e.data.lang === locale);
const sorted = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Yıllar (mevcut veride hangileri var)
const years = [...new Set(sorted.map((e) => e.data.date.getFullYear()))].sort((a, b) => b - a);

const PER_PAGE = 9;
const totalCount = sorted.length;
const totalPages = Math.max(1, Math.ceil(totalCount / PER_PAGE));

// Server-side initial pagination iskeleti — JS yüklenmeden de görünür kalsın.
type PageBtn = { label: string; page?: number; active?: boolean; disabled?: boolean; gap?: boolean };
function computePageButtons(current: number, total: number): PageBtn[] {
  const buttons: PageBtn[] = [];
  buttons.push({ label: '‹', page: Math.max(1, current - 1), disabled: current === 1 });
  const pages = new Set<number>([1, total]);
  for (let p = current - 1; p <= current + 1; p++) {
    if (p >= 1 && p <= total) pages.add(p);
  }
  const sortedPages = Array.from(pages).sort((a, b) => a - b);
  let prev = 0;
  for (const p of sortedPages) {
    if (p - prev > 1) buttons.push({ label: '…', gap: true });
    buttons.push({ label: String(p), page: p, active: p === current });
    prev = p;
  }
  buttons.push({ label: '›', page: Math.min(total, current + 1), disabled: current === total });
  return buttons;
}
const initialButtons = computePageButtons(1, totalPages);

// Kategori tag CSS class map (frontmatter category → renkli tag)
const tagClassMap: Record<string, string> = {
  finansal: 'fin',
  'genel-kurul': 'assembly',
  yatirim: 'capital',
  esg: 'esg',
  sermaye: 'capital',
  bilgilendirme: 'kap',
};
---

<section class="kap-section" id="kap">
  <div class="container">

    <div class="sec-head">
      <div>
        <div class="section-marker" style="margin-bottom: 1rem;">
          <span class="num">03</span><span class="of">/</span><span>07</span><span class="dash">—</span><span class="label">{t.marker}</span>
        </div>
        <h2>{t.h2a} <em>{t.h2em}</em>{t.h2post}</h2>
      </div>
      <a href="https://www.kap.org.tr/tr/sirket-bilgileri/ozet/2455-sanica-isi-sanayi-a-s" target="_blank" rel="noopener" class="link-arrow">{t.kapView} <span class="arrow" aria-hidden="true">↗</span></a>
    </div>

    <!-- Filters (Faz 7'de gerçek client-side filtering) -->
    <div class="kap-filters">
      <div class="filter-group">
        <span class="filter-label">{t.filterYear}</span>
        <div class="pill-group year-pills">
          <button class="active" data-year="all">{locale === 'tr' ? 'Tümü' : 'All'}</button>
          {years.map((y) => (
            <button data-year={y}>{y}</button>
          ))}
        </div>
      </div>
      <div class="filter-group">
        <span class="filter-label">{t.filterCat}</span>
        <div class="pill-group cat-pills">
          <button class="active" data-cat="all">{t.catLabels.all}</button>
          {(['finansal', 'genel-kurul', 'yatirim', 'esg', 'sermaye', 'bilgilendirme'] as const).map((c) => (
            <button data-cat={c}>{t.catLabels[c]}</button>
          ))}
        </div>
      </div>
      <div class="search-input">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3-3" /></svg>
        <input type="text" placeholder={t.searchPh} aria-label={t.searchPh} />
      </div>
      <span class="kap-count"><strong>{totalCount}</strong> {t.resultsCount}</span>
    </div>

    <!-- List -->
    <div class="kap-list" data-per-page={PER_PAGE}>
      {sorted.map((item) => (
        <article
          class="kap-row"
          data-year={item.data.date.getFullYear()}
          data-cat={item.data.category}
          data-search={item.data.title.toLowerCase()}
        >
          <div class="date">{formatDateShort(item.data.date, locale)}</div>
          <span class:list={['tag', tagClassMap[item.data.category]]}>
            {t.tagLabels[item.data.category as keyof typeof t.tagLabels]}
          </span>
          <div class="title">
            {item.data.kapUrl ? (
              <a href={item.data.kapUrl} target="_blank" rel="noopener">{item.data.title}</a>
            ) : (
              <span>{item.data.title}</span>
            )}
          </div>
          <div class="action">
            {item.data.kapUrl && (
              <a href={item.data.kapUrl} target="_blank" rel="noopener" class="kap-action-btn">
                {t.open}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7" /><path d="M7 7h10v10" /></svg>
              </a>
            )}
          </div>
        </article>
      ))}
      <div class="kap-empty" hidden>{locale === 'tr' ? 'Bu filtrelerle eşleşen açıklama bulunamadı.' : 'No disclosures match these filters.'}</div>
    </div>

    <!-- Pagination (server-side iskelet, JS overrride eder) -->
    <div class="pagination" data-label={t.paginationLbl}>
      <span class="count"><strong>1–{Math.min(PER_PAGE, totalCount)}</strong> · {totalCount} {t.paginationLbl}</span>
      <div class="page-nums">
        {initialButtons.map((b) => (
          <button
            class:list={[b.active && 'active', b.gap && 'gap']}
            disabled={b.disabled || b.gap}
            data-init-page={b.page}
          >{b.label}</button>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
.kap-section { background: var(--paper); padding: var(--section-y) 0; }

.sec-head {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 2rem;
  align-items: end;
  margin-bottom: 3rem;
}
.sec-head h2 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 96, "SOFT" 65, "wght" 420;
  font-size: clamp(1.875rem, 3.6vw, 2.75rem);
  line-height: 1.05;
  letter-spacing: -0.022em;
  color: var(--ink);
}
.sec-head h2 em {
  font-style: italic;
  font-variation-settings: "opsz" 96, "SOFT" 100, "wght" 380;
  color: var(--terracotta);
}

.kap-filters {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1rem;
  margin-bottom: 2rem;
  padding: 1rem 1.25rem;
  background: var(--sand);
  border: 1px solid var(--line);
}
.filter-group { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
.filter-label {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--muted);
}
.pill-group {
  display: inline-flex;
  gap: 4px;
  background: var(--paper);
  border: 1px solid var(--line);
  padding: 3px;
}
.pill-group button {
  font-family: var(--mono);
  font-size: 0.6875rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  color: var(--muted);
  padding: 0.4375rem 0.625rem;
  border-radius: 2px;
  transition: all var(--t-fast) var(--ease);
  text-transform: uppercase;
  font-variant-numeric: tabular-nums;
  cursor: pointer;
}
.pill-group button.active { background: var(--ink); color: var(--paper); }
.pill-group button:hover:not(.active) { color: var(--ink); }

.search-input {
  flex: 1;
  min-width: 220px;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: var(--paper);
  border: 1px solid var(--line);
  padding: 0.4375rem 0.75rem;
  font-family: var(--sans);
}
.search-input svg { width: 14px; height: 14px; color: var(--muted); flex-shrink: 0; }
.search-input input {
  background: transparent;
  border: none;
  outline: none;
  flex: 1;
  font-size: 0.875rem;
  color: var(--text);
}
.search-input input::placeholder { color: var(--muted); }

.kap-count {
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.14em;
  color: var(--muted);
  text-transform: uppercase;
  margin-left: auto;
}
.kap-count strong { color: var(--ink); font-weight: 600; }

.kap-list { border-top: 1px solid var(--line); }
.kap-empty {
  padding: 3rem 1rem;
  text-align: center;
  font-family: var(--mono);
  font-size: 0.8125rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted);
  border-bottom: 1px solid var(--line);
}
.kap-row {
  display: grid;
  grid-template-columns: 100px 130px 1fr auto;
  gap: 1.5rem;
  padding: 1.5rem 1rem;
  border-bottom: 1px solid var(--line);
  align-items: center;
  transition: background var(--t-fast) var(--ease);
}
.kap-row:hover { background: var(--sand); }
.kap-row .date {
  font-family: var(--mono);
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--text);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.02em;
  white-space: nowrap;
}
.kap-row .tag {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-weight: 600;
  padding: 0.3125rem 0.5rem;
  align-self: start;
  white-space: nowrap;
  background: var(--bist-navy-soft);
  color: var(--bist-navy);
}
.kap-row .tag.fin { background: var(--terracotta-soft); color: var(--terracotta); }
.kap-row .tag.esg { background: var(--success-soft); color: var(--success); }
.kap-row .tag.assembly { background: var(--sand-deep); color: var(--ink); }
.kap-row .tag.capital { background: rgba(74, 77, 82, 0.15); color: var(--steel); }
.kap-row .tag.kap { background: var(--bist-navy-soft); color: var(--bist-navy); }

.kap-row .title {
  font-family: var(--serif);
  font-variation-settings: "opsz" 36, "SOFT" 55, "wght" 480;
  font-size: 1rem;
  line-height: 1.4;
  letter-spacing: -0.008em;
  color: var(--ink);
}
.kap-row .title a {
  color: inherit;
  transition: color var(--t-fast) var(--ease);
}
.kap-row .title a:hover { color: var(--terracotta); }

.kap-row .action {
  display: flex;
  align-items: center;
  gap: 1rem;
}
.kap-action-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4375rem;
  font-family: var(--mono);
  font-size: 0.6875rem;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink);
  padding: 0.5rem 0.75rem;
  border: 1px solid var(--line);
  transition: all var(--t-fast) var(--ease);
  white-space: nowrap;
}
.kap-action-btn:hover {
  background: var(--ink);
  color: var(--paper);
  border-color: var(--ink);
}
.kap-action-btn svg { width: 12px; height: 12px; }

.pagination {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-top: 2.5rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--line);
  flex-wrap: wrap;
}
.pagination .count {
  font-family: var(--mono);
  font-size: 0.6875rem;
  color: var(--muted);
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
.pagination .count strong { color: var(--ink); font-weight: 600; }
.page-nums { display: inline-flex; gap: 4px; }
.page-nums button {
  width: 36px;
  height: 36px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-family: var(--mono);
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--text);
  border: 1px solid var(--line);
  background: var(--paper);
  transition: all var(--t-fast) var(--ease);
  font-variant-numeric: tabular-nums;
  cursor: pointer;
}
.page-nums button:hover:not(:disabled) { border-color: var(--ink); }
.page-nums button.active {
  background: var(--ink);
  color: var(--paper);
  border-color: var(--ink);
}
.page-nums button:disabled { color: var(--muted); cursor: not-allowed; }
.page-nums .gap { border: none; color: var(--muted); cursor: default; }

@media (max-width: 980px) { .sec-head { grid-template-columns: 1fr; } }
@media (max-width: 720px) {
  .kap-row { grid-template-columns: 1fr; gap: 0.625rem; padding: 1.25rem 0.5rem; }
  .kap-row .action { justify-content: flex-start; }
  .kap-filters { padding: 1rem; }
  .kap-count { margin-left: 0; }
}
</style>

<script>
  type Row = HTMLElement;

  const section = document.getElementById('kap');
  if (section) {
    const listEl = section.querySelector<HTMLElement>('.kap-list')!;
    const rows = Array.from(listEl.querySelectorAll<HTMLElement>('.kap-row'));
    const emptyEl = listEl.querySelector<HTMLElement>('.kap-empty')!;
    const yearPills = section.querySelector<HTMLElement>('.year-pills')!;
    const catPills = section.querySelector<HTMLElement>('.cat-pills')!;
    const searchInput = section.querySelector<HTMLInputElement>('.search-input input')!;
    const countEl = section.querySelector<HTMLElement>('.kap-count strong')!;
    const pagEl = section.querySelector<HTMLElement>('.pagination')!;
    const pagNumsEl = pagEl.querySelector<HTMLElement>('.page-nums')!;
    const pagCountEl = pagEl.querySelector<HTMLElement>('.count')!;
    const perPage = parseInt(listEl.dataset.perPage || '9', 10);
    const recordsLbl = pagEl.dataset.label || '';

    const state = {
      year: 'all' as string,
      cat: 'all' as string,
      search: '',
      page: 1,
    };

    let filtered: Row[] = rows.slice();

    function applyFilter() {
      const q = state.search.trim().toLowerCase();
      filtered = rows.filter((r) => {
        if (state.year !== 'all' && r.dataset.year !== state.year) return false;
        if (state.cat !== 'all' && r.dataset.cat !== state.cat) return false;
        if (q && !(r.dataset.search || '').includes(q)) return false;
        return true;
      });
      state.page = 1;
      render();
    }

    function setCount(start: number, end: number, total: number) {
      pagCountEl.replaceChildren();
      const strong = document.createElement('strong');
      strong.textContent = total === 0 ? '0' : `${start + 1}–${Math.min(end, total)}`;
      pagCountEl.append(strong, ` · ${total} ${recordsLbl}`);
    }

    function render() {
      const total = filtered.length;
      const totalPages = Math.max(1, Math.ceil(total / perPage));
      if (state.page > totalPages) state.page = totalPages;
      const start = (state.page - 1) * perPage;
      const end = start + perPage;

      const visibleSet = new Set(filtered.slice(start, end));
      rows.forEach((r) => {
        r.hidden = !visibleSet.has(r);
      });
      emptyEl.hidden = total !== 0;

      countEl.textContent = String(total);
      setCount(start, end, total);

      pagNumsEl.replaceChildren();
      const mkBtn = (label: string, opts: { active?: boolean; disabled?: boolean; gap?: boolean; page?: number } = {}) => {
        const b = document.createElement('button');
        b.textContent = label;
        if (opts.active) b.classList.add('active');
        if (opts.gap) b.classList.add('gap');
        if (opts.disabled) b.disabled = true;
        if (opts.page !== undefined && !opts.disabled && !opts.gap) {
          b.addEventListener('click', () => {
            state.page = opts.page!;
            render();
            section.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
        }
        return b;
      };

      pagNumsEl.appendChild(mkBtn('‹', { disabled: state.page === 1, page: state.page - 1 }));

      const pages = new Set<number>();
      pages.add(1);
      pages.add(totalPages);
      for (let p = state.page - 1; p <= state.page + 1; p++) {
        if (p >= 1 && p <= totalPages) pages.add(p);
      }
      const sortedPages = Array.from(pages).sort((a, b) => a - b);
      let prev = 0;
      for (const p of sortedPages) {
        if (p - prev > 1) pagNumsEl.appendChild(mkBtn('…', { gap: true }));
        pagNumsEl.appendChild(mkBtn(String(p), { active: p === state.page, page: p }));
        prev = p;
      }

      pagNumsEl.appendChild(mkBtn('›', { disabled: state.page === totalPages, page: state.page + 1 }));
    }

    yearPills.querySelectorAll('button').forEach((b) => {
      b.addEventListener('click', () => {
        yearPills.querySelectorAll('button').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        state.year = b.dataset.year || 'all';
        applyFilter();
      });
    });

    catPills.querySelectorAll('button').forEach((b) => {
      b.addEventListener('click', () => {
        catPills.querySelectorAll('button').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        state.cat = b.dataset.cat || 'all';
        applyFilter();
      });
    });

    let searchTimer: number | undefined;
    searchInput.addEventListener('input', () => {
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => {
        state.search = searchInput.value;
        applyFilter();
      }, 150);
    });

    applyFilter();
  }
</script>
