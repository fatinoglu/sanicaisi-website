---
/**
 * KapList — KAP açıklamaları listesi
 * Filter bar (yıl + kategori + arama) + liste + sayfalama
 * VERİ: src/content/kap/ (WP'den migrate edildi, 230+ kayıt)
 */
import { getCollection } from 'astro:content';
import { getLocale, formatDateShort, type Locale } from '../../lib/i18n';

const locale: Locale = getLocale(Astro.url.pathname);

const t = locale === 'tr' ? {
  marker: 'KAP Açıklamaları',
  h2a: 'Kamuyu Aydınlatma Platformu',
  h2em: 'akışı',
  h2post: '.',
  kapView: 'KAP\'ta görüntüle',
  filterYear: 'Yıl',
  filterCat: 'Kategori',
  catLabels: { all: 'Tümü', finansal: 'Finansal', 'genel-kurul': 'Genel Kurul', yatirim: 'Yatırım', esg: 'ESG', sermaye: 'Sermaye', bilgilendirme: 'Bilgilendirme' },
  searchPh: 'Açıklamada ara…',
  resultsCount: 'kayıt',
  tagLabels: {
    finansal: 'Finansal', 'genel-kurul': 'Genel Kurul', yatirim: 'Yatırım',
    esg: 'Sürdürülebilirlik', sermaye: 'Sermaye', bilgilendirme: 'Bilgilendirme',
  },
  open: 'KAP\'ta aç',
  paginationLbl: 'kayıt',
} : {
  marker: 'PDP Disclosures',
  h2a: 'Public Disclosure Platform',
  h2em: 'feed',
  h2post: '.',
  kapView: 'View on PDP',
  filterYear: 'Year',
  filterCat: 'Category',
  catLabels: { all: 'All', finansal: 'Financial', 'genel-kurul': 'Assembly', yatirim: 'Investment', esg: 'ESG', sermaye: 'Capital', bilgilendirme: 'Notice' },
  searchPh: 'Search disclosures…',
  resultsCount: 'records',
  tagLabels: {
    finansal: 'Financial', 'genel-kurul': 'Assembly', yatirim: 'Investment',
    esg: 'Sustainability', sermaye: 'Capital', bilgilendirme: 'Notice',
  },
  open: 'Open on PDP',
  paginationLbl: 'records',
};

// Gerçek veriyi çek, tarihe göre desc sırala
const all = await getCollection('kap', (e) => e.data.lang === locale);
const sorted = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Yıllar (mevcut veride hangileri var)
const years = [...new Set(sorted.map((e) => e.data.date.getFullYear()))].sort((a, b) => b - a);

// İlk sayfa (ilk 9 kayıt) — Faz 7'de URL parametresi ile gerçek pagination
const PER_PAGE = 9;
const visible = sorted.slice(0, PER_PAGE);
const totalCount = sorted.length;
const showingCount = visible.length;

// Kategori tag CSS class map (frontmatter category → renkli tag)
const tagClassMap: Record<string, string> = {
  finansal: 'fin',
  'genel-kurul': 'assembly',
  yatirim: 'capital',
  esg: 'esg',
  sermaye: 'capital',
  bilgilendirme: 'kap',
};
---

<section class="kap-section" id="kap">
  <div class="container">

    <div class="sec-head">
      <div>
        <div class="section-marker" style="margin-bottom: 1rem;">
          <span class="num">03</span><span class="of">/</span><span>07</span><span class="dash">—</span><span class="label">{t.marker}</span>
        </div>
        <h2>{t.h2a} <em>{t.h2em}</em>{t.h2post}</h2>
      </div>
      <a href="https://www.kap.org.tr/tr/sirket-bilgileri/ozet/2455-sanica-isi-sanayi-a-s" target="_blank" rel="noopener" class="link-arrow">{t.kapView} <span class="arrow" aria-hidden="true">↗</span></a>
    </div>

    <!-- Filters (Faz 7'de gerçek client-side filtering) -->
    <div class="kap-filters">
      <div class="filter-group">
        <span class="filter-label">{t.filterYear}</span>
        <div class="pill-group year-pills">
          <button class="active" data-year="all">{locale === 'tr' ? 'Tümü' : 'All'}</button>
          {years.map((y) => (
            <button data-year={y}>{y}</button>
          ))}
        </div>
      </div>
      <div class="filter-group">
        <span class="filter-label">{t.filterCat}</span>
        <div class="pill-group cat-pills">
          <button class="active" data-cat="all">{t.catLabels.all}</button>
          {(['finansal', 'genel-kurul', 'yatirim', 'esg', 'sermaye', 'bilgilendirme'] as const).map((c) => (
            <button data-cat={c}>{t.catLabels[c]}</button>
          ))}
        </div>
      </div>
      <div class="search-input">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3-3" /></svg>
        <input type="text" placeholder={t.searchPh} aria-label={t.searchPh} />
      </div>
      <span class="kap-count"><strong>{totalCount}</strong> {t.resultsCount}</span>
    </div>

    <!-- List -->
    <div class="kap-list">
      {visible.map((item) => (
        <article class="kap-row">
          <div class="date">{formatDateShort(item.data.date, locale)}</div>
          <span class:list={['tag', tagClassMap[item.data.category]]}>
            {t.tagLabels[item.data.category as keyof typeof t.tagLabels]}
          </span>
          <div class="title">
            {item.data.kapUrl ? (
              <a href={item.data.kapUrl} target="_blank" rel="noopener">{item.data.title}</a>
            ) : (
              <span>{item.data.title}</span>
            )}
          </div>
          <div class="action">
            {item.data.kapUrl && (
              <a href={item.data.kapUrl} target="_blank" rel="noopener" class="kap-action-btn">
                {t.open}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7" /><path d="M7 7h10v10" /></svg>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>

    <!-- Pagination (Faz 7'de URL'e bağlanır) -->
    <div class="pagination">
      <span class="count"><strong>1–{showingCount}</strong> · {totalCount} {t.paginationLbl}</span>
      <div class="page-nums">
        <button disabled>‹</button>
        <button class="active">1</button>
        {totalCount > PER_PAGE && <button>2</button>}
        {totalCount > PER_PAGE * 2 && <button class="gap">…</button>}
        <button disabled={totalCount <= PER_PAGE}>›</button>
      </div>
    </div>

  </div>
</section>

<style>
.kap-section { background: var(--paper); padding: var(--section-y) 0; }

.sec-head {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 2rem;
  align-items: end;
  margin-bottom: 3rem;
}
.sec-head h2 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 96, "SOFT" 65, "wght" 420;
  font-size: clamp(1.875rem, 3.6vw, 2.75rem);
  line-height: 1.05;
  letter-spacing: -0.022em;
  color: var(--ink);
}
.sec-head h2 em {
  font-style: italic;
  font-variation-settings: "opsz" 96, "SOFT" 100, "wght" 380;
  color: var(--terracotta);
}

.kap-filters {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1rem;
  margin-bottom: 2rem;
  padding: 1rem 1.25rem;
  background: var(--sand);
  border: 1px solid var(--line);
}
.filter-group { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
.filter-label {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--muted);
}
.pill-group {
  display: inline-flex;
  gap: 4px;
  background: var(--paper);
  border: 1px solid var(--line);
  padding: 3px;
}
.pill-group button {
  font-family: var(--mono);
  font-size: 0.6875rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  color: var(--muted);
  padding: 0.4375rem 0.625rem;
  border-radius: 2px;
  transition: all var(--t-fast) var(--ease);
  text-transform: uppercase;
  font-variant-numeric: tabular-nums;
  cursor: pointer;
}
.pill-group button.active { background: var(--ink); color: var(--paper); }
.pill-group button:hover:not(.active) { color: var(--ink); }

.search-input {
  flex: 1;
  min-width: 220px;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: var(--paper);
  border: 1px solid var(--line);
  padding: 0.4375rem 0.75rem;
  font-family: var(--sans);
}
.search-input svg { width: 14px; height: 14px; color: var(--muted); flex-shrink: 0; }
.search-input input {
  background: transparent;
  border: none;
  outline: none;
  flex: 1;
  font-size: 0.875rem;
  color: var(--text);
}
.search-input input::placeholder { color: var(--muted); }

.kap-count {
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.14em;
  color: var(--muted);
  text-transform: uppercase;
  margin-left: auto;
}
.kap-count strong { color: var(--ink); font-weight: 600; }

.kap-list { border-top: 1px solid var(--line); }
.kap-row {
  display: grid;
  grid-template-columns: 100px 130px 1fr auto;
  gap: 1.5rem;
  padding: 1.5rem 1rem;
  border-bottom: 1px solid var(--line);
  align-items: center;
  transition: background var(--t-fast) var(--ease);
}
.kap-row:hover { background: var(--sand); }
.kap-row .date {
  font-family: var(--mono);
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--text);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.02em;
  white-space: nowrap;
}
.kap-row .tag {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-weight: 600;
  padding: 0.3125rem 0.5rem;
  align-self: start;
  white-space: nowrap;
  background: var(--bist-navy-soft);
  color: var(--bist-navy);
}
.kap-row .tag.fin { background: var(--terracotta-soft); color: var(--terracotta); }
.kap-row .tag.esg { background: var(--success-soft); color: var(--success); }
.kap-row .tag.assembly { background: var(--sand-deep); color: var(--ink); }
.kap-row .tag.capital { background: rgba(74, 77, 82, 0.15); color: var(--steel); }
.kap-row .tag.kap { background: var(--bist-navy-soft); color: var(--bist-navy); }

.kap-row .title {
  font-family: var(--serif);
  font-variation-settings: "opsz" 36, "SOFT" 55, "wght" 480;
  font-size: 1rem;
  line-height: 1.4;
  letter-spacing: -0.008em;
  color: var(--ink);
}
.kap-row .title a {
  color: inherit;
  transition: color var(--t-fast) var(--ease);
}
.kap-row .title a:hover { color: var(--terracotta); }

.kap-row .action {
  display: flex;
  align-items: center;
  gap: 1rem;
}
.kap-action-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4375rem;
  font-family: var(--mono);
  font-size: 0.6875rem;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink);
  padding: 0.5rem 0.75rem;
  border: 1px solid var(--line);
  transition: all var(--t-fast) var(--ease);
  white-space: nowrap;
}
.kap-action-btn:hover {
  background: var(--ink);
  color: var(--paper);
  border-color: var(--ink);
}
.kap-action-btn svg { width: 12px; height: 12px; }

.pagination {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-top: 2.5rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--line);
  flex-wrap: wrap;
}
.pagination .count {
  font-family: var(--mono);
  font-size: 0.6875rem;
  color: var(--muted);
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
.pagination .count strong { color: var(--ink); font-weight: 600; }
.page-nums { display: inline-flex; gap: 4px; }
.page-nums button {
  width: 36px;
  height: 36px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-family: var(--mono);
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--text);
  border: 1px solid var(--line);
  background: var(--paper);
  transition: all var(--t-fast) var(--ease);
  font-variant-numeric: tabular-nums;
  cursor: pointer;
}
.page-nums button:hover:not(:disabled) { border-color: var(--ink); }
.page-nums button.active {
  background: var(--ink);
  color: var(--paper);
  border-color: var(--ink);
}
.page-nums button:disabled { color: var(--muted); cursor: not-allowed; }
.page-nums .gap { border: none; color: var(--muted); cursor: default; }

@media (max-width: 980px) { .sec-head { grid-template-columns: 1fr; } }
@media (max-width: 720px) {
  .kap-row { grid-template-columns: 1fr; gap: 0.625rem; padding: 1.25rem 0.5rem; }
  .kap-row .action { justify-content: flex-start; }
  .kap-filters { padding: 1rem; }
  .kap-count { margin-left: 0; }
}
</style>

<script>
  // Filter pill cosmetic toggle — gerçek filtering Faz 7'de Pagefind ile
  document.querySelectorAll('.pill-group').forEach((group) => {
    group.querySelectorAll('button').forEach((b) => {
      b.addEventListener('click', () => {
        group.querySelectorAll('button').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
      });
    });
  });
</script>
