---
/**
 * FinancialReportsGrid — yıl bazlı çeyrek + yıllık rapor kartları
 * VERİ: src/content/financial-reports/ (WP'den migrate, ~13 PDF)
 */
import { getCollection } from 'astro:content';
import { getLocale, formatBytes, type Locale } from '../../lib/i18n';

const locale: Locale = getLocale(Astro.url.pathname);

const t = locale === 'tr' ? {
  marker: 'Finansal Raporlar',
  h2a: 'Çeyreklik ve yıllık',
  h2em: 'finansal tablolar',
  h2post: '.',
  detail: 'Bağımsız denetim ilkeleri',
  cari: 'Cari Dönem',
  done: 'Tamamlandı',
  published: 'Yayınlanan',
  pendingShort: 'Bekleniyor',
  qNames: { Q1: 'Q1', Q2: 'Q2', Q3: 'Q3', Q4: 'Q4', annual: 'Yıllık' },
  pendingDates: { Q1: 'Mayıs', Q2: 'Ağustos', Q3: 'Kasım', Q4: 'Şubat', annual: 'Mart' },
  archiveLink: 'Eski yıllar (2022 öncesi)',
} : {
  marker: 'Financial Reports',
  h2a: 'Quarterly and annual',
  h2em: 'financial statements',
  h2post: '.',
  detail: 'Independent audit principles',
  cari: 'Current Period',
  done: 'Completed',
  published: 'Published',
  pendingShort: 'Pending',
  qNames: { Q1: 'Q1', Q2: 'Q2', Q3: 'Q3', Q4: 'Q4', annual: 'Annual' },
  pendingDates: { Q1: 'May', Q2: 'Aug', Q3: 'Nov', Q4: 'Feb', annual: 'Mar' },
  archiveLink: 'Older years (pre-2022)',
};

// Gerçek finansal raporları çek
const all = await getCollection('financial-reports', (e) => e.data.lang === locale);

// Yıllara göre grupla
type Q = 'Q1' | 'Q2' | 'Q3' | 'Q4' | 'annual';
const quarterOrder: Q[] = ['Q1', 'Q2', 'Q3', 'Q4', 'annual'];

interface YearData {
  year: number;
  status: 'current' | 'done';
  pub: number;
  total: number;
  quarters: Map<Q, { date: string; size?: number; url: string } | null>;
}

const byYear = new Map<number, Map<Q, { date: string; size?: number; url: string }>>();
for (const item of all) {
  const y = item.data.year;
  const q = item.data.quarter as Q;
  if (!byYear.has(y)) byYear.set(y, new Map());
  byYear.get(y)!.set(q, {
    date: new Intl.DateTimeFormat(locale === 'tr' ? 'tr-TR' : 'en-US').format(item.data.publishDate),
    size: item.data.pdfSizeBytes,
    url: item.data.pdfUrl,
  });
}

// Cari yıl: en yenisi
const sortedYears = [...byYear.keys()].sort((a, b) => b - a);
const currentYear = sortedYears[0] ?? new Date().getFullYear();

const years: YearData[] = sortedYears.slice(0, 4).map((y) => {
  const map = byYear.get(y)!;
  const quarterMap = new Map<Q, { date: string; size?: number; url: string } | null>();
  for (const q of quarterOrder) {
    quarterMap.set(q, map.get(q) ?? null);
  }
  const pub = [...map.values()].length;
  return {
    year: y,
    status: y === currentYear && pub < 5 ? 'current' : 'done',
    pub,
    total: y === currentYear ? 5 : 5,
    quarters: quarterMap,
  };
});

// Octave function for rendering
function getQuarter(yd: YearData, q: Q) {
  return yd.quarters.get(q);
}
---

<section class="finrep-section" id="financial">
  <div class="container">

    <div class="sec-head">
      <div>
        <div class="section-marker" style="margin-bottom: 1rem;">
          <span class="num">04</span><span class="of">/</span><span>07</span><span class="dash">—</span><span class="label">{t.marker}</span>
        </div>
        <h2>{t.h2a}<br><em>{t.h2em}</em>{t.h2post}</h2>
      </div>
      <a href="#" class="link-arrow">{t.detail} <span class="arrow" aria-hidden="true">→</span></a>
    </div>

    <div class="year-grid">
      {years.map((y) => (
        <article class="year-card">
          <div class="year-card-head">
            <div class="year-card-num">
              {y.year}
              {y.status === 'current' && <span class="current">{t.cari}</span>}
            </div>
            <div class="year-card-status">
              {y.status === 'current' ? t.published : t.done}<br>
              <strong>{y.pub} / {y.total}</strong>
            </div>
          </div>
          <div class="quarter-grid">
            {(['Q1', 'Q2', 'Q3', 'Q4'] as const).map((q) => {
              const item = getQuarter(y, q);
              return item ? (
                <a href={item.url} target="_blank" rel="noopener" class="quarter-card">
                  <span class="q-name">{t.qNames[q]}</span>
                  <span class="q-date">{item.date}</span>
                  <span class="q-meta">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                    PDF · {item.size ? formatBytes(item.size, locale) : '?'}
                  </span>
                </a>
              ) : (
                <span class="quarter-card empty">
                  <span class="q-name">{t.qNames[q]}</span>
                  <span class="q-date">{t.pendingShort}</span>
                  <span class="q-meta">{t.pendingDates[q]}</span>
                </span>
              );
            })}
            {(() => {
              const item = getQuarter(y, 'annual');
              return item ? (
                <a href={item.url} target="_blank" rel="noopener" class="quarter-card annual">
                  <span class="q-name">{t.qNames.annual}</span>
                  <span class="q-date">{item.date}</span>
                  <span class="q-meta">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                    PDF · {item.size ? formatBytes(item.size, locale) : '?'}
                  </span>
                </a>
              ) : (
                <span class="quarter-card annual empty">
                  <span class="q-name">{t.qNames.annual}</span>
                  <span class="q-date">{t.pendingShort}</span>
                  <span class="q-meta">{t.pendingDates.annual}</span>
                </span>
              );
            })()}
          </div>
        </article>
      ))}
    </div>

    {sortedYears.length > 4 && (
      <div style="display: flex; justify-content: center; margin-top: 2.5rem;">
        <a href="#" class="link-arrow" style="font-size: 1rem;">{t.archiveLink} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    )}

  </div>
</section>

<style>
.finrep-section { background: var(--paper-soft); padding: var(--section-y) 0; }

.sec-head {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 2rem;
  align-items: end;
  margin-bottom: 3rem;
}
.sec-head h2 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 96, "SOFT" 65, "wght" 420;
  font-size: clamp(1.875rem, 3.6vw, 2.75rem);
  line-height: 1.05;
  letter-spacing: -0.022em;
  color: var(--ink);
}
.sec-head h2 em {
  font-style: italic;
  font-variation-settings: "opsz" 96, "SOFT" 100, "wght" 380;
  color: var(--terracotta);
}

.year-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
}
.year-card {
  background: var(--paper);
  border: 1px solid var(--line);
  padding: 1.75rem;
  transition: all var(--t-med) var(--ease);
}
.year-card:hover {
  border-color: var(--ink);
  transform: translateY(-2px);
}
.year-card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 1.5rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid var(--line);
}
.year-card-num {
  font-family: var(--serif);
  font-variation-settings: "opsz" 144, "SOFT" 60, "wght" 420;
  font-size: clamp(2.5rem, 4vw, 3.25rem);
  line-height: 1;
  color: var(--ink);
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
}
.year-card-num .current {
  font-family: var(--mono);
  font-size: 0.5rem;
  letter-spacing: 0.18em;
  color: var(--terracotta);
  text-transform: uppercase;
  font-weight: 600;
  vertical-align: super;
  margin-left: 0.5rem;
}
.year-card-status {
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
  text-align: right;
}
.year-card-status strong { color: var(--ink); }

.quarter-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr) auto;
  gap: 0.625rem;
}
.quarter-card {
  display: flex;
  flex-direction: column;
  background: var(--sand);
  padding: 1rem 0.875rem 0.875rem;
  transition: all var(--t-fast) var(--ease);
  border: 1px solid transparent;
  text-align: left;
}
.quarter-card:not(.empty):hover {
  background: var(--terracotta-soft);
  border-color: var(--terracotta);
}
.quarter-card.empty {
  background: transparent;
  border: 1px dashed var(--line);
  color: var(--muted);
  cursor: not-allowed;
}
.quarter-card .q-name {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 0.5rem;
}
.quarter-card .q-date {
  font-family: var(--mono);
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 0.875rem;
  letter-spacing: 0.04em;
}
.quarter-card.empty .q-date { color: var(--muted); }
.quarter-card .q-meta {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.08em;
  color: var(--muted);
  margin-top: auto;
  display: flex;
  align-items: center;
  gap: 0.375rem;
}
.quarter-card .q-meta svg { width: 10px; height: 10px; color: var(--terracotta); }
.quarter-card.annual {
  background: var(--ink);
  color: var(--paper);
  min-width: 110px;
}
.quarter-card.annual:hover { background: var(--terracotta); }
.quarter-card.annual .q-name { color: rgba(247, 244, 238, 0.5); }
.quarter-card.annual .q-date { color: var(--paper); }
.quarter-card.annual .q-meta { color: rgba(247, 244, 238, 0.65); }
.quarter-card.annual .q-meta svg { color: var(--terracotta-warm); }
.quarter-card.annual.empty {
  background: transparent;
  color: var(--muted);
  border: 1px dashed var(--line);
}
.quarter-card.annual.empty .q-name { color: var(--muted); }
.quarter-card.annual.empty .q-date { color: var(--muted); }

@media (max-width: 980px) {
  .sec-head { grid-template-columns: 1fr; }
  .year-grid { grid-template-columns: 1fr; }
  .quarter-grid { grid-template-columns: repeat(3, 1fr); }
  .quarter-grid .annual { grid-column: span 3; }
}
@media (max-width: 720px) {
  .quarter-grid { grid-template-columns: 1fr 1fr; }
  .quarter-grid .annual { grid-column: span 2; }
}
@media (max-width: 480px) {
  .quarter-grid { grid-template-columns: 1fr; }
  .quarter-grid .annual { grid-column: span 1; }
}
</style>
