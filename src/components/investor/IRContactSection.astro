---
/**
 * IRContactSection — IR İletişim + Newsletter (2 kart yan yana)
 */
import { getLocale } from '../../lib/i18n';
const locale = getLocale(Astro.url.pathname);

const t = locale === 'tr' ? {
  marker: 'Yatırımcı İletişim',
  h2a: 'Sorunuz mu var?',
  h2em: 'Yazın',
  h2post: '.',
  contactLbl: '● Yatırımcı İlişkileri Birimi',
  contactH3a: 'Doğrudan',
  contactH3em: 'iletişim',
  contactH3post: '.',
  email: 'yatirimci@sanicaisi.com.tr',
  phone: '+90 212 855 80 80',
  address: 'Kavaklı Mah. İstanbul Cad. No:10 · 34520 Beylikdüzü/İstanbul',
  newsLbl: '● Yatırımcı Bildirim Servisi',
  newsH3a: 'KAP & raporlar,',
  newsH3em: 'e-postanıza',
  newsH3post: '.',
  newsP: 'Her KAP açıklaması, finansal rapor ve sürdürülebilirlik dökümanı yayınlandığında posta kutunuza düşsün. Spam yok, sadece yayınlanan dökümanlar.',
  placeholder: 'E-posta adresiniz',
  button: 'Abone Ol',
  fine: 'KVKK ve aydınlatma metni kapsamında işlenir. Tek tıkla aboneliği sonlandırabilirsiniz.',
  emailAria: 'E-posta adresi',
} : {
  marker: 'Investor Contact',
  h2a: 'Have a question?',
  h2em: 'Write',
  h2post: '.',
  contactLbl: '● Investor Relations Unit',
  contactH3a: 'Direct',
  contactH3em: 'contact',
  contactH3post: '.',
  email: 'yatirimci@sanicaisi.com.tr',
  phone: '+90 212 855 80 80',
  address: 'Kavaklı Mah. İstanbul Cad. No:10 · 34520 Beylikdüzü/İstanbul',
  newsLbl: '● Investor Notification Service',
  newsH3a: 'PDP & reports,',
  newsH3em: 'to your inbox',
  newsH3post: '.',
  newsP: 'Every PDP disclosure, financial report and sustainability document delivered to your inbox upon publication. No spam, only published documents.',
  placeholder: 'Your email address',
  button: 'Subscribe',
  fine: 'Processed under GDPR and privacy notice. Unsubscribe in one click.',
  emailAria: 'Email address',
};
---

<section class="contact-section" id="contact">
  <div class="container">

    <div class="sec-head">
      <div>
        <div class="section-marker" style="margin-bottom: 1rem;">
          <span class="num">07</span><span class="of">/</span><span>07</span><span class="dash">—</span><span class="label">{t.marker}</span>
        </div>
        <h2>{t.h2a} <em>{t.h2em}</em>{t.h2post}</h2>
      </div>
    </div>

    <div class="contact-grid">

      <article class="ir-contact-card">
        <span class="lbl">{t.contactLbl}</span>
        <h3>{t.contactH3a} <em>{t.contactH3em}</em>{t.contactH3post}</h3>

        <div class="ir-contact-list">
          <a href={`mailto:${t.email}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 6-10 7L2 6" /></svg>
            {t.email}
          </a>
          <a href={`tel:${t.phone.replace(/[^+\d]/g, '')}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z" /></svg>
            {t.phone}
          </a>
          <a href="#">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 1 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
            {t.address}
          </a>
        </div>
      </article>

      <article class="subscribe-card">
        <span class="lbl">{t.newsLbl}</span>
        <h3>{t.newsH3a} <em>{t.newsH3em}</em>{t.newsH3post}</h3>
        <p>{t.newsP}</p>

        <form class="subscribe-form" action="/api/newsletter" method="post">
          <input
            type="email"
            name="email"
            placeholder={t.placeholder}
            aria-label={t.emailAria}
            required
            autocomplete="email"
          />
          <button type="submit">{t.button} <span aria-hidden="true">→</span></button>
        </form>
        <p class="subscribe-fine">{t.fine}</p>
      </article>

    </div>
  </div>
</section>

<style>
.contact-section { background: var(--paper); padding: var(--section-y) 0; }

.sec-head { margin-bottom: 3rem; }
.sec-head h2 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 96, "SOFT" 65, "wght" 420;
  font-size: clamp(1.875rem, 3.6vw, 2.75rem);
  line-height: 1.05;
  letter-spacing: -0.022em;
  color: var(--ink);
}
.sec-head h2 em {
  font-style: italic;
  font-variation-settings: "opsz" 96, "SOFT" 100, "wght" 380;
  color: var(--terracotta);
}

.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(2rem, 5vw, 4rem);
}

.ir-contact-card {
  background: var(--sand);
  padding: 2.5rem 2.25rem;
  position: relative;
}
.ir-contact-card .lbl {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--terracotta);
  margin-bottom: 1rem;
  display: block;
  font-weight: 600;
}
.ir-contact-card h3 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 96, "SOFT" 65, "wght" 460;
  font-size: clamp(1.5rem, 2.4vw, 2rem);
  line-height: 1.15;
  letter-spacing: -0.015em;
  color: var(--ink);
  margin-bottom: 1.5rem;
}
.ir-contact-card h3 em {
  font-style: italic;
  font-variation-settings: "opsz" 96, "SOFT" 100, "wght" 380;
  color: var(--terracotta);
}

.ir-contact-list {
  margin-top: 1.5rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--sand-deep);
  display: flex;
  flex-direction: column;
  gap: 0.875rem;
  font-family: var(--mono);
  font-size: 0.875rem;
  letter-spacing: 0.02em;
}
.ir-contact-list a {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  color: var(--text);
  transition: color var(--t-fast) var(--ease);
  font-variant-numeric: tabular-nums;
}
.ir-contact-list a:hover { color: var(--terracotta); }
.ir-contact-list svg {
  width: 14px;
  height: 14px;
  color: var(--terracotta);
  flex-shrink: 0;
}

.subscribe-card {
  background: var(--ink);
  color: var(--paper);
  padding: 2.5rem 2.25rem;
  position: relative;
  overflow: hidden;
}
.subscribe-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 50% 60% at 80% 30%, rgba(184,57,12,0.18) 0%, transparent 55%);
  pointer-events: none;
}
.subscribe-card .lbl {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--terracotta-warm);
  margin-bottom: 1rem;
  display: block;
  font-weight: 600;
  position: relative;
}
.subscribe-card h3 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 96, "SOFT" 65, "wght" 460;
  font-size: clamp(1.5rem, 2.4vw, 2rem);
  line-height: 1.15;
  letter-spacing: -0.015em;
  color: var(--paper);
  margin-bottom: 1rem;
  position: relative;
}
.subscribe-card h3 em {
  font-style: italic;
  color: var(--terracotta-warm);
  font-variation-settings: "opsz" 96, "SOFT" 100, "wght" 380;
}
.subscribe-card p {
  color: rgba(247, 244, 238, 0.7);
  font-size: 0.9375rem;
  line-height: 1.55;
  margin-bottom: 1.75rem;
  max-width: 380px;
  position: relative;
}

.subscribe-form {
  display: flex;
  gap: 0.5rem;
  background: rgba(247, 244, 238, 0.06);
  border: 1px solid rgba(247, 244, 238, 0.15);
  padding: 0.5rem;
  border-radius: 2px;
  transition: border-color var(--t-fast) var(--ease);
  position: relative;
}
.subscribe-form:focus-within { border-color: var(--terracotta-warm); }
.subscribe-form input {
  flex: 1;
  background: transparent;
  border: none;
  padding: 0.75rem 0.875rem;
  color: var(--paper);
  font-size: 0.9375rem;
  outline: none;
  min-width: 0;
}
.subscribe-form input::placeholder { color: rgba(247, 244, 238, 0.45); }
.subscribe-form button {
  background: var(--terracotta);
  color: var(--paper);
  font-size: 0.875rem;
  font-weight: 500;
  padding: 0.75rem 1.25rem;
  border-radius: 2px;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  transition: background var(--t-fast) var(--ease);
  white-space: nowrap;
  cursor: pointer;
  border: none;
}
.subscribe-form button:hover { background: var(--terracotta-warm); }

.subscribe-fine {
  margin-top: 1rem;
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.06em;
  color: rgba(247, 244, 238, 0.45);
  line-height: 1.6;
  position: relative;
}

@media (max-width: 980px) {
  .contact-grid { grid-template-columns: 1fr; }
}
</style>
