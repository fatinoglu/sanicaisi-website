---
/**
 * IRSectionCards — IR ana sayfasında 4 büyük bölüm kartı
 * Halka Arz · Kurumsal Yönetim · Raporlar · Kamuyu Aydınlatma
 */
import { getLocale, localizedUrl, type Locale } from '../../lib/i18n';
const locale: Locale = getLocale(Astro.url.pathname);

const base = locale === 'tr' ? '/yatirimci-iliskileri' : '/investor-relations';

const t = locale === 'tr' ? {
  marker: 'Bölümler · Sections',
  h2a: 'Tek tıkla,',
  h2em: 'bütün bilgi',
  h2b: '.',
  intro: 'Yatırımcı belgelerimiz dört ana başlıkta toplandı. Her bölüm, Sermaye Piyasası mevzuatına ve KAP yükümlülüklerine uygun olarak güncel tutulur.',
  cards: [
    {
      idx: '01',
      title: 'Halka Arz',
      sub: 'IPO documents',
      body: 'İzahname, fiyat tespit raporu, hukuk ve denetim raporları ile fon kullanım belgeleri.',
      href: '/halka-arz',
      bullets: ['İzahname', 'Tasarruf Sahiplerine Satış Duyurusu', 'Fiyat Tespit Raporu', 'Fon Kullanım Yeri Raporu'],
    },
    {
      idx: '02',
      title: 'Kurumsal Yönetim',
      sub: 'Corporate governance',
      body: 'Yönetim kurulu, ortaklık yapısı, komiteler, politikalar, genel kurullar ve esas sözleşme.',
      href: '/kurumsal-yonetim',
      bullets: ['Yönetim Kurulu', 'Ortaklık Yapısı', 'Komiteler & Politikalar', 'Genel Kurullar'],
    },
    {
      idx: '03',
      title: 'Raporlar',
      sub: 'Reports',
      body: 'Finansal raporlar, faaliyet raporları, uyum raporları ve sürdürülebilirlik dokümanları.',
      href: '/raporlar',
      bullets: ['Finansal Raporlar', 'Faaliyet Raporları', 'Uyum Raporları', 'Sürdürülebilirlik'],
    },
    {
      idx: '04',
      title: 'Kamuyu Aydınlatma',
      sub: 'Public disclosures',
      body: 'KAP üzerinden yayınlanan özel durum açıklamalarının kronolojik arşivi.',
      href: '/kamuyu-aydinlatma',
      bullets: ['Özel Durum Açıklamaları', 'KAP Bildirimleri', 'Kategori Filtresi', 'Yıllık Arşiv'],
    },
  ],
  cta: 'Bölüme git',
} : {
  marker: 'Sections · Bölümler',
  h2a: 'All information,',
  h2em: 'one click away',
  h2b: '.',
  intro: 'Our investor documents are organised in four main sections, kept up to date in line with Capital Markets Board regulations and PDP obligations.',
  cards: [
    {
      idx: '01',
      title: 'IPO',
      sub: 'Halka Arz',
      body: 'Prospectus, price determination report, legal and audit reports, fund usage documents.',
      href: '/ipo',
      bullets: ['Prospectus', 'Public Offering Notice', 'Price Determination Report', 'Fund Usage Report'],
    },
    {
      idx: '02',
      title: 'Corporate Governance',
      sub: 'Kurumsal Yönetim',
      body: 'Board, ownership structure, committees, policies, general assemblies and articles of association.',
      href: '/governance',
      bullets: ['Board of Directors', 'Ownership Structure', 'Committees & Policies', 'General Assemblies'],
    },
    {
      idx: '03',
      title: 'Reports',
      sub: 'Raporlar',
      body: 'Financial reports, annual reports, compliance reports and sustainability documents.',
      href: '/reports',
      bullets: ['Financial Reports', 'Annual Reports', 'Compliance Reports', 'Sustainability'],
    },
    {
      idx: '04',
      title: 'Public Disclosures',
      sub: 'Kamuyu Aydınlatma',
      body: 'Chronological archive of PDP filings (material disclosures).',
      href: '/disclosures',
      bullets: ['Material Disclosures', 'PDP Filings', 'Category Filter', 'Annual Archive'],
    },
  ],
  cta: 'Open section',
};
---

<section id="sections" class="ir-sections">
  <div class="container">
    <div class="head">
      <div>
        <div class="section-marker">
          <span class="num">02</span><span class="of">/</span><span>06</span><span class="dash">—</span><span class="label">{t.marker}</span>
        </div>
        <h2>{t.h2a} <em>{t.h2em}</em>{t.h2b}</h2>
      </div>
      <p class="intro">{t.intro}</p>
    </div>

    <div class="grid">
      {t.cards.map((c) => (
        <a class="card" href={localizedUrl(locale, `${base}${c.href}`)}>
          <div class="card-top">
            <span class="idx">{c.idx}</span>
            <div>
              <h3>{c.title}</h3>
              <span class="sub">{c.sub}</span>
            </div>
          </div>
          <p class="body">{c.body}</p>
          <ul>
            {c.bullets.map((b) => <li>{b}</li>)}
          </ul>
          <span class="cta">{t.cta} <span class="arrow" aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
.ir-sections { background: var(--paper-soft); padding: var(--section-y) 0; }

.head {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 4rem;
  align-items: end;
  margin-bottom: 3rem;
}
.head .section-marker .num { color: var(--bist-navy); }
.head h2 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 96, "SOFT" 65, "wght" 420;
  font-size: clamp(1.875rem, 3.6vw, 2.875rem);
  line-height: 1.08;
  letter-spacing: -0.022em;
  color: var(--ink);
  margin-top: 1rem;
  max-width: 560px;
}
.head h2 em {
  font-style: italic;
  font-variation-settings: "opsz" 96, "SOFT" 100, "wght" 380;
  color: var(--bist-navy);
}
.head .intro {
  font-size: 1rem;
  line-height: 1.6;
  color: var(--muted);
  max-width: 460px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.25rem;
}
.card {
  background: var(--paper);
  border: 1px solid var(--line);
  border-top: 3px solid var(--bist-navy);
  padding: 2rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  color: inherit;
  transition: transform var(--t-med) var(--ease), border-color var(--t-med) var(--ease), box-shadow var(--t-med) var(--ease);
}
.card:hover {
  transform: translateY(-4px);
  border-color: var(--bist-navy);
  box-shadow: 0 18px 36px -18px rgba(26, 43, 71, 0.28);
}
.card-top { display: flex; align-items: baseline; gap: 1rem; }
.idx {
  font-family: var(--mono);
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.18em;
  color: var(--bist-navy);
}
.card h3 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 72, "SOFT" 55, "wght" 500;
  font-size: 1.5rem;
  letter-spacing: -0.018em;
  color: var(--ink);
}
.sub {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--muted);
}
.card .body {
  font-size: 0.9375rem;
  line-height: 1.55;
  color: var(--text);
}
.card ul {
  list-style: none;
  padding: 0;
  margin: 0;
  border-top: 1px solid var(--line);
  padding-top: 1rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.5rem 1rem;
  flex: 1;
}
.card li {
  font-size: 0.8125rem;
  line-height: 1.4;
  color: var(--muted);
  padding-left: 1rem;
  position: relative;
}
.card li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0.5rem;
  width: 5px;
  height: 5px;
  background: var(--bist-navy);
  opacity: 0.6;
}
.cta {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--mono);
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ink);
  margin-top: 0.5rem;
}
.cta .arrow { transition: transform var(--t-med) var(--ease-out); }
.card:hover .cta { color: var(--bist-navy); }
.card:hover .cta .arrow { transform: translateX(4px); }

@media (max-width: 980px) {
  .head { grid-template-columns: 1fr; gap: 1.5rem; }
  .grid { grid-template-columns: 1fr; }
  .card ul { grid-template-columns: 1fr; }
}
</style>
