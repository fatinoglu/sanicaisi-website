---
/**
 * InvestorSubnav — sticky sub-navigation for IR sections
 * Header altında yapışır, scroll'a göre aktif bölüm otomatik vurgulanır
 */
import { getLocale } from '../../lib/i18n';
const locale = getLocale(Astro.url.pathname);

const t = locale === 'tr' ? {
  label: 'Bölümler',
  items: [
    { href: '#performance', text: 'Hisse Performansı' },
    { href: '#kap', text: 'KAP Açıklamaları' },
    { href: '#financial', text: 'Finansal Raporlar' },
    { href: '#annual', text: 'Faaliyet Raporları' },
    { href: '#capital', text: 'Sermaye Yapısı' },
    { href: '#contact', text: 'İletişim' },
  ],
} : {
  label: 'Sections',
  items: [
    { href: '#performance', text: 'Stock Performance' },
    { href: '#kap', text: 'PDP Disclosures' },
    { href: '#financial', text: 'Financial Reports' },
    { href: '#annual', text: 'Annual Reports' },
    { href: '#capital', text: 'Capital Structure' },
    { href: '#contact', text: 'Contact' },
  ],
};
---

<nav class="subnav" aria-label={locale === 'tr' ? 'Yatırımcı sayfa içi navigasyon' : 'Investor page navigation'}>
  <div class="container">
    <div class="subnav-inner">
      <span class="subnav-label">{t.label}</span>
      {t.items.map((it, i) => (
        <a href={it.href} class:list={[{ 'is-active': i === 0 }]}>{it.text}</a>
      ))}
    </div>
  </div>
</nav>

<script>
  // Scrollspy — subnav linklerinin aktif state'ini scroll konumuna göre günceller
  const subnavLinks = Array.from(document.querySelectorAll('.subnav a')) as HTMLAnchorElement[];
  const sections = Array.from(document.querySelectorAll('section[id]')) as HTMLElement[];

  function updateActive() {
    const scrollY = window.scrollY + 240; // header + subnav offset
    let activeId = sections[0]?.id;
    for (const s of sections) {
      if (s.offsetTop <= scrollY) activeId = s.id;
    }
    for (const a of subnavLinks) {
      const href = a.getAttribute('href') ?? '';
      a.classList.toggle('is-active', href === '#' + activeId);
    }
  }

  window.addEventListener('scroll', updateActive, { passive: true });
  updateActive();

  // Smooth anchor scroll
  for (const a of subnavLinks) {
    a.addEventListener('click', (e) => {
      const id = a.getAttribute('href');
      if (!id || id.length < 2) return;
      const el = document.querySelector(id);
      if (el) {
        e.preventDefault();
        (el as HTMLElement).scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  }
</script>

<style>
.subnav {
  position: sticky;
  top: var(--header-h);
  z-index: 60;
  background: rgba(247, 244, 238, 0.9);
  backdrop-filter: saturate(180%) blur(16px);
  -webkit-backdrop-filter: saturate(180%) blur(16px);
  border-bottom: 1px solid var(--line);
  border-top: 1px solid var(--line);
}
.subnav-inner {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  height: var(--subnav-h);
  overflow-x: auto;
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.subnav-inner::-webkit-scrollbar { display: none; }
.subnav-label {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--terracotta);
  font-weight: 600;
  white-space: nowrap;
  padding-right: 0.5rem;
  border-right: 1px solid var(--line);
}
.subnav a {
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--muted);
  white-space: nowrap;
  padding: 0.5rem 0;
  position: relative;
  transition: color var(--t-fast) var(--ease);
}
.subnav a::after {
  content: '';
  position: absolute;
  inset: auto 0 0 0;
  height: 1.5px;
  background: var(--terracotta);
  width: 0;
  transition: width var(--t-med) var(--ease-out);
}
.subnav a.is-active,
.subnav a:hover { color: var(--ink); }
.subnav a.is-active::after { width: 100%; }

@media (max-width: 980px) {
  .subnav { top: var(--main-nav-h); }
}
</style>
