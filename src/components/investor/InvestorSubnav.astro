---
/**
 * InvestorSubnav — IR alt sayfalar arası sticky gezinti
 * 4 ana sekme: Halka Arz, Kurumsal Yönetim, Raporlar, Kamuyu Aydınlatma
 * + Hub için "Genel Bakış" girişi
 */
import { getLocale, localizedUrl, type Locale } from '../../lib/i18n';

interface Props {
  current?: 'overview' | 'halka-arz' | 'kurumsal-yonetim' | 'raporlar' | 'kamuyu-aydinlatma';
}
const { current = 'overview' } = Astro.props;
const locale: Locale = getLocale(Astro.url.pathname);

const base = locale === 'tr' ? '/yatirimci-iliskileri' : '/investor-relations';

const t = locale === 'tr' ? {
  label: 'Bölümler',
  items: [
    { key: 'overview', text: 'Genel Bakış', href: '' },
    { key: 'halka-arz', text: 'Halka Arz', href: '/halka-arz' },
    { key: 'kurumsal-yonetim', text: 'Kurumsal Yönetim', href: '/kurumsal-yonetim' },
    { key: 'raporlar', text: 'Raporlar', href: '/raporlar' },
    { key: 'kamuyu-aydinlatma', text: 'Kamuyu Aydınlatma', href: '/kamuyu-aydinlatma' },
  ],
} : {
  label: 'Sections',
  items: [
    { key: 'overview', text: 'Overview', href: '' },
    { key: 'halka-arz', text: 'IPO', href: '/ipo' },
    { key: 'kurumsal-yonetim', text: 'Corporate Governance', href: '/governance' },
    { key: 'raporlar', text: 'Reports', href: '/reports' },
    { key: 'kamuyu-aydinlatma', text: 'Public Disclosures', href: '/disclosures' },
  ],
} as const;
---

<nav class="subnav" aria-label={locale === 'tr' ? 'Yatırımcı bölümleri' : 'Investor sections'}>
  <div class="container">
    <div class="subnav-inner">
      <span class="subnav-label">{t.label}</span>
      {t.items.map((it) => (
        <a
          href={localizedUrl(locale, `${base}${it.href}`)}
          class:list={[{ 'is-active': it.key === current }]}
        >
          {it.text}
        </a>
      ))}
    </div>
  </div>
</nav>

<style>
.subnav {
  position: sticky;
  top: var(--header-h);
  z-index: 60;
  background: rgba(247, 244, 238, 0.9);
  backdrop-filter: saturate(180%) blur(16px);
  -webkit-backdrop-filter: saturate(180%) blur(16px);
  border-bottom: 1px solid var(--line);
  border-top: 1px solid var(--line);
}
.subnav-inner {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  height: var(--subnav-h);
  overflow-x: auto;
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.subnav-inner::-webkit-scrollbar { display: none; }
.subnav-label {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--terracotta);
  font-weight: 600;
  white-space: nowrap;
  padding-right: 0.5rem;
  border-right: 1px solid var(--line);
}
.subnav a {
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--muted);
  white-space: nowrap;
  padding: 0.5rem 0;
  position: relative;
  transition: color var(--t-fast) var(--ease);
}
.subnav a::after {
  content: '';
  position: absolute;
  inset: auto 0 0 0;
  height: 1.5px;
  background: var(--terracotta);
  width: 0;
  transition: width var(--t-med) var(--ease-out);
}
.subnav a.is-active,
.subnav a:hover { color: var(--ink); }
.subnav a.is-active::after { width: 100%; }

@media (max-width: 980px) {
  .subnav { top: var(--main-nav-h); }
}
</style>
