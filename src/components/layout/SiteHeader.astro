---
/**
 * SiteHeader — sticky 2-layer header
 * UtilityBar (üst koyu) + MainNav (alt cream)
 *
 * showTicker: true sadece yatırımcı sayfalarında — BIST verisi gösterilir.
 */
import UtilityBar from './UtilityBar.astro';
import { getLocale, alternateLocaleUrl } from '../../lib/i18n';
import { mainNav, type SubNavItem } from '../../lib/nav';

interface Props {
  showTicker?: boolean;
  // activeAudience prop'u geriye dönük uyumluluk için kabul ediliyor; artık kullanılmıyor.
  activeAudience?: 'home' | 'pro' | 'investor';
  currentPath?: string;
}

const { showTicker = false, currentPath = Astro.url.pathname } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const nav = mainNav[locale];

const logoSrc = '/wp-content/uploads/2020/12/sanica-isi.png';
const homeHref = locale === 'tr' ? '/' : '/en/';

function isCurrent(href: string): boolean {
  // Tam eşleşme veya ana yol başlangıcı
  if (href === '/' || href === '/en/') return currentPath === href;
  return currentPath === href || currentPath.startsWith(href + '/');
}

// Her nav item için dropdown verisini önceden hesapla — Astro JSX expression
// parser'ı arrow body içinde for/if blokları kullanmayı sevmiyor.
type NavRender = {
  item: typeof nav[number];
  kind: 'link' | 'dropdown' | 'mega';
  groupEntries: [string, SubNavItem[]][];
};
const navItems: NavRender[] = nav.map((item) => {
  if (!item.submenu) return { item, kind: 'link', groupEntries: [] };
  const hasGroups = item.submenu.some((s) => !!s.group);
  if (!hasGroups) return { item, kind: 'dropdown', groupEntries: [] };

  const groupMap = new Map<string, SubNavItem[]>();
  for (const s of item.submenu) {
    const g = s.group ?? '';
    if (!groupMap.has(g)) groupMap.set(g, []);
    groupMap.get(g)!.push(s);
  }
  return { item, kind: 'mega', groupEntries: Array.from(groupMap.entries()) };
});
---

<header class="site-header">
  <UtilityBar showTicker={showTicker} />

  <div class="main-nav">
    <div class="container">
      <div class="main-nav-inner">

        <a href={homeHref} class="logo" aria-label="Sanica Isı">
          <img src={logoSrc} alt="Sanica Isı" width="160" height="42" />
        </a>

        <nav class="nav-center" aria-label={locale === 'tr' ? 'Ana navigasyon' : 'Main navigation'}>
          {navItems.map(({ item, kind, groupEntries }) => (
            kind === 'link' ? (
              <a href={item.href} class:list={['nav-link', { 'is-current': isCurrent(item.href) }]}>
                {item.label}
                {item.hasSubmenu && <span class="nav-caret" aria-hidden="true">▾</span>}
              </a>
            ) : (
              <div class:list={['nav-item has-dropdown', { 'is-mega': kind === 'mega' }]}>
                <a
                  href={item.href}
                  class:list={['nav-link', { 'is-current': isCurrent(item.href) }]}
                  aria-haspopup="true"
                  aria-expanded="false"
                >
                  {item.label}
                  <span class="nav-caret" aria-hidden="true">▾</span>
                </a>

                {kind === 'mega' ? (
                  <div class="nav-dropdown mega" role="menu" aria-label={item.label}>
                    <div class="mega-grid">
                      {groupEntries.map(([g, items]) => (
                        <div class="mega-col">
                          {g && <span class="mega-heading">{g}</span>}
                          <ul>
                            {items.map((s) => (
                              <li>
                                <a href={s.href} class:list={['dropdown-link', { 'is-current': isCurrent(s.href) }]} role="menuitem">
                                  <span class="dl-label">{s.label}</span>
                                  {s.description && <span class="dl-desc">{s.description}</span>}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </div>
                ) : (
                  <div class="nav-dropdown" role="menu" aria-label={item.label}>
                    <ul>
                      {item.submenu!.map((s) => (
                        <li>
                          <a href={s.href} class:list={['dropdown-link', { 'is-current': isCurrent(s.href) }]} role="menuitem">
                            <span class="dl-label">{s.label}</span>
                            {s.description && <span class="dl-desc">{s.description}</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            )
          ))}
        </nav>

        <div class="nav-right">
          <a href={locale === 'tr' ? '/bayi-portali' : '/en/dealer-portal'} class="btn-dealer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="7" width="18" height="13" rx="1" />
              <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
              <path d="M3 13h18" />
            </svg>
            {locale === 'tr' ? 'Bayi Portalı' : 'Dealer Portal'}
          </a>

          <button class="menu-toggle" aria-label={locale === 'tr' ? 'Menü' : 'Menu'}><span></span></button>
        </div>

      </div>
    </div>
  </div>
</header>

<style>
.site-header {
  position: sticky;
  top: 0;
  z-index: 80;
}

.main-nav {
  background: rgba(247, 244, 238, 0.88);
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  border-bottom: 1px solid var(--line);
}
.main-nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: var(--main-nav-h);
  gap: 2rem;
}

.logo {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
}
.logo img {
  height: 42px;
  width: auto;
  transition: opacity var(--t-fast) var(--ease);
}
.logo:hover img { opacity: 0.78; }

.nav-center {
  display: flex;
  align-items: center;
  gap: 1.875rem;
  flex: 1;
  justify-content: center;
}
.nav-link {
  position: relative;
  font-size: 0.9375rem;
  font-weight: 500;
  color: var(--text);
  padding: 0.5rem 0;
  display: inline-flex;
  align-items: center;
  gap: 0.3125rem;
  white-space: nowrap;
  transition: color var(--t-fast) var(--ease);
}
.nav-link::after {
  content: '';
  position: absolute;
  inset: auto 0 -2px 0;
  width: 0;
  height: 1.5px;
  background: var(--terracotta);
  transition: width var(--t-med) var(--ease-out);
}
.nav-link.is-current::after,
.nav-link:hover::after { width: 100%; }
.nav-link.is-current { color: var(--terracotta); }
.nav-caret { font-size: 0.5rem; color: var(--muted); transition: transform var(--t-fast) var(--ease); }
.nav-link:hover .nav-caret { transform: rotate(180deg); color: var(--terracotta); }

/* ── Dropdown ──────────────────────────────────────────── */
.nav-item.has-dropdown { position: relative; }

.nav-dropdown {
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%) translateY(8px);
  min-width: 320px;
  background: var(--paper);
  border: 1px solid var(--line);
  box-shadow: 0 18px 48px -16px rgba(0, 0, 0, 0.18), 0 4px 12px -6px rgba(0, 0, 0, 0.08);
  padding: 0.5rem;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity var(--t-fast) var(--ease), transform var(--t-fast) var(--ease), visibility var(--t-fast) var(--ease);
  z-index: 90;
}

/* Köprü alanı — caret ile dropdown arasındaki 8px boşlukta hover kaybolmasın */
.nav-dropdown::before {
  content: '';
  position: absolute;
  inset: -10px 0 auto 0;
  height: 12px;
}

.nav-item.has-dropdown:hover .nav-dropdown,
.nav-item.has-dropdown:focus-within .nav-dropdown {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: translateX(-50%) translateY(0);
}
.nav-item.has-dropdown:hover .nav-caret,
.nav-item.has-dropdown:focus-within .nav-caret {
  transform: rotate(180deg);
  color: var(--terracotta);
}

.nav-dropdown ul {
  list-style: none;
  display: flex;
  flex-direction: column;
}

.dropdown-link {
  display: flex;
  flex-direction: column;
  gap: 0.1875rem;
  padding: 0.6875rem 0.875rem;
  color: var(--ink);
  transition: background var(--t-fast) var(--ease), color var(--t-fast) var(--ease);
  border-radius: 2px;
}
.dropdown-link:hover,
.dropdown-link:focus-visible {
  background: var(--sand);
  outline: none;
}
.dropdown-link.is-current { color: var(--terracotta); background: var(--sand); }

.dl-label {
  font-size: 0.9375rem;
  font-weight: 500;
  letter-spacing: -0.005em;
}
.dl-desc {
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.02em;
  color: var(--muted);
  line-height: 1.4;
}
.dropdown-link:hover .dl-desc,
.dropdown-link:focus-visible .dl-desc { color: var(--text); }

/* ── Mega menu (Ürünler) ──────────────────────────────── */
/* parent .nav-item.has-dropdown zaten relative — `static` yapmıyoruz ki
   dropdown link'in tam altına konumlansın ve hover bridge çalışsın. */
.nav-dropdown.mega {
  left: 50%;
  right: auto;
  transform: translateX(-50%) translateY(8px);
  width: min(1080px, calc(100vw - 2rem));
  padding: 1.25rem 1.5rem 1.375rem;
}
.nav-item.has-dropdown.is-mega:hover .nav-dropdown.mega,
.nav-item.has-dropdown.is-mega:focus-within .nav-dropdown.mega {
  transform: translateX(-50%) translateY(0);
}
/* Mega menü için 8px translateY boşluğunu kapatan hover-bridge (klasik dropdown'dakinden daha geniş). */
.nav-dropdown.mega::before {
  inset: -14px 0 auto 0;
  height: 16px;
}
.mega-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.5rem 2rem;
}
.mega-col { display: flex; flex-direction: column; }
.mega-heading {
  font-family: var(--mono);
  font-size: 0.625rem;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--terracotta);
  padding: 0 0.875rem 0.625rem;
  border-bottom: 1px solid var(--line);
  margin-bottom: 0.375rem;
}
.mega-col ul { display: flex; flex-direction: column; }

.nav-right { display: flex; align-items: center; gap: 1rem; flex-shrink: 0; }

.btn-dealer {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: var(--terracotta);
  color: var(--paper);
  padding: 0.625rem 1rem;
  font-size: 0.875rem;
  font-weight: 500;
  border-radius: 2px;
  transition: all var(--t-med) var(--ease);
  white-space: nowrap;
}
.btn-dealer:hover {
  background: var(--terracotta-deep);
  transform: translateY(-1px);
  box-shadow: 0 8px 20px -6px rgba(184, 57, 12, 0.5);
}
.btn-dealer svg { width: 14px; height: 14px; }

.menu-toggle {
  display: none;
  width: 44px;
  height: 44px;
  align-items: center;
  justify-content: center;
}
.menu-toggle span {
  width: 22px; height: 1.5px;
  background: var(--ink);
  position: relative;
  display: block;
}
.menu-toggle span::before, .menu-toggle span::after {
  content: '';
  position: absolute;
  left: 0; width: 22px; height: 1.5px;
  background: var(--ink);
}
.menu-toggle span::before { top: -7px; }
.menu-toggle span::after { top: 7px; }

@media (max-width: 1200px) {
  .nav-center { gap: 1.25rem; }
  .nav-link { font-size: 0.875rem; }
}
@media (max-width: 980px) {
  .nav-center { display: none; }
  .menu-toggle { display: inline-flex; }
}
@media (max-width: 720px) {
  .main-nav-inner { height: 72px; }
}
</style>
