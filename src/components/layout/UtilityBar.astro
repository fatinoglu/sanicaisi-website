---
/**
 * UtilityBar — header'ın üst koyu bandı
 *
 * showTicker=true ise yatırımcı bağlamlı sade bir BIST tag'i + KAP linki gösterir.
 * (Canlı fiyat beslemesi Faz 7'de geldiğinde gerçek ticker'a dönüştürülecek.)
 */
import { getLocale, alternateLocaleUrl } from '../../lib/i18n';
import { utilityNav } from '../../lib/nav';

interface Props {
  showTicker?: boolean;
}
const { showTicker = false } = Astro.props;

const locale = getLocale(Astro.url.pathname);
const items = utilityNav[locale];
const alt = alternateLocaleUrl(locale, Astro.url.pathname);
const altHint = !alt.isAvailable
  ? (locale === 'tr' ? 'İngilizce karşılığı yok — ana sayfaya yönlendirilir' : 'No Turkish version — homepage fallback')
  : undefined;

const tickerLabel = locale === 'tr'
  ? 'BIST · SNICA · Yıldız Pazar'
  : 'BIST · SNICA · Star Market';
const kapLabel = locale === 'tr' ? 'KAP\'ta gör' : 'View on PDP';
const quietLabel = locale === 'tr'
  ? 'SANICA ISI · BIST: SNICA · Yıldız Pazar'
  : 'SANICA ISI · BIST: SNICA · Star Market';
---

<div class="utility" data-show-ticker={showTicker ? 'true' : 'false'}>
  <div class="container">
    <div class="utility-inner">
      {showTicker ? (
        <div class="ticker">
          <span class="ticker-tag">{tickerLabel}</span>
          <span class="ticker-sep">·</span>
          <a class="ticker-kap" href="https://www.kap.org.tr/" target="_blank" rel="noopener">
            {kapLabel} <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      ) : (
        <div class="ticker quiet">
          <span class="ticker-tag muted">{quietLabel}</span>
        </div>
      )}

      <div class="utility-right">
        {items.map((item, i) => (
          <>
            <a href={item.href} class="util-link">{item.label}</a>
            {i < items.length - 1 && <span class="util-sep">·</span>}
          </>
        ))}

        <button class="util-icon" aria-label={locale === 'tr' ? 'Ara' : 'Search'}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3-3" />
          </svg>
        </button>

        <div class="lang-pill" role="group" aria-label={locale === 'tr' ? 'Dil seçimi' : 'Language'}>
          <a
            href={locale === 'tr' ? Astro.url.pathname : alt.url}
            class:list={[{ active: locale === 'tr', fallback: locale === 'en' && !alt.isAvailable }]}
            title={locale === 'en' ? altHint : undefined}
          >TR</a>
          <a
            href={locale === 'en' ? Astro.url.pathname : alt.url}
            class:list={[{ active: locale === 'en', fallback: locale === 'tr' && !alt.isAvailable }]}
            title={locale === 'tr' ? altHint : undefined}
          >EN</a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.utility {
  background: var(--ink);
  color: var(--paper);
  font-family: var(--mono);
  font-size: 0.75rem;
  border-bottom: 1px solid rgba(247, 244, 238, 0.06);
}
.utility-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: var(--utility-h);
  gap: 1.5rem;
}
.ticker {
  display: inline-flex;
  align-items: center;
  gap: 0.875rem;
  white-space: nowrap;
  flex: 1;
  overflow: hidden;
}
.ticker.quiet { gap: 0.5rem; }
.ticker-tag {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-weight: 600;
  font-size: 0.6875rem;
  letter-spacing: 0.16em;
  color: var(--paper);
}
.ticker-tag.muted { color: rgba(247, 244, 238, 0.5); font-weight: 500; }
.ticker-sep { color: rgba(247, 244, 238, 0.22); }
.ticker-kap {
  font-size: 0.6875rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: rgba(247, 244, 238, 0.7);
  transition: color var(--t-fast) var(--ease);
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
}
.ticker-kap:hover { color: var(--paper); }
.ticker-kap .arrow { color: var(--terracotta-warm); }

.utility-right { display: flex; align-items: center; gap: 0.5rem; }
.util-link {
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: rgba(247, 244, 238, 0.7);
  padding: 0.5rem 0.625rem;
  transition: color var(--t-fast) var(--ease);
  font-weight: 500;
}
.util-link:hover { color: var(--paper); }
.util-sep { color: rgba(247, 244, 238, 0.2); }
.util-icon {
  width: 32px;
  height: 32px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: rgba(247, 244, 238, 0.7);
  border-radius: 2px;
  transition: all var(--t-fast) var(--ease);
}
.util-icon:hover { color: var(--paper); background: rgba(247, 244, 238, 0.06); }
.util-icon svg { width: 14px; height: 14px; }
.lang-pill {
  display: inline-flex;
  background: rgba(247, 244, 238, 0.08);
  border-radius: 999px;
  padding: 2px;
  font-family: var(--sans);
  margin-left: 0.5rem;
}
.lang-pill a {
  padding: 0.25rem 0.625rem;
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  color: rgba(247, 244, 238, 0.55);
  border-radius: 999px;
  transition: all var(--t-fast) var(--ease);
}
.lang-pill a.active { background: var(--paper); color: var(--ink); }
/* "fallback" = mevcut sayfanın diğer dilde tam karşılığı yok, /en/ ya da / ana sayfaya iniyor */
.lang-pill a.fallback { color: rgba(247, 244, 238, 0.32); cursor: help; }
.lang-pill a.fallback:hover { color: rgba(247, 244, 238, 0.55); }

@media (max-width: 980px) {
  .util-link { display: none; }
}
@media (max-width: 720px) {
  .ticker-kap { display: none; }
  .lang-pill { display: none; }
}
</style>
