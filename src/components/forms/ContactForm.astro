---
/**
 * ContactForm — paylaşılan iletişim formu bileşeni
 *
 * Statik site mimarisinde backend olmadığı için submit, formdata'yı
 * `mailto:` URL'ine encode edip kullanıcının e-posta uygulamasına yönlendirir.
 * Sunucu tarafı entegrasyon eklendiğinde script bloğu fetch ile değiştirilir;
 * HTML yapısı aynı kalır.
 */
import { getLocale } from '../../lib/i18n';
import { contact } from '../../lib/contact';

export interface FormField {
  name: string;
  label: string;
  type: 'text' | 'email' | 'tel' | 'textarea' | 'select';
  required?: boolean;
  placeholder?: string;
  autocomplete?: string;
  options?: string[];
}

interface Props {
  formId: string;
  to?: string;
  subjectPrefix: string;
  fields: FormField[];
  submitLabel?: string;
  consentText?: string;
}

const locale = getLocale(Astro.url.pathname);
const {
  formId,
  to = contact.emails.info,
  subjectPrefix,
  fields,
  submitLabel,
  consentText,
} = Astro.props;

const ui = locale === 'tr' ? {
  submit: 'Gönder',
  consent: 'Bu formu göndererek KVKK kapsamında verilerimin işlenmesini kabul ediyorum.',
  required: 'Zorunlu',
  successTitle: 'Talebiniz hazır',
  successBody: 'E-posta uygulamanız açıldı. İletinizi göndererek başvurunuzu tamamlayabilirsiniz.',
  reset: 'Yeni başvuru',
  errorTitle: 'Form eksik',
  errorBody: 'Lütfen zorunlu alanları doldurun.',
  helper: 'Form gönder butonuna bastığınızda varsayılan e-posta uygulamanız açılır ve içerik info@sanicaisi.com.tr adresine iletilir.',
} : {
  submit: 'Submit',
  consent: 'By submitting this form, I consent to my data being processed under GDPR.',
  required: 'Required',
  successTitle: 'Ready to send',
  successBody: 'Your email client has opened. Send the message to complete your request.',
  reset: 'New submission',
  errorTitle: 'Missing fields',
  errorBody: 'Please complete the required fields.',
  helper: 'When you press submit, your default email client opens and forwards the message to info@sanicaisi.com.tr.',
};
---

<form
  class="contact-form"
  id={formId}
  data-to={to}
  data-subject={subjectPrefix}
  novalidate
>
  <div class="contact-fields">
    {fields.map((f) => {
      const fieldId = `${formId}-${f.name}`;
      const isWide = f.type === 'textarea';
      return (
        <div class:list={['field', isWide && 'field-wide']}>
          <label for={fieldId}>
            {f.label}
            {f.required && <span class="req" aria-label={ui.required}>*</span>}
          </label>

          {f.type === 'textarea' && (
            <textarea
              id={fieldId}
              name={f.name}
              placeholder={f.placeholder}
              required={f.required}
              rows="5"
            ></textarea>
          )}

          {f.type === 'select' && (
            <select id={fieldId} name={f.name} required={f.required}>
              <option value="">{f.placeholder || '—'}</option>
              {(f.options || []).map((opt) => (
                <option value={opt}>{opt}</option>
              ))}
            </select>
          )}

          {f.type !== 'textarea' && f.type !== 'select' && (
            <input
              id={fieldId}
              name={f.name}
              type={f.type}
              placeholder={f.placeholder}
              required={f.required}
              autocomplete={f.autocomplete}
            />
          )}
        </div>
      );
    })}
  </div>

  <label class="consent">
    <input type="checkbox" name="_consent" required />
    <span>{consentText || ui.consent}</span>
  </label>

  <div class="form-actions">
    <button type="submit">
      {submitLabel || ui.submit}
      <span aria-hidden="true">→</span>
    </button>
    <p class="form-helper">{ui.helper}</p>
  </div>

  <div class="form-feedback" data-feedback hidden>
    <div class="feedback-success" data-feedback-success hidden>
      <strong>{ui.successTitle}</strong>
      <p>{ui.successBody}</p>
      <button type="button" data-reset>{ui.reset}</button>
    </div>
    <div class="feedback-error" data-feedback-error hidden>
      <strong>{ui.errorTitle}</strong>
      <p>{ui.errorBody}</p>
    </div>
  </div>
</form>

<style>
.contact-form {
  display: flex;
  flex-direction: column;
  gap: 1.75rem;
}
.contact-fields {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem 1.25rem;
}
.field { display: flex; flex-direction: column; gap: 0.4375rem; }
.field-wide { grid-column: 1 / -1; }

.field label {
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
  font-weight: 500;
}
.field label .req { color: var(--terracotta); margin-left: 0.125rem; }

.field input,
.field select,
.field textarea {
  font-family: var(--sans);
  font-size: 0.9375rem;
  color: var(--ink);
  background: var(--paper);
  border: 1px solid var(--line);
  padding: 0.75rem 0.875rem;
  border-radius: 0;
  transition: border-color var(--t-fast) var(--ease), box-shadow var(--t-fast) var(--ease);
  width: 100%;
}
.field textarea { resize: vertical; min-height: 140px; line-height: 1.5; }
.field input::placeholder,
.field textarea::placeholder { color: var(--muted); }

.field input:focus,
.field select:focus,
.field textarea:focus {
  outline: none;
  border-color: var(--terracotta);
  box-shadow: 0 0 0 3px rgba(184, 57, 12, 0.12);
}
.field input:invalid:not(:placeholder-shown),
.field textarea:invalid:not(:placeholder-shown) {
  border-color: var(--terracotta);
}

.consent {
  display: flex;
  align-items: flex-start;
  gap: 0.625rem;
  font-size: 0.8125rem;
  line-height: 1.5;
  color: var(--muted);
  cursor: pointer;
}
.consent input[type="checkbox"] {
  margin-top: 0.25rem;
  flex-shrink: 0;
  accent-color: var(--terracotta);
  width: 16px;
  height: 16px;
}

.form-actions {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  flex-wrap: wrap;
}
.form-actions button[type="submit"] {
  display: inline-flex;
  align-items: center;
  gap: 0.625rem;
  font-family: var(--mono);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--paper);
  background: var(--ink);
  border: none;
  padding: 0.9375rem 1.5rem;
  cursor: pointer;
  transition: background var(--t-fast) var(--ease), transform var(--t-fast) var(--ease);
}
.form-actions button[type="submit"]:hover {
  background: var(--terracotta);
}
.form-actions button[type="submit"]:active {
  transform: translateY(1px);
}
.form-helper {
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.04em;
  color: var(--muted);
  line-height: 1.5;
  flex: 1;
  min-width: 240px;
  max-width: 420px;
}

.form-feedback { margin-top: 0.5rem; }
.feedback-success,
.feedback-error {
  padding: 1.125rem 1.25rem;
  border-left: 3px solid var(--terracotta);
  background: var(--sand);
}
.feedback-success { border-left-color: var(--success, #2f6f4f); }
.feedback-success strong,
.feedback-error strong {
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink);
  display: block;
  margin-bottom: 0.375rem;
}
.feedback-success p,
.feedback-error p {
  font-size: 0.875rem;
  color: var(--text);
  line-height: 1.5;
  margin-bottom: 0.75rem;
}
.feedback-success button {
  font-family: var(--mono);
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--terracotta);
  background: transparent;
  border: 1px solid var(--terracotta);
  padding: 0.5rem 0.875rem;
  cursor: pointer;
  transition: all var(--t-fast) var(--ease);
}
.feedback-success button:hover {
  background: var(--terracotta);
  color: var(--paper);
}

@media (max-width: 720px) {
  .contact-fields { grid-template-columns: 1fr; }
  .form-actions { flex-direction: column; align-items: stretch; }
  .form-actions button[type="submit"] { justify-content: center; }
}
</style>

<script>
  type FormFeedback = HTMLElement;

  document.querySelectorAll<HTMLFormElement>('form.contact-form').forEach((form) => {
    const feedback = form.querySelector<FormFeedback>('[data-feedback]')!;
    const successEl = form.querySelector<FormFeedback>('[data-feedback-success]')!;
    const errorEl = form.querySelector<FormFeedback>('[data-feedback-error]')!;
    const resetBtn = form.querySelector<HTMLButtonElement>('[data-reset]')!;
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const fieldsEl = form.querySelector<HTMLElement>('.contact-fields')!;
    const consentEl = form.querySelector<HTMLElement>('.consent')!;

    const showFeedback = (kind: 'success' | 'error') => {
      feedback.hidden = false;
      successEl.hidden = kind !== 'success';
      errorEl.hidden = kind !== 'error';
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        showFeedback('error');
        return;
      }

      const to = form.dataset.to || '';
      const subject = form.dataset.subject || '';
      const data = new FormData(form);
      const lines: string[] = [];
      data.forEach((value, key) => {
        if (key === '_consent') return;
        const labelEl = form.querySelector<HTMLLabelElement>(`label[for="${form.id}-${key}"]`);
        const label = labelEl ? labelEl.textContent?.replace('*', '').trim() : key;
        lines.push(`${label}:\n${value}\n`);
      });

      const body = encodeURIComponent(lines.join('\n'));
      const subj = encodeURIComponent(subject);
      const href = `mailto:${to}?subject=${subj}&body=${body}`;

      window.location.href = href;
      showFeedback('success');
      submitBtn.disabled = true;
      fieldsEl.style.opacity = '0.5';
      consentEl.style.opacity = '0.5';
    });

    resetBtn.addEventListener('click', () => {
      form.reset();
      feedback.hidden = true;
      submitBtn.disabled = false;
      fieldsEl.style.opacity = '';
      consentEl.style.opacity = '';
    });
  });
</script>
