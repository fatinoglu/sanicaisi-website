---
/**
 * FormPageShell — form sayfaları için ortak hero + grid (form + iletişim yan paneli).
 * Servis, bayi ve şikayet formları aynı kompozisyonu paylaşır.
 */
import { contact } from '../../lib/contact';
import { getLocale } from '../../lib/i18n';

interface Props {
  marker: string;
  markerNum: string;
  title: string;
  lead: string;
  sideTitle: string;
  sideHint: string;
  sidePhoneLabel?: string;
}

const locale = getLocale(Astro.url.pathname);
const { marker, markerNum, title, lead, sideTitle, sideHint, sidePhoneLabel } = Astro.props;

const tt = locale === 'tr' ? {
  home: 'Anasayfa',
  contact: 'İletişim',
  phoneMain: 'Santral',
  phoneService: 'Müşteri Hizmetleri',
  emailLbl: 'E-Posta',
  hoursLbl: 'Çalışma Saatleri',
  addressLbl: 'Adres',
} : {
  home: 'Home',
  contact: 'Contact',
  phoneMain: 'Switchboard',
  phoneService: 'Customer Service',
  emailLbl: 'Email',
  hoursLbl: 'Working Hours',
  addressLbl: 'Address',
};

const homeHref = locale === 'tr' ? '/' : '/en/';
const contactHref = locale === 'tr' ? '/iletisim' : '/en/contact';
const hours = locale === 'tr' ? contact.hours.weekdaysTR : contact.hours.weekdaysEN;
---

<section class="form-page-hero">
  <div class="container">
    <div class="breadcrumb">
      <a href={homeHref}>{tt.home}</a>
      <span class="sep">/</span>
      <a href={contactHref}>{tt.contact}</a>
      <span class="sep">/</span>
      <span class="current">{title}</span>
    </div>
    <div class="hero-content">
      <div class="section-marker">
        <span class="num">{markerNum}</span><span class="dash">—</span><span class="label">{marker}</span>
      </div>
      <h1>{title}</h1>
      <p class="lead">{lead}</p>
    </div>
  </div>
</section>

<section class="form-page-body">
  <div class="container">
    <div class="form-page-grid">

      <div class="form-col">
        <slot name="form" />
      </div>

      <aside class="side-col">
        <div class="side-card">
          <span class="lbl">● {sideTitle}</span>
          <p class="side-hint">{sideHint}</p>

          <ul class="side-list">
            <li>
              <span class="tag">{sidePhoneLabel || tt.phoneService}</span>
              <a href={contact.phones.service.href}>{contact.phones.service.display}</a>
            </li>
            <li>
              <span class="tag">{tt.phoneMain}</span>
              <a href={contact.phones.main.href}>{contact.phones.main.display}</a>
            </li>
            <li>
              <span class="tag">{tt.emailLbl}</span>
              <a href={`mailto:${contact.emails.info}`}>{contact.emails.info}</a>
            </li>
            <li>
              <span class="tag">{tt.hoursLbl}</span>
              <span class="val">{hours}</span>
            </li>
            <li>
              <span class="tag">{tt.addressLbl}</span>
              <span class="val">{contact.addressOneLine}</span>
            </li>
          </ul>
        </div>
      </aside>

    </div>
  </div>
</section>

<style>
.form-page-hero {
  background: var(--paper);
  padding-top: clamp(2.5rem, 5vw, 4rem);
  padding-bottom: clamp(2rem, 4vw, 3rem);
}
.breadcrumb {
  display: inline-flex; align-items: center; gap: 0.5rem;
  font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--muted); margin-bottom: 2rem;
}
.breadcrumb a { color: var(--muted); transition: color var(--t-fast) var(--ease); }
.breadcrumb a:hover { color: var(--terracotta); }
.breadcrumb .sep { color: var(--line); }
.breadcrumb .current { color: var(--ink); font-weight: 500; }
.hero-content { max-width: 880px; }
.hero-content .section-marker { margin-bottom: 1.25rem; }
.hero-content h1 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 144, "SOFT" 65, "wght" 420;
  font-size: clamp(2.25rem, 5vw, 4rem);
  line-height: 1; letter-spacing: -0.025em; color: var(--ink);
  margin-bottom: 1.25rem;
}
.lead {
  font-family: var(--serif);
  font-variation-settings: "opsz" 36, "SOFT" 65, "wght" 380, "ital" 1;
  font-style: italic;
  font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
  line-height: 1.55; color: var(--bist-navy, var(--ink)); max-width: 720px;
}

.form-page-body { background: var(--paper); padding-bottom: var(--section-y); }
.form-page-grid {
  display: grid;
  grid-template-columns: 1.65fr 1fr;
  gap: clamp(2rem, 4vw, 3.5rem);
  align-items: start;
}

.side-card {
  background: var(--sand);
  padding: 2rem 1.875rem;
  position: sticky;
  top: 2rem;
}
.side-card .lbl {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--terracotta);
  font-weight: 600;
  display: block;
  margin-bottom: 1rem;
}
.side-hint {
  font-size: 0.9375rem;
  line-height: 1.55;
  color: var(--text);
  margin-bottom: 1.5rem;
  padding-bottom: 1.25rem;
  border-bottom: 1px solid var(--sand-deep, rgba(0,0,0,0.08));
}
.side-list { list-style: none; display: flex; flex-direction: column; gap: 0.75rem; }
.side-list li {
  display: grid;
  grid-template-columns: 110px 1fr;
  gap: 0.5rem;
  align-items: baseline;
}
.side-list .tag {
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
}
.side-list a {
  font-family: var(--mono);
  font-size: 0.875rem;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
  transition: color var(--t-fast) var(--ease);
}
.side-list a:hover { color: var(--terracotta); }
.side-list .val {
  font-family: var(--mono);
  font-size: 0.8125rem;
  color: var(--text);
  line-height: 1.4;
}

@media (max-width: 980px) {
  .form-page-grid { grid-template-columns: 1fr; }
  .side-card { position: static; }
  .side-list li { grid-template-columns: 100px 1fr; }
}
</style>
