---
/**
 * InvestorLayout — yatırımcı sayfaları için layout
 * PageLayout (showTicker=true) + InvestorSubnav (sticky, scrollspy)
 */
import PageLayout from './PageLayout.astro';
import InvestorSubnav from '../components/investor/InvestorSubnav.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  current?: 'overview' | 'halka-arz' | 'kurumsal-yonetim' | 'raporlar' | 'kamuyu-aydinlatma';
}

const { title, description, ogImage, current = 'overview' } = Astro.props;
---

<PageLayout
  {title}
  {description}
  {ogImage}
  showTicker={true}
  activeAudience="investor"
>
  <slot name="hero" />
  <InvestorSubnav {current} />
  <slot />
</PageLayout>
