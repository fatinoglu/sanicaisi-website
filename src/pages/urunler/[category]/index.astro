---
/**
 * Kategori detay sayfası (TR) — örn. /urunler/havlupan
 * Hero (kategori adı + açıklama) + o kategorideki modeller grid
 */
import { getCollection, render } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import ProductModelCard from '../../../components/products/ProductModelCard.astro';

export async function getStaticPaths() {
  const cats = await getCollection('product-categories', (c) => c.data.lang === 'tr');
  return cats.map((cat) => ({
    params: { category: cat.data.slug },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const { Content } = await render(category);

const products = await getCollection('products', (p) =>
  p.data.lang === 'tr' && p.data.categorySlug === category.data.slug,
);
const sorted = products.sort((a, b) => a.data.order - b.data.order);
---

<PageLayout
  title={`${category.data.name} — Sanica Isı`}
  description={category.data.description ?? category.data.tagline}
>
  <section class="cat-hero">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Anasayfa</a>
        <span class="sep">/</span>
        <a href="/urunler">Ürünler</a>
        <span class="sep">/</span>
        <span class="current">{category.data.name}</span>
      </div>

      <div class="cat-hero-grid">
        <div>
          <div class="section-marker">
            <span class="num">01</span><span class="dash">—</span><span class="label">Ürün Ailesi</span>
          </div>
          <h1>{category.data.name}</h1>
          <p class="tagline">{category.data.tagline}</p>
        </div>

        <div class="cat-hero-body">
          <Content />
        </div>
      </div>
    </div>
  </section>

  <section class="models">
    <div class="container">
      <div class="models-head">
        <div class="section-marker">
          <span class="num">02</span><span class="dash">—</span><span class="label">Modeller</span>
        </div>
        <h2><em>{sorted.length}</em> model · tüm seriler</h2>
      </div>

      {sorted.length > 0 ? (
        <div class="models-grid">
          {sorted.map((p) => (
            <ProductModelCard
              slug={p.data.slug}
              name={p.data.name}
              series={p.data.series}
              tagline={p.data.tagline}
              categorySlug={p.data.categorySlug}
              coverKind={p.data.coverKind}
              coverBg={p.data.coverBg}
              featured={p.data.featured}
              heroImage={p.data.heroImage}
              heroImageAlt={p.data.heroImageAlt}
            />
          ))}
        </div>
      ) : (
        <div class="empty">
          <p>Bu kategoride henüz yayımlanmış model yok.</p>
          <a href="/urunler" class="link-arrow">Tüm ürün ailesine geri dön <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      )}
    </div>
  </section>
</PageLayout>

<style>
.cat-hero {
  background: var(--paper);
  padding-top: clamp(2.5rem, 5vw, 4rem);
  padding-bottom: clamp(3rem, 6vw, 5rem);
  border-bottom: 1px solid var(--line);
}
.breadcrumb {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 2rem;
}
.breadcrumb a { color: var(--muted); transition: color var(--t-fast) var(--ease); }
.breadcrumb a:hover { color: var(--terracotta); }
.breadcrumb .sep { color: var(--line); }
.breadcrumb .current { color: var(--ink); font-weight: 500; }

.cat-hero-grid {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: clamp(2rem, 5vw, 4rem);
  align-items: start;
}
.cat-hero-grid .section-marker { margin-bottom: 1.25rem; }
.cat-hero-grid h1 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 144, "SOFT" 65, "wght" 420;
  font-size: clamp(2.5rem, 5.4vw, 4.5rem);
  line-height: 0.98;
  letter-spacing: -0.025em;
  color: var(--ink);
  margin-bottom: 1.25rem;
}
.tagline {
  font-family: var(--serif);
  font-variation-settings: "opsz" 36, "SOFT" 65, "wght" 380, "ital" 1;
  font-style: italic;
  font-size: clamp(1.125rem, 1.6vw, 1.5rem);
  line-height: 1.4;
  color: var(--terracotta);
  max-width: 420px;
}

.cat-hero-body {
  padding-top: 0.75rem;
  font-size: 1rem;
  line-height: 1.65;
  color: var(--text);
}
.cat-hero-body :global(h2) {
  font-family: var(--serif);
  font-variation-settings: "opsz" 36, "SOFT" 55, "wght" 500;
  font-size: 1.25rem;
  margin: 2rem 0 1rem;
  color: var(--ink);
}
.cat-hero-body :global(p) { margin-bottom: 1rem; max-width: 600px; }
.cat-hero-body :global(ul) {
  padding-left: 1.25rem;
  margin-bottom: 1rem;
}
.cat-hero-body :global(li) { margin-bottom: 0.4375rem; }

.models {
  background: var(--paper-soft);
  padding: clamp(3rem, 6vw, 5rem) 0;
}
.models-head { margin-bottom: 2.5rem; }
.models-head .section-marker { margin-bottom: 1rem; }
.models-head h2 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 96, "SOFT" 65, "wght" 420;
  font-size: clamp(1.75rem, 3vw, 2.5rem);
  line-height: 1.05;
  letter-spacing: -0.022em;
  color: var(--ink);
}
.models-head h2 em {
  font-style: italic;
  font-variation-settings: "opsz" 96, "SOFT" 100, "wght" 380;
  color: var(--terracotta);
}

.models-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.25rem;
}

.empty {
  padding: 3rem;
  background: var(--paper);
  border: 1px dashed var(--line);
  text-align: center;
}
.empty p {
  color: var(--muted);
  margin-bottom: 1.25rem;
}

@media (max-width: 980px) {
  .cat-hero-grid { grid-template-columns: 1fr; }
  .models-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .models-grid { grid-template-columns: 1fr; }
}
</style>
