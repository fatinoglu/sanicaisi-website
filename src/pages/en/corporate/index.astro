---
/**
 * Corporate index (EN) — sub-page list (boş şu an; Faz 6'da EN içerik gelecek)
 */
import { getCollection } from 'astro:content';
import CorporateLayout from '../../../layouts/CorporateLayout.astro';
import CorporatePageHero from '../../../components/corporate/CorporatePageHero.astro';
import { localizedUrl } from '../../../lib/i18n';

const all = await getCollection('corporate', (c) => c.data.lang === 'en');
const items = all.sort((a, b) => a.data.order - b.data.order);
---

<CorporateLayout
  title="Corporate — Sanica Isı"
  description="Sanica Isı corporate information: about us, history, management, manufacturing, quality & certifications."
>
  <CorporatePageHero
    slot="hero"
    title="Corporate"
    description="A 40-year journey from family business to public industrial company."
  />

  <section class="corp-list">
    <div class="container">
      {items.length > 0 ? (
        <div class="list-grid">
          {items.map((it, i) => (
            <a href={localizedUrl('en', `/corporate/${it.data.slug}`)} class="list-card">
              <span class="idx">0{i + 1}</span>
              <h3>{it.data.title}</h3>
              <p>{it.data.description}</p>
              <span class="cta">Read <span class="arrow" aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty">
          <p>English corporate content will be available after the translation phase.</p>
        </div>
      )}
    </div>
  </section>
</CorporateLayout>

<style>
.corp-list { background: var(--paper-soft); padding-block: clamp(3rem, 6vw, 5rem); }
.list-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
.list-card {
  background: var(--paper); border: 1px solid var(--line);
  padding: 1.75rem 1.875rem 1.875rem;
  display: flex; flex-direction: column; gap: 0.625rem;
  transition: all var(--t-med) var(--ease);
}
.list-card:hover { border-color: var(--ink); transform: translateY(-4px); }
.list-card .idx {
  font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.18em;
  color: var(--terracotta); font-weight: 600; text-transform: uppercase;
}
.list-card h3 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 72, "SOFT" 55, "wght" 500;
  font-size: 1.375rem; color: var(--ink);
}
.list-card p { font-size: 0.9375rem; line-height: 1.55; color: var(--muted); flex: 1; }
.list-card .cta {
  font-family: var(--mono); font-size: 0.6875rem; font-weight: 600;
  letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink);
}
.empty {
  padding: 3rem; background: var(--paper); border: 1px dashed var(--line);
  text-align: center; color: var(--muted);
}
@media (max-width: 640px) { .list-grid { grid-template-columns: 1fr; } }
</style>
