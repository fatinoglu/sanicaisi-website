---
/**
 * Category detail (EN) — örn. /en/products/towel-warmer
 * Şu an EN içerik yok; Faz 6'da çeviriden sonra çalışacak
 */
import { getCollection, render } from 'astro:content';
import PageLayout from '../../../../layouts/PageLayout.astro';
import ProductModelCard from '../../../../components/products/ProductModelCard.astro';

export async function getStaticPaths() {
  const cats = await getCollection('product-categories', (c) => c.data.lang === 'en');
  return cats.map((cat) => ({
    params: { category: cat.data.slug },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const { Content } = await render(category);

const products = await getCollection('products', (p) =>
  p.data.lang === 'en' && p.data.categorySlug === category.data.slug,
);
const sorted = products.sort((a, b) => a.data.order - b.data.order);
---

<PageLayout title={`${category.data.name} — Sanica Isı`} description={category.data.description ?? category.data.tagline}>
  <section class="cat-hero">
    <div class="container">
      <div class="breadcrumb">
        <a href="/en/">Homepage</a>
        <span class="sep">/</span>
        <a href="/en/products">Products</a>
        <span class="sep">/</span>
        <span class="current">{category.data.name}</span>
      </div>
      <h1>{category.data.name}</h1>
      <p class="tagline">{category.data.tagline}</p>
      <article class="prose"><Content /></article>
    </div>
  </section>

  {sorted.length > 0 && (
    <section class="models">
      <div class="container">
        <div class="models-grid">
          {sorted.map((p) => (
            <ProductModelCard
              slug={p.data.slug} name={p.data.name} series={p.data.series}
              tagline={p.data.tagline} categorySlug={p.data.categorySlug}
              coverKind={p.data.coverKind} coverBg={p.data.coverBg}
              featured={p.data.featured}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</PageLayout>

<style>
.cat-hero { background: var(--paper); padding-block: clamp(2.5rem, 5vw, 4rem); }
.breadcrumb {
  display: inline-flex; align-items: center; gap: 0.5rem;
  font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.14em;
  text-transform: uppercase; color: var(--muted); margin-bottom: 2rem;
}
.breadcrumb a { color: var(--muted); }
.breadcrumb .sep { color: var(--line); }
.breadcrumb .current { color: var(--ink); font-weight: 500; }
.cat-hero h1 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 144, "SOFT" 65, "wght" 420;
  font-size: clamp(2.5rem, 5.4vw, 4.5rem); line-height: 0.98;
  letter-spacing: -0.025em; color: var(--ink); margin-bottom: 1.25rem;
}
.tagline {
  font-family: var(--serif);
  font-variation-settings: "opsz" 36, "SOFT" 65, "wght" 380, "ital" 1;
  font-style: italic; font-size: 1.5rem; color: var(--terracotta); margin-bottom: 2rem;
}
.prose { max-width: 720px; line-height: 1.65; }
.models { background: var(--paper-soft); padding-block: clamp(3rem, 6vw, 5rem); }
.models-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
@media (max-width: 980px) { .models-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 640px) { .models-grid { grid-template-columns: 1fr; } }
</style>
