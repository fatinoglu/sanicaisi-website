---
/**
 * Kurumsal index (TR) — alt sayfa listesi
 */
import { getCollection } from 'astro:content';
import CorporateLayout from '../../layouts/CorporateLayout.astro';
import CorporatePageHero from '../../components/corporate/CorporatePageHero.astro';
import { localizedUrl } from '../../lib/i18n';

const all = await getCollection('corporate', (c) => c.data.lang === 'tr');
const items = all.sort((a, b) => a.data.order - b.data.order);
---

<CorporateLayout
  title="Kurumsal — Sanica Isı"
  description="Sanica Isı kurumsal bilgileri: hakkımızda, tarihçe, yönetim, üretim, kalite & sertifikalar."
>
  <CorporatePageHero
    slot="hero"
    title="Kurumsal"
    description="Aile şirketinden halka açık sanayi şirketine 40 yıllık yolculuk."
  />

  <section class="corp-list">
    <div class="container">
      <div class="list-grid">
        {items.map((it, i) => (
          <a href={localizedUrl('tr', `/kurumsal/${it.data.slug}`)} class="list-card">
            <span class="idx">0{i + 1}</span>
            <h3>{it.data.title}</h3>
            <p>{it.data.description}</p>
            <span class="cta">Oku <span class="arrow" aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</CorporateLayout>

<style>
.corp-list { background: var(--paper-soft); padding-block: clamp(3rem, 6vw, 5rem); }
.list-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.25rem;
}
.list-card {
  background: var(--paper);
  border: 1px solid var(--line);
  padding: 1.75rem 1.875rem 1.875rem;
  display: flex;
  flex-direction: column;
  gap: 0.625rem;
  transition: all var(--t-med) var(--ease);
  position: relative;
}
.list-card:hover {
  border-color: var(--ink);
  transform: translateY(-4px);
  box-shadow: 0 14px 32px -14px rgba(10,10,10,0.18);
}
.list-card .idx {
  font-family: var(--mono);
  font-size: 0.6875rem;
  letter-spacing: 0.18em;
  color: var(--terracotta);
  font-weight: 600;
  text-transform: uppercase;
  margin-bottom: 0.25rem;
}
.list-card h3 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 72, "SOFT" 55, "wght" 500;
  font-size: 1.375rem;
  color: var(--ink);
  letter-spacing: -0.015em;
}
.list-card p {
  font-size: 0.9375rem;
  line-height: 1.55;
  color: var(--muted);
  margin-bottom: 1rem;
  flex: 1;
}
.list-card .cta {
  font-family: var(--mono);
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ink);
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  align-self: flex-start;
}
.list-card:hover .cta { color: var(--terracotta); }
.list-card .cta .arrow { transition: transform var(--t-med) var(--ease-out); }
.list-card:hover .cta .arrow { transform: translateX(4px); }

@media (max-width: 640px) {
  .list-grid { grid-template-columns: 1fr; }
}
</style>
