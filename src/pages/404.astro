---
import PageLayout from '../layouts/PageLayout.astro';
import { getLocale } from '../lib/i18n';

const locale = getLocale(Astro.url.pathname);
const t = locale === 'tr' ? {
  title: '404 — Sayfa bulunamadı',
  heading: 'Aradığınız sayfa burada değil.',
  desc: 'Bağlantı eski olabilir veya yazım hatası olabilir. Anasayfaya dönebilir, ya da Yatırımcı İlişkileri sayfasında arama yapabilirsiniz.',
  cta1: 'Anasayfaya dön',
  cta2: 'Yatırımcı İlişkileri',
  link1: '/',
  link2: '/yatirimci-iliskileri',
} : {
  title: '404 — Page not found',
  heading: 'The page you\'re looking for is not here.',
  desc: 'The link may be outdated or contain a typo. You can go back to the homepage or browse Investor Relations.',
  cta1: 'Back to homepage',
  cta2: 'Investor Relations',
  link1: '/en/',
  link2: '/en/investor-relations',
};
---

<PageLayout title={t.title} noindex>
  <section class="not-found">
    <div class="container">
      <div class="section-marker">
        <span class="num">404</span><span class="dash">—</span><span class="label">{locale === 'tr' ? 'Hata' : 'Error'}</span>
      </div>
      <h1>{t.heading}</h1>
      <p>{t.desc}</p>
      <div class="ctas">
        <a href={t.link1} class="btn primary">{t.cta1} →</a>
        <a href={t.link2} class="btn ghost">{t.cta2} →</a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
.not-found {
  padding-block: clamp(5rem, 10vw, 9rem);
  min-height: 70vh;
}
.not-found h1 {
  font-family: var(--serif);
  font-variation-settings: "opsz" 144, "SOFT" 70, "wght" 420;
  font-size: clamp(2rem, 5vw, 3.75rem);
  line-height: 1.05;
  letter-spacing: -0.022em;
  color: var(--ink);
  margin: 1.5rem 0 1.25rem;
  max-width: 720px;
}
.not-found p {
  font-size: 1.0625rem;
  line-height: 1.6;
  color: var(--muted);
  max-width: 560px;
  margin-bottom: 2.5rem;
}
.ctas { display: flex; gap: 0.875rem; flex-wrap: wrap; }
.btn {
  display: inline-flex;
  align-items: center;
  padding: 0.875rem 1.25rem;
  font-size: 0.9375rem;
  font-weight: 500;
  border: 1px solid;
  border-radius: 2px;
  transition: all var(--t-med) var(--ease);
}
.btn.primary { background: var(--terracotta); border-color: var(--terracotta); color: var(--paper); }
.btn.primary:hover { background: var(--terracotta-deep); transform: translateY(-2px); }
.btn.ghost { background: transparent; border-color: var(--line); color: var(--ink); }
.btn.ghost:hover { border-color: var(--ink); }
</style>
