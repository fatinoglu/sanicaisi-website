---
/**
 * Anasayfa (TR) — onaylı mockup index-v2.html'in bileşenleştirilmiş hali
 */
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/home/Hero.astro';
import AudienceBand from '../components/home/AudienceBand.astro';
import ProductMosaic from '../components/home/ProductMosaic.astro';
import Manifesto from '../components/home/Manifesto.astro';
import InvestorBand from '../components/home/InvestorBand.astro';
import StoryBand from '../components/home/StoryBand.astro';
import SustainBand from '../components/home/SustainBand.astro';
import PressWall from '../components/home/PressWall.astro';
import NewsletterCTA from '../components/home/NewsletterCTA.astro';
---

<PageLayout
  title="Sanica Isı — Çelikten ısıya. Türkiye'de üretiyoruz."
  description="Sanica Isı, 1985'ten bu yana İstanbul'da panel radyatör, havlupan, kombi ve ısıtma boruları üreten halka açık Türk sanayi şirketi. BIST: SNICA."
  showTicker={false}
  activeAudience="home"
>
  <Hero />
  <AudienceBand />
  <ProductMosaic />
  <Manifesto />
  <InvestorBand />
  <StoryBand />
  <SustainBand />
  <PressWall />
  <NewsletterCTA />
</PageLayout>
