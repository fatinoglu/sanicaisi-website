---
/**
 * Basında Biz — liste sayfası (TR)
 * Press koleksiyonunu tarihe göre sıralar, kategori filtreli grid'de gösterir.
 */
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import PressHero from '../../components/press/PressHero.astro';
import PressFilters from '../../components/press/PressFilters.astro';
import PressGrid from '../../components/press/PressGrid.astro';

const all = await getCollection('press', (p) => p.data.lang === 'tr');
const items = all
  .map((p) => p.data)
  .sort((a, b) => +b.date - +a.date);

const counts: Record<string, number> = {};
for (const i of items) counts[i.category] = (counts[i.category] ?? 0) + 1;

const hint = items.length > 0
  ? `${items[items.length - 1].date.getFullYear()} – ${items[0].date.getFullYear()}`
  : undefined;
---

<PageLayout
  title="Basında Biz — Sanica Isı"
  description="Sanica Isı haberleri: halka arz süreci, sosyal sorumluluk projeleri, fuar katılımları ve bizden son haberler."
  activeAudience="home"
>
  <PressHero total={items.length} hint={hint} />
  <PressFilters counts={counts} total={items.length} />
  <PressGrid items={items} />
</PageLayout>
