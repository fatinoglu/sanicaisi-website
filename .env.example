# ════════════════════════════════════════════════════════════
# Sanica Isı — Ortam değişkenleri
#
# Kopyalama: cp .env.example .env.local
# Yerel kullanım için (`tsx scripts/...`): .env.local kullanılır
# Production'da Cloudflare Pages dashboard'dan eklenir
#
# UYARI: .env, .env.local KESİNLİKLE commit edilmez (.gitignore'da)
# ════════════════════════════════════════════════════════════

# ── WordPress (migration için) ──────────────────────────────
WP_BASE_URL=https://www.sanicaisi.com.tr
# Public endpoint'ler için Application Password gerekmez.
# Custom post type/draft gerekirse:
# WP_USER=cagri
# WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ── Cloudflare R2 (medya depolama) ──────────────────────────
# Cloudflare Dashboard → R2 → Manage R2 API Tokens → Create
# - Permissions: Object Read & Write
# - Specify bucket: sanicaisi
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sanicaisi

# R2 public URL (custom domain bind edildiğinde değişir)
# Şimdilik: https://pub-{HASH}.r2.dev
# Faz 9 sonrası: https://media.sanicaisi.com.tr
R2_PUBLIC_BASE=https://pub-CHANGE-ME.r2.dev

# ── Resend (newsletter / form, Faz 7) ───────────────────────
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
